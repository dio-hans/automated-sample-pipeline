        </div>


        <div class="mt-6 rounded-md border border-[#E4DECB] bg-paper px-4 py-3 text-sm text-clay">
            <p>
                Note: deleting a sample does <span class="font-medium">not</span>
                restock the coffee inventory that was deducted when it was sent.
                Adjust the stock record manually if needed.
            </p>
        </div>


        <form method="post" class="mt-6">

            {% csrf_token %}

            <div class="flex items-center justify-end gap-3">

                <a href="{% url 'sample_list' %}"
                   class="px-4 py-2.5 text-sm font-medium
                          rounded-md border border-[#E4DECB]
                          hover:bg-paper-dim transition">
                    Cancel
                </a>

                <button type="submit"
                        class="px-5 py-2.5 text-sm font-semibold
                               rounded-md bg-rust text-white
                               hover:bg-rust-dark transition">
                    Delete Sample
                </button>

            </div>

        </form>

    </div>

</div>

{% endblock %}



--- FILE: sample_detail.html.FullName ---

{% extends "pipeline/base.html" %}

{% block title %}
Sample {{ sample.pk }}
{% endblock %}

{% block breadcrumb %}
Pipeline / Samples / {{ sample.company.name }}
{% endblock %}

{% block page_title %}
Sample Dispatch
{% endblock %}

{% block header_action %}
<div class="flex items-center gap-2">
    <a href="{% url 'sample_update' sample.pk %}"
       class="bg-rust text-white px-4 py-2 rounded-md hover:opacity-90">
        Edit
    </a>
    <a href="{% url 'sample_list' %}"
       class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium
              border border-[#E4DECB] rounded-md
              text-ink hover:bg-white transition">
        â† Back to Samples
    </a>
</div>
{% endblock %}

{% block content %}

<div class="max-w-5xl space-y-6">

    <!-- Status banner -->
    {% if sample.delivery_status == 'failed' %}
    <div class="rounded-md border border-rust-light bg-rust-50 px-4 py-3">
        <p class="font-medium text-rust-dark">Delivery failed</p>
        <p class="text-sm text-rust-dark mt-0.5">
            This sample was not delivered. Follow up with the courier or resend.
        </p>
    </div>
    {% elif sample.delivery_status == 'delivered' %}
    <div class="rounded-md border border-olive/30 bg-olive/10 px-4 py-3">
        <p class="font-medium text-olive">Delivered</p>
        <p class="text-sm text-olive mt-0.5">
            Sample received on {{ sample.delivered_at|date:"d F Y, H:i" }}. Begin follow-up.
        </p>
    </div>
    {% else %}
    <div class="rounded-md border border-gold/30 bg-gold/10 px-4 py-3">
        <p class="font-medium text-gold">In transit</p>
        <p class="text-sm text-gold mt-0.5">
            Sample dispatched via {{ sample.courier_name }}. Awaiting delivery confirmation.
        </p>
    </div>
    {% endif %}


    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Details -->
        <div class="lg:col-span-2 bg-white rounded-lg shadow-sm border">

            <div class="p-4 border-b">
                <h2 class="font-semibold text-lg">
                    Sample Details
                </h2>
            </div>

            <dl class="divide-y">

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Recipient</dt>
                    <dd class="col-span-2 text-sm font-medium">
                        <a href="{% url 'company_detail' sample.company.pk %}"
                           class="text-olive hover:underline">
                            {{ sample.company.name }}
                        </a>
                    </dd>
                </div>

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Coffee</dt>
                    <dd class="col-span-2 text-sm">
                        {{ sample.coffee_stock.variety_name }}
                        <span class="block text-xs text-gray-400 capitalize">
                            {{ sample.coffee_stock.get_coffee_type_display }}
                            &middot; {{ sample.coffee_stock.source }}
                        </span>
                    </dd>
                </div>

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Sample weight</dt>
                    <dd class="col-span-2 text-sm font-medium">
                        {{ sample.sample_weight|floatformat:2 }} kg
                    </dd>
                </div>

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Date sent</dt>
                    <dd class="col-span-2 text-sm">
                        {{ sample.date_sent|date:"d F Y, H:i" }}
                    </dd>
                </div>

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Courier</dt>
                    <dd class="col-span-2 text-sm">
                        {{ sample.courier_name }}
                    </dd>
                </div>

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Tracking number</dt>
                    <dd class="col-span-2 text-sm font-mono text-xs">
                        {{ sample.tracking_number }}
                    </dd>
                </div>

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Delivered at</dt>
                    <dd class="col-span-2 text-sm">
                        {% if sample.delivered_at %}
                            {{ sample.delivered_at|date:"d F Y, H:i" }}
                        {% else %}
                            <span class="text-gray-400">â€”</span>
                        {% endif %}
                    </dd>
                </div>

            </dl>

        </div>

        <!-- Snapshot -->
        <div class="space-y-6">

            <div class="bg-white rounded-lg shadow-sm border p-6">
                <p class="eyebrow text-clay">Delivery status</p>
                <div class="mt-2">

                    {% if sample.delivery_status == 'delivered' %}
                        <span class="px-3 py-1 rounded-full text-sm font-medium bg-olive/10 text-olive">
                            Delivered
                        </span>
                    {% elif sample.delivery_status == 'failed' %}
                        <span class="px-3 py-1 rounded-full text-sm font-medium bg-rust/10 text-rust">
                            Failed
                        </span>
                    {% else %}
                        <span class="px-3 py-1 rounded-full text-sm font-medium bg-gold/10 text-gold">
                            In Transit
                        </span>
                    {% endif %}

                </div>
            </div>

            <div class="bg-white rounded-lg shadow-sm border p-6">
                <p class="eyebrow text-clay">Sample ID</p>
                <p class="font-mono text-xs mt-1 break-all text-gray-500">
                    {{ sample.pk }}
                </p>

                <div class="mt-4 pt-4 border-t border-[#E4DECB]">
                    <p class="eyebrow text-clay">Company stage</p>
                    <p class="text-sm mt-1">
                        {{ sample.company.get_pipeline_stage_display }}
                    </p>
                </div>
            </div>

        </div>

    </div>

</div>

{% endblock %}



--- FILE: sample_form.html.FullName ---

{% extends "pipeline/base.html" %}

{% block title %}
    {% if object %}
        Edit Sample
    {% else %}
        Send Sample
    {% endif %}
{% endblock %}

{% block breadcrumb %}
Samples
{% endblock %}

{% block page_title %}
    {% if object %}
        Edit Sample
    {% else %}
        Send Sample
    {% endif %}
{% endblock %}

{% block header_action %}
    <a href="{% url 'sample_list' %}"
       class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium
              border border-[#E4DECB] rounded-md
              text-ink hover:bg-white transition">
        â† Back to Samples
    </a>
{% endblock %}

{% block content %}

<div class="max-w-3xl">

    <!-- Introduction -->
    <div class="mb-8">
        <p class="text-sm text-clay">
            {% if object %}
                Update the details for this sample dispatch.
            {% else %}
                Send a coffee sample to a prospect. Stock is deducted automatically and the company advances to "Sample Sent".
            {% endif %}
        </p>
    </div>


    <!-- Form Card -->
    <div class="card p-6 md:p-8">

        <form method="post" novalidate>

            {% csrf_token %}

            <!-- Non-field errors -->
            {% if form.non_field_errors %}
                <div class="mb-6 rounded-md border border-rust-light
                            bg-rust-50 px-4 py-3">
                    {% for error in form.non_field_errors %}
                        <p class="text-sm text-rust-dark">
                            {{ error }}
                        </p>
                    {% endfor %}
                </div>
            {% endif %}


            <!-- Recipient & Coffee -->
            <div class="mb-8">

                <div class="mb-5">
                    <p class="eyebrow text-clay">
                        Dispatch
                    </p>

                    <h2 class="font-display text-xl mt-1">
                        Recipient &amp; Coffee
                    </h2>
                </div>


                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <!-- Company -->
                    <div>

                        <label for="{{ form.company.id_for_label }}"
                               class="field-label block mb-2">
                            Recipient Company
                        </label>

                        {{ form.company }}

                        {% if form.company.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.company.errors %}
                                    <p>{{ error }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}

                    </div>


                    <!-- Coffee Stock -->
                    <div>

                        <label for="{{ form.coffee_stock.id_for_label }}"
                               class="field-label block mb-2">
                            Coffee Sample
                        </label>

                        {{ form.coffee_stock }}

                        {% if form.coffee_stock.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.coffee_stock.errors %}
                                    <p>{{ error }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}

                    </div>


                    <!-- Sample Weight -->
                    <div>

                        <label for="{{ form.sample_weight.id_for_label }}"
                               class="field-label block mb-2">
                            Sample Weight (kg)
                        </label>

                        {{ form.sample_weight }}

                        {% if form.sample_weight.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.sample_weight.errors %}
                                    <p>{{ error }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <p class="mt-2 text-xs text-clay">
                            This amount is deducted from the selected stock on dispatch.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Courier & Tracking -->
            <div class="mb-8">

                <div class="mb-5">
                    <p class="eyebrow text-clay">
                        Shipping
                    </p>

                    <h2 class="font-display text-xl mt-1">
                        Courier &amp; Tracking
                    </h2>
                </div>


                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <!-- Courier Name -->
                    <div>

                        <label for="{{ form.courier_name.id_for_label }}"
                               class="field-label block mb-2">
                            Courier
                        </label>

                        {{ form.courier_name }}

                        {% if form.courier_name.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.courier_name.errors %}
                                    <p>{{ error }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}

                    </div>


                    <!-- Tracking Number -->
                    <div>

                        <label for="{{ form.tracking_number.id_for_label }}"
                               class="field-label block mb-2">
                            Tracking Number
                        </label>

                        {{ form.tracking_number }}

                        {% if form.tracking_number.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.tracking_number.errors %}
                                    <p>{{ error }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}

                    </div>


                    <!-- Delivery Status -->
                    <div>

                        <label for="{{ form.delivery_status.id_for_label }}"
                               class="field-label block mb-2">
                            Delivery Status
                        </label>

                        {{ form.delivery_status }}

                        {% if form.delivery_status.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.delivery_status.errors %}
                                    <p>{{ error }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}

                    </div>


                    <!-- Delivered At -->
                    <div>

                        <label for="{{ form.delivered_at.id_for_label }}"
                               class="field-label block mb-2">
                            Delivered At
                        </label>

                        {{ form.delivered_at }}

                        {% if form.delivered_at.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.delivered_at.errors %}
                                    <p>{{ error }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <p class="mt-2 text-xs text-clay">
                            Leave blank until the sample is confirmed delivered.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Actions -->
            <div class="flex items-center justify-end gap-3
                        pt-6 border-t border-[#E4DECB]">

                <a href="{% url 'sample_list' %}"
                   class="px-4 py-2.5 text-sm font-medium
                          rounded-md border border-[#E4DECB]
                          hover:bg-paper-dim transition">
                    Cancel
                </a>

                <button type="submit"
                        class="px-5 py-2.5 text-sm font-semibold
                               rounded-md bg-rust text-white
                               hover:bg-rust-dark transition">

                    {% if object %}
                        Save Changes
                    {% else %}
                        Send Sample
                    {% endif %}

                </button>

            </div>

        </form>

    </div>

</div>

{% endblock %}



--- FILE: sample_list.html.FullName ---

{% extends "pipeline/base.html" %}

{% block title %}
Samples
{% endblock %}

{% block breadcrumb %}
Pipeline / Samples
{% endblock %}

{% block page_title %}
Samples
{% endblock %}

{% block header_action %}
<a href="{% url 'sample_create' %}"
   class="bg-rust text-white px-4 py-2 rounded-md hover:opacity-90">
    + Send Sample
</a>
{% endblock %}

{% block content %}

{% load pipeline_tags %} 
{% preset_bar %}

<div class="bg-white rounded-lg shadow-sm border overflow-hidden">

    <div class="p-4 border-b">
        <h2 class="font-semibold text-lg">
            Dispatched Samples
        </h2>

        <p class="text-sm text-gray-500 mt-1">
            Coffee samples sent to prospects. Sending a sample automatically deducts stock and advances the company's pipeline stage.
        </p>
    </div>

    <div class="overflow-x-auto">

        <table class="w-full">

            <thead class="bg-gray-50">

                <tr class="text-left text-xs uppercase tracking-wider text-gray-500">

                    <th class="px-4 py-3">Recipient</th>
                    <th class="px-4 py-3">Coffee</th>
                    <th class="px-4 py-3 text-right">Weight</th>
                    <th class="px-4 py-3">Date Sent</th>
                    <th class="px-4 py-3">Courier</th>
                    <th class="px-4 py-3">Tracking #</th>
                    <th class="px-4 py-3 text-center">Status</th>
                    <th class="px-4 py-3">Actions</th>

                </tr>

            </thead>

            <tbody>

                {% for sample in samples %}

                <tr class="border-t hover:bg-gray-50">

                    <td class="px-4 py-3 font-medium">
                        <a href="{% url 'company_detail' sample.company.pk %}"
                           class="hover:underline">
                            {{ sample.company.name }}
                        </a>
                    </td>

                    <td class="px-4 py-3 text-sm">
                        {{ sample.coffee_stock.variety_name }}
                        <span class="block text-xs text-gray-400 capitalize">
                            {{ sample.coffee_stock.get_coffee_type_display }}
                        </span>
                    </td>

                    <td class="px-4 py-3 text-right text-sm">
                        {{ sample.sample_weight|floatformat:2 }} kg
                    </td>

                    <td class="px-4 py-3 text-sm">
                        {{ sample.date_sent|date:"d M Y" }}
                    </td>

                    <td class="px-4 py-3 text-sm">
                        {{ sample.courier_name }}
                    </td>

                    <td class="px-4 py-3 text-sm font-mono text-xs">
                        {{ sample.tracking_number }}
                    </td>

                    <td class="px-4 py-3 text-center">

                        {% if sample.delivery_status == 'delivered' %}
                            <span class="px-2 py-1 rounded-full text-xs bg-olive/10 text-olive">
                                Delivered
                            </span>
                        {% elif sample.delivery_status == 'failed' %}
                            <span class="px-2 py-1 rounded-full text-xs bg-rust/10 text-rust">
                                Failed
                            </span>
                        {% else %}
                            <span class="px-2 py-1 rounded-full text-xs bg-gold/10 text-gold">
                                In Transit
                            </span>
                        {% endif %}

                    </td>

                    <td class="px-4 py-3">

                        <div class="flex gap-2">

                            <a href="{% url 'sample_detail' sample.pk %}"
                               class="text-olive hover:underline">
                                View
                            </a>

                            <a href="{% url 'sample_update' sample.pk %}"
                               class="text-blue-600 hover:underline">
                                Edit
                            </a>

                            <a href="{% url 'sample_delete' sample.pk %}"
                               class="text-red-600 hover:underline">
                                Delete
                            </a>

                        </div>

                    </td>

                </tr>

                {% empty %}

                <tr>

                    <td colspan="8"
                        class="text-center py-12 text-gray-500">

                        No samples have been dispatched yet.

                    </td>

                </tr>

                {% endfor %}

            </tbody>

        </table>

    </div>

</div>

{% endblock %}



--- FILE: stock_detail.html.FullName ---

{% extends "pipeline/base.html" %}

{% block title %}
{{ stock.variety_name }} Ã¢â‚¬â€ {{ stock.batch_number }} | Nonda
{% endblock %}

{% block breadcrumb %}
Inventory / Coffee Stock / {{ stock.batch_number }}
{% endblock %}

{% block page_title %}

<div class="flex flex-wrap items-center gap-3">

<span>{{ stock.variety_name }}</span>

<span class="font-mono text-xs font-normal
             px-2.5 py-1 rounded-md
             bg-paper border border-[#E4DECB] text-clay">
    {{ stock.batch_number }}
</span>

</div>
{% endblock %}

{% block header_action %}

<div class="flex items-center gap-2">

<a href="{% url 'stock_update' stock.pk %}"
   class="inline-flex items-center px-4 py-2.5
          rounded-md bg-white
          border border-[#E4DECB]
          text-ink text-sm font-medium
          hover:bg-paper transition">
    Edit Batch
</a>

<a href="{% url 'stock_list' %}"
   class="inline-flex items-center px-4 py-2.5
          rounded-md bg-rust text-white
          text-sm font-semibold
          hover:bg-rust-dark transition">
     Coffee Stock
</a>

</div>

{% endblock %}

{% block content %}

<div class="space-y-6">

<!-- BATCH HEADER -->
<div class="bg-white border border-[#E4DECB]
            rounded-xl shadow-sm p-6">

    <div class="flex flex-col lg:flex-row
                lg:items-center lg:justify-between gap-5">


        <div class="text-left lg:text-right">

