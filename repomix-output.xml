/* =========================================================
   NONDA EXPENSE ENTRY
   ========================================================= */
.expense-entry-page {
    width: 100%;
    height: 100%;
    max-height: calc(100vh - 70px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    box-sizing: border-box;
    overflow: hidden;
}

/* PAGE HEADER */
.expense-entry-header {
    width: fit-content;
    max-width: 600px;
    text-align: center;
    margin-bottom: 0.4rem;
}
.expense-entry-header h1 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
    color: #111827;
}
.expense-entry-header p {
    margin: 0.1rem 0 0;
    font-size: 0.8rem;
    color: #6b7280;
}

/* FORM CARD */
.expense-form-card {
    width: 100%;
    max-width: 600px;
    background: #ffffff;
    border: 1px solid #E4DECB;
    border-radius: 0.85rem;
    padding: 1rem 1.25rem;
    box-sizing: border-box;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
}
.expense-form-card-header {
    padding-bottom: 0.5rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid #E4DECB;
}
.expense-form-card-header h1 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 800;
    color: #111827;
}
.expense-form-card-header p {
    margin: 0.15rem 0 0;
    font-size: 0.72rem;
    color: #6b7280;
}

/* FORM */
.expense-form {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
}
.expense-field {
    display: flex;
    flex-direction: column;
}
.expense-field label {
    margin-bottom: 0.2rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #374151;
}
.expense-field input,
.expense-field select,
.expense-field textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #E4DECB;
    border-radius: 0.45rem;
    padding: 0.5rem 0.7rem;
    font-size: 0.825rem;
    background: #ffffff;
    color: #111827;
    outline: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
}
.expense-field input:focus,
.expense-field select:focus,
.expense-field textarea:focus {
    border-color: #f97316;
    box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.12);
}
.expense-field textarea {
    resize: none;
    min-height: 52px;
}
.expense-field-help {
    margin-top: 0.2rem;
    font-size: 0.68rem;
    color: #6b7280;
}

.expense-two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
}

/* ERRORS */
.expense-error {
    margin-top: 0.2rem;
    font-size: 0.68rem;
    color: #dc2626;
}

/* SAVE BUTTON */
.expense-save-button {
    width: 100%;
    border: none;
    border-radius: 0.5rem;
    padding: 0.6rem 1rem;
    margin-top: 0.25rem;
    background: #f97316 !important;
    color: #ffffff !important;
    font-size: 0.825rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 150ms ease, transform 100ms ease;
}
.expense-save-button:hover {
    background: #ea580c !important;
}
.expense-save-button:active {
    transform: translateY(1px);
}

/* HISTORY LINK */
.expense-history-link {
    margin-top: 0.65rem;
    text-align: center;
}
.expense-history-link a {
    font-size: 0.78rem;
    font-weight: 600;
    color: #00674F;
    text-decoration: none;
}
.expense-history-link a:hover {
    text-decoration: underline;
}

/* MOBILE */
@media (max-width: 640px) {
    .expense-entry-page {
        padding: 0.75rem 1rem;
    }
    .expense-form-card {
        padding: 0.85rem;
    }
    .expense-two-column {
        grid-template-columns: 1fr;
        gap: 0.65rem;
    
}

/* =========================================================
   EXPENSE LIST PAGE
   ========================================================= */
.expense-list-page {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem;
    box-sizing: border-box;
}

/* HEADER */
.expense-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
}
.expense-list-header h1 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    color: #111827;
}
.expense-list-header p {
    margin: 0.3rem 0 0;
    color: #6b7280;
    font-size: 0.8rem;
}
.expense-new-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border-radius: 0.5rem;
    background: #f97316;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
}
.expense-new-button:hover {
    background: #ea580c;
}

/* SUMMARY */
.expense-summary-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(254, 243, 199, 0.55);
    border: 1px solid rgba(251, 191, 36, 0.6);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
}
.expense-summary-card span {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #92400e;
}
.expense-summary-card strong {
    display: block;
    margin-top: 0.2rem;
    font-size: 1.35rem;
    color: #111827;
}
.expense-summary-period {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
}

/* FILTERS */
.expense-filter-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem;
    background: #ffffff;
    border: 1px solid #E4DECB;
    border-radius: 0.75rem;
    margin-bottom: 1rem;
}
.expense-filter-presets {
    display: flex;
    gap: 0.35rem;
}
.expense-filter-presets a {
    padding: 0.45rem 0.7rem;
    border-radius: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #4b5563;
    text-decoration: none;
}
.expense-filter-presets a:hover {
    background: #f3f4f6;
}
.expense-filter-presets a.active {
    background: #00674F;
    color: #ffffff;
}
.expense-filter-form {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
}
.expense-filter-form > div {
    display: flex;
    flex-direction: column;
}
.expense-filter-form label {
    margin-bottom: 0.2rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #6b7280;
}
.expense-filter-form input,
.expense-filter-form select {
    border: 1px solid #E4DECB;
    border-radius: 0.4rem;
    padding: 0.45rem 0.55rem;
    font-size: 0.72rem;
    background: #ffffff;
}
.expense-filter-form button {
    border: none;
    border-radius: 0.4rem;
    padding: 0.5rem 0.85rem;
    background: #f97316 !important;
    color: #ffffff !important;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
}

/* TABLE */
.expense-list-card {
    background: #ffffff;
    border: 1px solid #E4DECB;
    border-radius: 0.75rem;
    overflow: hidden;
}
.expense-list-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #E4DECB;
}
.expense-list-card-header h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    color: #111827;
}
.expense-list-card-header span {
    font-size: 0.7rem;
    color: #6b7280;
}
.expense-table-wrapper {
    overflow-x: auto;
}
.expense-list-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
}
.expense-list-table th {
    padding: 0.75rem 1rem;
    text-align: left;
    background: #f9fafb;
    border-bottom: 1px solid #E4DECB;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #6b7280;
}
.expense-list-table td {
    padding: 0.8rem 1rem;
    border-bottom: 1px solid #f3f4f6;
    color: #374151;
}
.expense-list-table tbody tr:hover {
    background: #fafafa;
}
.expense-category {
    font-weight: 700;
    color: #111827;
}
.expense-description {
    max-width: 420px;
}
.amount-column {
    text-align: right !important;
    white-space: nowrap;
    font-weight: 700;
    color: #111827 !important;
}
.expense-empty {
    padding: 3rem 1rem !important;
    text-align: center !important;
    color: #9ca3af !important;
}

/* PAGINATION */
.expense-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1rem;
    border-top: 1px solid #E4DECB;
    font-size: 0.75rem;
}
.expense-pagination a {
    color: #00674F;
    font-weight: 700;
    text-decoration: none;
}
.expense-pagination span {
    color: #6b7280;
}

/* RESPONSIVE */
@media (max-width: 900px) {
    .expense-filter-card {
        flex-direction: column;
        align-items: stretch;
    }
    .expense-filter-form {
        flex-wrap: wrap;
    }
}
@media (max-width: 640px) {
    .expense-list-page {
        padding: 1rem;
    }
    .expense-list-header {
        align-items: flex-start;
        flex-direction: column;
    }
    .expense-filter-form {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }
    .expense-filter-form button {
        grid-column: 1 / -1;
    }
}
</file>

