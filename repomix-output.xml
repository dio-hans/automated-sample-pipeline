<!-- PROCESSING CONTROL -->
<div class="bg-white border border-[#E4DECB] rounded-xl shadow-sm overflow-hidden">
    <div class="px-6 py-5 border-b border-[#E4DECB]">
        <p class="eyebrow text-clay">Processing</p>
        <h3 class="font-display text-xl text-ink mt-1">Move coffee through production</h3>
        <p class="text-sm text-clay mt-1">
            Start a roasting, sorting or grinding run. Source coffee leaves available inventory
            until the run is completed.
        </p>
    </div>

    <div class="p-6">
        <form method="post" action="{% url 'process_stock' stock.pk %}" class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {% csrf_token %}
            <div>
                <label class="block text-sm font-semibold mb-1" for="{{ processing_issue_form.process_type.id_for_label }}">Process</label>
                {{ processing_issue_form.process_type }}
            </div>
            <div>
                <label class="block text-sm font-semibold mb-1" for="{{ processing_issue_form.input_quantity.id_for_label }}">Input (kg)</label>
                {{ processing_issue_form.input_quantity }}
            </div>
            <div>
                <label class="block text-sm font-semibold mb-1" for="{{ processing_issue_form.notes.id_for_label }}">Note</label>
                {{ processing_issue_form.notes }}
            </div>
            <div class="md:col-span-3 flex justify-end">
                <button type="submit" class="px-5 py-2.5 rounded-md bg-rust text-white text-sm font-semibold hover:bg-rust-dark">
                    Start Processing
                </button>
            </div>
        </form>
    </div>

    {% if open_processing_runs %}
    <div class="border-t border-[#E4DECB]">
        <div class="px-6 py-4 bg-paper">
            <p class="text-sm font-semibold text-ink">Open processing runs</p>
            <p class="text-xs text-clay mt-1">Complete each run when coffee is received back from production.</p>
        </div>

        <div class="divide-y divide-[#EEE9DB]">
            {% for run in open_processing_runs %}
            <div class="p-6">
                <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5">
                    <div>
                        <p class="font-semibold text-ink">
                            Run #{{ run.pk }} - {{ run.get_process_type_display }}
                        </p>
                        <p class="text-sm text-clay mt-1">
                            Issued {{ run.input_quantity|floatformat:2 }} kg
                            from {{ run.get_input_stage_display }}
                        </p>
                    </div>

                    <form method="post" action="{% url 'processing_complete' run.pk %}" class="grid grid-cols-1 md:grid-cols-3 gap-3 w-full lg:max-w-3xl">
                        {% csrf_token %}
                        <div>
                            <label class="block text-xs font-semibold mb-1">Good / output (kg)</label>
                            {{ processing_complete_form.output_quantity }}
                        </div>
                        <div>
                            <label class="block text-xs font-semibold mb-1">Quakers (kg)</label>
                            {{ processing_complete_form.quaker_quantity }}
                        </div>
                        <div>
                            <label class="block text-xs font-semibold mb-1">Note</label>
                            {{ processing_complete_form.notes }}
                        </div>
                        <div class="md:col-span-3 flex justify-end">
                            <button type="submit" class="px-4 py-2 rounded-md bg-olive text-white text-sm font-semibold hover:opacity-90">
                                Complete Run
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>


<!-- MOVEMENT HISTORY -->
<div class="bg-white border border-[#E4DECB]
            rounded-xl shadow-sm overflow-hidden">

    <div class="px-6 py-5 border-b border-[#E4DECB]
                flex flex-col md:flex-row
                md:items-center md:justify-between gap-2">

        <div>

            <p class="eyebrow text-clay">
                Traceability
            </p>

            <h3 class="font-display text-xl text-ink mt-1">
                Batch history
            </h3>

        </div>

        <span class="text-xs text-clay">
            Every recorded movement for this batch
        </span>

    </div>


    <div class="overflow-x-auto">

        <table class="w-full text-sm">

            <thead class="bg-paper border-b border-[#E4DECB]">

                <tr class="text-left text-xs uppercase
                           tracking-wider text-clay">

                    <th class="px-6 py-3">
                        Date
                    </th>

                    <th class="px-6 py-3">
                        Movement
                    </th>

                    <th class="px-6 py-3">
                        From
                    </th>

                    <th class="px-6 py-3">
                        To
                    </th>

                    <th class="px-6 py-3 text-right">
                        Quantity
                    </th>

                    <th class="px-6 py-3">
                        Recorded by
                    </th>

                </tr>

            </thead>


            <tbody class="divide-y divide-[#EEE9DB]">

                {% for movement in movements %}

                <tr class="hover:bg-paper/50">

                    <td class="px-6 py-4 whitespace-nowrap
                               text-clay">
                        {{ movement.created_at|date:"d M Y, H:i" }}
                    </td>

                    <td class="px-6 py-4 font-medium text-ink">
                        {{ movement.get_movement_type_display }}
                    </td>

                    <td class="px-6 py-4 text-clay capitalize">
                        {{ movement.from_stage|default:"Ã¢â‚¬â€" }}
                    </td>

                    <td class="px-6 py-4 text-clay capitalize">
                        {{ movement.to_stage|default:"Ã¢â‚¬â€" }}
                    </td>

                    <td class="px-6 py-4 text-right
                               font-semibold tabular-nums">
                        {{ movement.quantity|floatformat:2 }}
                        <span class="text-xs font-normal text-clay">
                            kg
                        </span>
                    </td>

                    <td class="px-6 py-4 text-clay">
                        {% if movement.created_by %}
                            {{ movement.created_by.username }}
                        {% else %}
                            System
                        {% endif %}
                    </td>

                </tr>

                {% empty %}

                <tr>

                    <td colspan="6"
                        class="px-6 py-12 text-center text-clay">

                        No movements have been recorded for this batch yet.

                    </td>

                </tr>

                {% endfor %}

            </tbody>

        </table>

    </div>

</div>


<!-- BATCH NOTE -->
<div class="rounded-xl border border-olive/20
            bg-olive/5 px-5 py-4">

    <p class="text-sm font-medium text-olive">
        Batch traceability
    </p>

    <p class="text-sm text-clay mt-1">
        This batch remains traceable throughout its processing history.
        Packaging and finished-product records can be linked back to this
        batch when packaged coffee is produced.
    </p>

</div>


</div>

{% endblock %}



--- FILE: stock_form.html.FullName ---

{% extends "pipeline/base.html" %}

{% block title %} Stock Intake Registry | Nonda {% endblock %}

{% block breadcrumb %} Coffee Stock {% endblock %}

{% block header_action %}
{% endblock %}

{% block content %}
<div class="max-w-3xl">

    <!-- Introduction -->
    <div class="mb-8">
        <p class="text-sm text-clay">
            {% if object %}
                Update the details for {{ object.variety_name }}.
            {% else %}
                Register a coffee batch â€” from green bean receiving through roasting, grinding, and packaging.
            {% endif %}
        </p>
    </div>

    <!-- Form Card -->
    <div class="card p-6 md:p-8">

        <form method="post" novalidate>
            {% csrf_token %}

            <!-- Non-field errors -->
            {% if form.non_field_errors %}
                <div class="mb-6 rounded-md border border-rust-light bg-rust-50 px-4 py-3">
                    {% for error in form.non_field_errors %}
                        <p class="text-sm text-rust-dark">{{ error }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            {% if form.errors %}
                <div class="mb-6 rounded-md border border-red-300 bg-red-50 px-4 py-3">
                    <p class="font-semibold text-red-800">Please correct the following errors:</p>
                    {{ form.errors }}
                </div>
            {% endif %}

            <!-- Coffee Identity -->
            <div class="mb-8">
                <div class="mb-5">
                    <h2 class="font-display text-xl mt-1">Coffee Details</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <div class="md:col-span-2">
                        <label for="{{ form.variety_name.id_for_label }}" class="field-label block mb-2">
                            Name of Material
                        </label>

                        {{ form.variety_name }}

                        <!-- Existing coffee definitions, with their master defaults -->
                        <datalist id="variety_list">
                            {% for variety in existing_varieties %}
                                <option value="{{ variety.name }}"
                                        data-coffee-type="{{ variety.default_coffee_type }}"
                                        data-grade="{{ variety.default_grade }}"
                                        data-source="{{ variety.default_source }}"
                                        data-process="{{ variety.default_process }}"
                                        data-foreign-smell="{{ variety.default_foreign_smell }}"></option>
                            {% endfor %}
                        </datalist>

                        <p class="mt-2 text-xs text-clay">
                            Typing a matching name restocks that coffee line, a custom name
                            auto-generates a new coffee definition.
                        </p>

                        <p id="variety_hint" class="mt-1 text-xs text-olive hidden"></p>

                        {% if form.variety_name.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.variety_name.errors %}
                                    <p>{{ error }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div>
                        <label for="{{ form.coffee_type.id_for_label }}" class="field-label block mb-2">
                            Coffee Type
                        </label>
                        {{ form.coffee_type }}
                        {% if form.coffee_type.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.coffee_type.errors %}
                                    <p>{{ error }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                </div>
            </div>

            <!-- Green Coffee Receiving -->
            <div class="mb-8">
                <div class="mb-5">
                    <p class="eyebrow text-clay">Green Coffee Receiving</p>
                    <h2 class="font-display text-xl mt-1">Purchase &amp; Source</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <div>
                        <label for="{{ form.received_date.id_for_label }}" class="field-label block mb-2">Date Received</label>
                        {{ form.received_date }}
                        {% if form.received_date.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.received_date.errors %}<p>{{ error }}</p>{% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div>
                        <label for="{{ form.supplier.id_for_label }}" class="field-label block mb-2">Company Name (Supplier)</label>
                        {{ form.supplier }}
                        {% if form.supplier.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.supplier.errors %}<p>{{ error }}</p>{% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div>
                        <label for="{{ form.source.id_for_label }}" class="field-label block mb-2">Source</label>
                        {{ form.source }}
                        {% if form.source.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.source.errors %}<p>{{ error }}</p>{% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div>
                        <label for="{{ form.grade.id_for_label }}" class="field-label block mb-2">Grade</label>
                        {{ form.grade }}
                        {% if form.grade.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.grade.errors %}<p>{{ error }}</p>{% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    {% if form.quantity_received %}
                    <div>
                        <label for="{{ form.quantity_received.id_for_label }}" class="field-label block mb-2">Quantity Received (kg)</label>
                        {{ form.quantity_received }}
                        <p class="mt-2 text-xs text-clay">
                            Posted to the stock ledger as a green-coffee receipt.
                        </p>
                        {% if form.quantity_received.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.quantity_received.errors %}<p>{{ error }}</p>{% endfor %}
                            </div>
                        {% endif %}
                    </div>
                    {% endif %}

                    <div>
                        <label for="{{ form.moisture_content.id_for_label }}" class="field-label block mb-2">Moisture Content</label>
                        {{ form.moisture_content }}
                        {% if form.moisture_content.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.moisture_content.errors %}<p>{{ error }}</p>{% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div>
                        <label for="{{ form.process.id_for_label }}" class="field-label block mb-2">Process</label>
                        {{ form.process }}
                        {% if form.process.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.process.errors %}<p>{{ error }}</p>{% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div>
                        <label for="{{ form.fermentation_type.id_for_label }}" class="field-label block mb-2">Fermentation Type</label>
                        {{ form.fermentation_type }}
                        {% if form.fermentation_type.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.fermentation_type.errors %}<p>{{ error }}</p>{% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div>
                        <label for="{{ form.season_of_harvest.id_for_label }}" class="field-label block mb-2">Season of Harvest</label>
                        {{ form.season_of_harvest }}
                        {% if form.season_of_harvest.errors %}
                            <div class="mt-1 text-sm text-rust-dark">
                                {% for error in form.season_of_harvest.errors %}<p>{{ error }}</p>{% endfor %}
                            </div>
                        {% endif %}
                    </div>

                </div>
            </div>

            <!-- Quality Analysis -->
            <div class="mb-8">
                <div class="mb-5">
                    <p class="eyebrow text-clay">Quality Analysis</p>
                    <h2 class="font-display text-xl mt-1">Sorting &amp; Defects</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <div>
                        <label for="{{ form.foreign_smell.id_for_label }}" class="field-label block mb-2">Foreign Smell</label>
                        {{ form.foreign_smell }}
                    </div>

                    <div>
                        <label for="{{ form.foreign_matter.id_for_label }}" class="field-label block mb-2">Foreign Matter</label>
                        {{ form.foreign_matter }}
                    </div>

                    <div>
                        <label for="{{ form.prints.id_for_label }}" class="field-label block mb-2">Prints</label>
                        {{ form.prints }}
                    </div>

                    <div>
                        <label for="{{ form.physical_damages.id_for_label }}" class="field-label block mb-2">Physical Damages</label>
                        {{ form.physical_damages }}
                    </div>

                    <div>
                        <label for="{{ form.defects.id_for_label }}" class="field-label block mb-2">Defects (kg)</label>
                        {{ form.defects }}
                    </div>

                    <div>
                        <label for="{{ form.quantity_after_sorting.id_for_label }}" class="field-label block mb-2">After Sorting (kg)</label>
                        {{ form.quantity_after_sorting }}
                    </div>

                </div>
            </div>

            <!-- Receiving Sign-off -->
            <div class="mb-8">
                <div class="mb-5">
                    <p class="eyebrow text-clay">Receiving Sign-off</p>
                    <h2 class="font-display text-xl mt-1">Personnel</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <div>
                        <label for="{{ form.checked_by.id_for_label }}" class="field-label block mb-2">Checked By</label>
                        {{ form.checked_by }}
                    </div>

                    <div>
                        <label for="{{ form.verified_by.id_for_label }}" class="field-label block mb-2">Verified By</label>
                        {{ form.verified_by }}
                    </div>

                    <div>
                        <label for="{{ form.delivered_by.id_for_label }}" class="field-label block mb-2">Delivered By</label>
                        {{ form.delivered_by }}
                    </div>

                    <div>
                        <label for="{{ form.car_number.id_for_label }}" class="field-label block mb-2">Car No.</label>
                        {{ form.car_number }}
                    </div>

                    <div>
                        <label for="{{ form.received_by.id_for_label }}" class="field-label block mb-2">Received By</label>
                        {{ form.received_by }}
                    </div>

                </div>
            </div>

            <!-- Inventory -->
            <div class="mb-8">
                <div class="mb-5">
                    <p class="eyebrow text-clay">Inventory</p>
                    <h2 class="font-display text-xl mt-1">Reorder Settings</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <div>
                        <label for="{{ form.reorder_level.id_for_label }}" class="field-label block mb-2">Reorder Level (kg)</label>
                        {{ form.reorder_level }}
                        <p class="mt-2 text-xs text-clay">
                            Flagged as low stock when available drops to this level.
                        </p>
                    </div>

                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-6 border-t border-[#E4DECB]">

                <a href="{% url 'stock_list' %}"
                   class="px-4 py-2.5 text-sm font-medium rounded-md border border-[#E4DECB] hover:bg-paper-dim transition">
