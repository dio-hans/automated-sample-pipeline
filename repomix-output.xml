                                    data-coffee-type="{{ variety.default_coffee_type }}"
                                    data-grade="{{ variety.default_grade }}"
                                    data-source="{{ variety.default_source }}"
                                    data-process="{{ variety.default_process }}"
                                    data-foreign-smell="{{ variety.default_foreign_smell }}">
                                </option>
