                    </th>

                    <th class="px-6 py-3 text-right font-semibold">
                        Ground
                    </th>

                    <th class="px-6 py-3 text-right font-semibold">
                        Total
                    </th>

                    <th class="px-6 py-3 text-center font-semibold">
                        Status
                    </th>

                    <th class="px-6 py-3"></th>

                </tr>

            </thead>


