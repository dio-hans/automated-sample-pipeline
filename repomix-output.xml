<file path="web/templates/pipeline/pack_release_list.html">
{% extends "pipeline/base.html" %}
{% load static %}
{% load humanize %}

{% block title %}Stock Releases Ledger | Nonda{% endblock %}
{% block breadcrumb %}Financials / Stock Releases{% endblock %}

{% block page_subtitle %}
<p class="mt-1 text-xs text-slate-500">
    Accountability desk for physical dispatches, partial field credits, and real-time debt liquidations.
</p>
{% endblock %}

{% block content %}
<div class="space-y-4">
    

    <!-- 1. LIVE DYNAMIC FINANCIAL MATRIX CARDS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <!-- Card A: Total Value Released -->
        <div class="bg-white border border-[#E4DECB] rounded-xl p-3.5 shadow-sm">
            <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Total Value Dispatched</p>
            <p class="font-bold text-xl mt-1 text-slate-800">{{ total_value_issued|default:"0"|floatformat:"0"|intcomma }} <span class="text-xs font-normal text-slate-400">UGX</span></p>
            <p class="text-[11px] text-slate-400 mt-0.5">Gross worth of inventory moved from warehouse</p>
        </div>

        <!-- Card B: Cash Collected Natively -->
        {% if request.user.role == "CASHIER" or request.user.role == "ACCOUNTS" %}
        <div class="bg-white border border-[#E4DECB] rounded-xl p-3.5 shadow-sm">
            <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Liquid Cash Collected</p>
            <p class="font-bold text-xl mt-1 text-emerald-600">{{ total_collected_revenue|default:"0"|floatformat:"0"|intcomma }} <span class="text-xs font-normal text-slate-400">UGX</span></p>
            <p class="text-[11px] text-slate-400 mt-0.5">Cleared revenue securely locked in-house</p>
        </div>
        {% endif %}

        <!-- Card C: Unpaid Outstanding Debt -->
        {% if request.user.role == "CASHIER" or request.user.role == "ACCOUNTS" %}
        <a href="{% url 'credit_control_ledger' %}" class="block hover:opacity-95 transition">
            <div class="bg-white border border-[#E4DECB] rounded-xl p-3.5 shadow-sm">
                <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Outstanding Field Debt</p>
                <p class="font-bold text-xl mt-1 text-rose-600">{{ total_outstanding_debt|default:"0"|floatformat:"0"|intcomma }} <span class="text-xs font-normal text-slate-400">UGX</span></p>
                <p class="text-[11px] text-slate-400 mt-0.5">Active credit balances currently pending collection</p>
            </div>
        </a>
        {% endif %}
    </div>

    <!-- 2. DATE FILTERS TIMELINE CONTROL BAR -->
    
    <!-- DATE FILTERS -->
    {% include "reports/components/report_filters.html" %}
    {% if date_filter_error %}
    <p class="text-xs text-rose-600 mt-2">
        {{ date_filter_error }}
    </p>
{% endif %}

    <!-- 3. CENTRAL TRANSACTION LEDGER TABLE -->
    <div class="bg-white border border-[#E4DECB] rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse bg-white">
                <thead>
                    <tr class="bg-slate-50 border-b border-[#E4DECB] text-slate-600 font-semibold text-[11px] uppercase tracking-wider">
                        <th class="px-4 py-3">Date Issued</th>
                        <th class="px-4 py-3">Product Variant</th>
                        <th class="px-4 py-3">Account Holder</th>
                        <th class="px-4 py-3 text-center">Out</th>
                        <th class="px-4 py-3 text-center">Returned</th>
                        <th class="px-4 py-3 text-center">Outstanding</th>
                        <th class="px-4 py-3 text-right">Price / Pack</th>

                        {% if request.user.role == "CASHIER" or request.user.role == "ACCOUNTS" %}
                        <th class="px-4 py-3 text-right">Collected</th>
                        <th class="px-4 py-3 text-right">Debt Balance</th>
                        <th class="px-4 py-3 text-center">Quick Action</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E4DECB] text-slate-700 text-xs">
                    {% for release in releases %}
                    <tr class="hover:bg-slate-50/50 transition duration-150">
                        <!-- Date -->
                        <td class="px-4 py-3 whitespace-nowrap text-slate-500 font-medium">
                            {{ release.released_at|date:"d M Y, H:i" }}
                        </td>

                        <!-- Product -->
                        <td class="px-4 py-3 whitespace-nowrap font-bold text-slate-900">
                            {{ release.product.blend.name }} · {{ release.product.pack_size.label }}
                        </td>

                        <!-- Account Holder -->
                        <td class="px-4 py-3 whitespace-nowrap font-semibold text-slate-800">
                            {% if release.released_to %}
                                {{ release.released_to.name }}
                            {% else %}
                                <span class="text-slate-400 font-normal italic">Unassigned Agent</span>
                            {% endif %}
                        </td>

                        <!-- Quantity Columns -->
                        <td class="px-4 py-3 text-center font-medium text-slate-500">{{ release.packs_out }}</td>
                        <td class="px-4 py-3 text-center font-medium text-slate-500">{{ release.packs_returned }}</td>
                        <td class="px-4 py-3 text-center font-bold text-slate-800 bg-slate-50/50">{{ release.packs_outstanding }}</td>

                        <!-- Price / Pack -->
                        <td class="px-4 py-3 text-right font-medium text-slate-500">{{ release.selling_price|floatformat:0|intcomma }}</td>

                        {% if request.user.role == "CASHIER" or request.user.role == "ACCOUNTS" %}
                        <!-- Collected Revenue -->
                        <td class="px-4 py-3 text-right font-bold text-emerald-600">{{ release.total_amount_paid|floatformat:0|intcomma }}</td>

                        <!-- Remaining Balance Owed -->
                        <td class="px-4 py-3 text-right font-black text-rose-600 bg-rose-50/10">
                            {{ release.outstanding_balance|floatformat:0|intcomma }}
                        </td>

                        <!-- Direct Quick Actions Payment Trigger -->
                        <td class="px-4 py-3 text-center whitespace-nowrap">
                            {% if not release.is_fully_cleared %}
                                <a href="{% url 'record_installment' release.pk %}" class="inline-flex px-2.5 py-1 bg-rust hover:bg-rust-dark text-white rounded text-[11px] font-bold shadow-sm transition">
                                    Collect UGX
                                </a>
                            {% else %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">✓ Settled</span>
                            {% endif %}
                        </td>
                        {% endif %}
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="10" class="px-4 py-12 text-center text-slate-400 italic">
                            No product lot dispatches currently found matching this filter window.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function submitCustomFilter() {
        const form = document.getElementById('filterForm');
        // Submit only if both dates are chosen or when user changes date input
        form.submit();
    }
</script>
{% endblock %}
</file>

<file path="web/templates/pipeline/packaging_run_form.html">
{% extends "pipeline/base.html" %}
{% load humanize %}

{% block title %}Start Packaging Run | Nonda{% endblock %}
{% block breadcrumb %}Inventory / Packaging / Start Run{% endblock %}
{% block page_title %}Start Packaging Run{% endblock %}
{% block page_subtitle %}
<p class="text-xs text-slate-500">
    Issue roasted or ground coffee from one or more batches. Record the pack quantities after production is finished.
</p>
{% endblock %}

{% block header_action %}
    <div>
        <a href="{% url 'packaged_product_form' %}" type="submit" class="px-4 py-1.5 bg-emerald-500 hover:bg-orange-600 text-white rounded-md text-[11px] font-bold transition-all shadow-xs cursor-pointer">
        New packaged product
        </a>
    </div>
{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto px-2 sm:px-3 space-y-2 text-xs">
    
    <!-- =========================================================
         UNIFIED CENTERED COMPACT CARD CONTAINER
         ========================================================= -->
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden flex flex-col">
        
        <!-- Dark Card Top Header -->
        <div class="bg-[#325232] text-white px-3.5 py-2.5 flex items-center justify-between border-b border-slate-800 shrink-0">
            <div>
                <span class="text-[9px] font-mono tracking-wider text-emerald-400 font-bold uppercase block">
                    Inventory Processing
                </span>
                <h3 class="text-xs font-bold text-white">Start New Packaging Run</h3>
            </div>
        </div>

        <!-- Form Wrapping Body & Footer -->
        <form method="post" autocomplete="off" class="flex flex-col flex-grow">
            {% csrf_token %}
            
            <!-- Card Body Content -->
            <div class="p-3 space-y-2.5 bg-white">
                
                {% if form.errors %}
                <div class="rounded-lg border border-rose-200 bg-rose-50 p-2.5 text-xs text-rose-700 font-semibold">
                    {{ form.errors }}
                </div>
                {% endif %}

                <!-- Source Stage Section -->
                <div class="bg-slate-50 border border-slate-200/80 rounded-lg p-2.5">
                    <label class="block text-[9px] uppercase font-bold text-slate-500 mb-1">
                        Source Stage
                    </label>
                    <div class="[&_select]:w-full [&_select]:bg-white [&_select]:border [&_select]:border-slate-300 [&_select]:rounded-md [&_select]:px-2 [&_select]:py-1.5 [&_select]:text-xs [&_select]:font-semibold [&_select]:text-slate-800">
                        {{ form.source_stage }}
                    </div>
                </div>

                <!-- Source Batches Issued Section -->
                <div class="bg-slate-50 border border-slate-200/80 rounded-lg p-2.5 space-y-2">
                    <div class="flex items-center justify-between border-b border-slate-200/60 pb-1.5">
                        <div>
                            <h4 class="text-[10px] font-bold uppercase tracking-wide text-slate-600">Source Batches</h4>
                            <p class="text-[10px] text-slate-400">Add each batch and the kilograms issued to this run[cite: 17].</p>
                        </div>
                        <button type="button" id="add-input-row" class="text-[10px] font-bold text-emerald-600 hover:underline cursor-pointer">
                            + Add batch
                        </button>
                    </div>

                    <div class="overflow-x-auto max-h-48 overflow-y-auto pr-1">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-100 text-[9px] uppercase text-slate-500 sticky top-0">
                                <tr>
                                    <th class="p-1.5">Coffee batch</th>
                                    <th class="p-1.5 w-32">Input (kg)</th>
                                    <th class="p-1.5 w-8"></th>
                                </tr>
                            </thead>
                            <tbody id="input-rows" class="divide-y divide-slate-100">
                                <tr class="input-row">
                                    <td class="py-1.5 pr-1">
                                        <select name="input_stock[]" required class="w-full bg-white border border-slate-300 rounded px-2 py-1 text-xs text-slate-800">
                                            <option value="">Select batch…</option>
                                            {% for stock in stocks %}
                                            <option value="{{ stock.pk }}">{{ stock.batch_number }} — {{ stock.variety.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </td>
                                    <td class="py-1.5 px-1">
                                        <input name="input_kg[]" type="number" step="0.01" min="0.01" required class="w-full bg-white border border-slate-300 rounded px-2 py-1 text-xs font-mono font-bold text-slate-900" placeholder="e.g. 40.00">
                                    </td>
                                    <td class="py-1.5 pl-1 text-center">
                                        <button type="button" class="remove-input-row text-slate-400 hover:text-rose-600 font-bold cursor-pointer" aria-label="Remove batch row">×</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Notes Section -->
                <div class="bg-slate-50 border border-slate-200/80 rounded-lg p-2.5">
                    <label class="block text-[9px] uppercase font-bold text-slate-500 mb-1">
                        Notes
                    </label>
                    <div class="[&_textarea]:w-full [&_textarea]:bg-white [&_textarea]:border [&_textarea]:border-slate-300 [&_textarea]:rounded-md [&_textarea]:px-2 [&_textarea]:py-1.5 [&_textarea]:text-xs [&_textarea]:text-slate-800">
                        {{ form.notes }}
                    </div>
                </div>

            </div>

            <!-- Card Footer Action Bar -->
            <div class="bg-slate-50 px-4 py-2.5 border-t border-slate-200 flex items-center justify-between gap-3 shrink-0">
                <a href="{% url 'packaging_run_list' %}" class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-md text-[11px] font-bold transition-all cursor-pointer">
                    Cancel
                </a>
                <button type="submit" class="px-4 py-1.5 bg-orange-500 hover:bg-orange-600 text-white rounded-md text-[11px] font-bold transition-all shadow-xs cursor-pointer">
                    Start Packaging Run
                </button>
            </div>

        </form>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const rows = document.getElementById("input-rows");
    const addButton = document.getElementById("add-input-row");
    if (!rows || !addButton) return;
    
    addButton.addEventListener("click", () => {
        const row = rows.querySelector(".input-row").cloneNode(true);
        row.querySelector("select").value = "";
        row.querySelector("input").value = "";
        rows.appendChild(row);
    });
    
    rows.addEventListener("click", event => {
        if (!event.target.classList.contains("remove-input-row")) return;
        const allRows = rows.querySelectorAll(".input-row");
        if (allRows.length === 1) {
            allRows[0].querySelector("select").value = "";
            allRows[0].querySelector("input").value = "";
        } else {
            event.target.closest(".input-row").remove();
        }
    });
});
</script>
{% endblock %}
</file>

<file path="web/templates/pipeline/pack_return_list.html">
{% extends "pipeline/base.html" %}
{% load static humanize %}

{% block title %}Pack Returns | Nonda{% endblock %}
{% block breadcrumb %}Stock Control / Returns{% endblock %}
{% block page_title %}Pack Returns Log{% endblock %}

{% block page_subtitle %}
<p class="mt-0.5 text-xs text-slate-500">
    Audit trail of all packaged coffee returns, condition logs, and store re-entry records.
</p>
{% endblock %}

{% block content %}

<div class="max-w-6xl mx-auto space-y-3">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="bg-white border border-[#E4DECB] rounded-xl p-3.5 shadow-sm">
            <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Total Value Returned</p>
            <p class="font-bold text-xl mt-1 text-slate-800">
                {{ total_returns_value|default:"0"|floatformat:"0"|intcomma }} <span class="text-xs font-normal text-slate-400">UGX</span>
            </p>
            <p class="text-[11px] text-slate-400 mt-0.5">Gross worth of inventory returned to warehouse</p>
        </div>
    </div>

    <!-- MAIN LOG CARD -->
    <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto">

            <form id="filterForm" method="get" class="flex flex-wrap items-center justify-between gap-3 mb-4 bg-white p-3 rounded-lg border border-slate-100 shadow-sm">
    <!-- Quick Date Filter Pills -->
    <div class="flex items-center gap-1 overflow-x-auto py-0.5">
                <a href="?range=this_week{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}" 
           class="px-2.5 py-1 rounded text-xs font-semibold transition {% if selected_range == 'this_week' %}bg-slate-800 text-white{% else %}bg-slate-100 text-slate-600 hover:bg-slate-200{% endif %}">
            This Week
        </a>
        <a href="?range=today{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}" 
           class="px-2.5 py-1 rounded text-xs font-semibold transition {% if selected_range == 'today' %}bg-slate-800 text-white{% else %}bg-slate-100 text-slate-600 hover:bg-slate-200{% endif %}">
            Today
        </a>
        <a href="?range=yesterday{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}" 
           class="px-2.5 py-1 rounded text-xs font-semibold transition {% if selected_range == 'yesterday' %}bg-slate-800 text-white{% else %}bg-slate-100 text-slate-600 hover:bg-slate-200{% endif %}">
            Yesterday
        </a>
        <a href="?range=this_month{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}" 
           class="px-2.5 py-1 rounded text-xs font-semibold transition {% if selected_range == 'this_month' %}bg-slate-800 text-white{% else %}bg-slate-100 text-slate-600 hover:bg-slate-200{% endif %}">
            This Month
        </a>
    </div>

    <!-- Custom Date Range & Text Search -->
    <div class="flex items-center gap-2 w-full md:w-auto justify-end">
        <input type="hidden" name="range" value="{{ selected_range }}">

        <div class="flex items-center gap-1 bg-slate-50 border border-slate-200 rounded px-2 py-1">
            <span class="text-[10px] text-slate-400 uppercase font-bold">From</span>
            <input type="date" name="start_date" value="{{ request.GET.start_date }}" onchange="setCustomAndSubmit()"
                   class="bg-transparent text-slate-700 text-xs focus:outline-none">
            <span class="text-[10px] text-slate-400 uppercase font-bold ml-1">To</span>
            <input type="date" name="end_date" value="{{ request.GET.end_date }}" onchange="setCustomAndSubmit()"
                   class="bg-transparent text-slate-700 text-xs focus:outline-none">
        </div>

        <div class="relative">
            <input type="text" id="productSearch" name="q" value="{{ request.GET.q }}"
                   placeholder="Filter product..."
                   class="w-44 px-2.5 py-1 text-xs bg-white border border-slate-200 rounded focus:outline-none focus:border-orange-500">
        </div>
    </div>
</form>

<script>
    function setCustomAndSubmit() {
        // Automatically switch hidden range field to 'custom' when dates are picked
        document.querySelector('input[name="range"]').value = 'custom';
        document.getElementById('filterForm').submit();
    }
</script>

            <table class="w-full text-left border-collapse">
                <!-- TABLE HEADER -->
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-200 text-[10px] font-bold uppercase tracking-wider text-slate-500">
                        <th class="py-2.5 px-3.5">Date & Time</th>
                        <th class="py-2.5 px-3.5">Product Detail</th>
                        <th class="py-2.5 px-3.5">Returned By (Account)</th>
                        <th class="py-2.5 px-3.5 text-center">Qty Returned</th>
                        <th class="py-2.5 px-3.5">Condition & Status</th>
                        <th class="py-2.5 px-3.5">Received By</th>
                    </tr>
                </thead>

                <!-- TABLE BODY -->
                <tbody class="divide-y divide-slate-100 text-xs">
                    {% for item in returns %}
                    <tr class="hover:bg-slate-50/70 transition-colors">

                        <!-- DATE & TIME -->
                        <td class="py-2.5 px-3.5 whitespace-nowrap">
                            <span class="font-medium text-slate-700 block">
                                {{ item.returned_at|date:"d M Y" }}
                            </span>
                            <span class="text-[10px] text-slate-400 font-mono">
                                {{ item.returned_at|date:"H:i" }}
                            </span>
                        </td>

                        <!-- PRODUCT -->
                        <td class="py-2.5 px-3.5 whitespace-nowrap">
                            <div class="font-semibold text-slate-800">
                                {{ item.release.product.blend.name }}
                            </div>
                            <div class="text-[10px] text-slate-500">
                                {{ item.release.product.pack_size.label }}
                            </div>
                        </td>

                        <!-- SALESPERSON / ACCOUNT -->
                        <td class="py-2.5 px-3.5 whitespace-nowrap">
                            {% if item.release.released_to_account %}
                                <div class="font-medium text-slate-800">
                                    {{ item.release.released_to_account.name }}
                                </div>
                                <span class="inline-block px-1.5 py-0.2 text-[9px] font-semibold bg-slate-100 text-slate-600 rounded">
                                    Account
                                </span>
                            {% elif item.release.released_to_user %}
                                <div class="font-medium text-slate-800">
                                    {% if item.release.released_to_user.get_full_name %}
                                        {{ item.release.released_to_user.get_full_name }}
                                    {% else %}
                                        {{ item.release.released_to_user.username }}
                                    {% endif %}
                                </div>
                                <span class="inline-block px-1.5 py-0.2 text-[9px] font-semibold bg-blue-50 text-blue-700 rounded">
                                    Staff / Rep
                                </span>
                            {% else %}
                                <span class="text-slate-400 italic">Unassigned</span>
                            {% endif %}
                        </td>

                        <!-- QTY RETURNED -->
                        <td class="py-2.5 px-3.5 text-center whitespace-nowrap">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-md font-bold text-xs bg-amber-50 text-amber-800 border border-amber-200/60">
                                {{ item.packs_returned }} packs
                            </span>
                        </td>

                        <!-- CONDITION / DISPOSITION / REASON -->
                        <td class="py-2.5 px-3.5">
                            <div class="flex items-center gap-1.5 mb-0.5">
                                {% if item.condition %}
                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-slate-100 text-slate-700 border border-slate-200">
                                        {{ item.condition }}
                                    </span>
                                {% endif %}
                                {% if item.disposition %}
                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        {{ item.disposition }}
                                    </span>
                                {% endif %}
                            </div>
                            <p class="text-slate-600 truncate max-w-xs text-[11px]">
                                {{ item.reason|default:"—" }}
                            </p>
                        </td>

                        <!-- RECEIVED BY -->
                        <td class="py-2.5 px-3.5 whitespace-nowrap">
                            <div class="text-slate-700 font-medium">
                                {{ item.received_by|default:"—" }}
                            </div>
                        </td>

                    </tr>
                    {% empty %}
                    <!-- EMPTY STATE -->
                    <tr>
                        <td colspan="6" class="py-12 text-center">
                            <div class="max-w-xs mx-auto space-y-2">
                                <div class="w-10 h-10 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                                    </svg>
                                </div>
                                <p class="text-xs font-bold text-slate-700">No stock returns recorded</p>
                                <p class="text-[11px] text-slate-400">
                                    When return transactions are logged against active releases, they will appear in this registry.
                                </p>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
</file>

<file path="web/templates/pipeline/stock_form.html">
{% extends "pipeline/base.html" %}
{% load crispy_forms_tags static %}

{% block title %}Stock Intake Registry | Nonda{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto">

    <!-- Master Form -->
    <form method="post" novalidate>
        {% csrf_token %}

        <!-- Error Notifications -->
        {% if form.non_field_errors or form.errors %}
            <div class="mb-4 p-3 rounded-lg bg-rust/10 border border-rust/20 text-xs text-rust space-y-1">
                <p class="font-bold">Please correct the highlighted form errors before proceeding.</p>
                {% for error in form.non_field_errors %}
