    margin: 0;
    min-height: 100vh;
}

   /* ---------------------------------------------------------
   GLOBAL BRIGHT ORANGE SUBMIT BUTTONS
   --------------------------------------------------------- */
button[type="submit"],
input[type="submit"] {
    background-color: #f97316 !important; /* Bright Orange (Tailwind Orange-500) */
    color: #ffffff !important;
    transition: background-color 150ms ease, transform 100ms ease;
}

button[data-submitting="true"],
input[data-submitting="true"] {
    cursor: wait;
    opacity: 0.7;
    pointer-events: none;
}

.submit-progress {
    display: inline-block;
    margin-inline-start: 0.5rem;
    font-size: 0.85em;
    font-weight: 600;
}

.deny-button{
    background-color: rgb(188, 30, 30);
}
/* ---------------------------------------------------------
   BRIGHT ORANGE FOR MAIN PAGE ACTIONS & FORMS
   (Strictly excludes <aside> sidebar)
   --------------------------------------------------------- */
/* ---------------------------------------------------------
   BRIGHT ORANGE FOR PRIMARY SUBMIT / ACTION BUTTONS ONLY
   --------------------------------------------------------- */

   

    /* Target primary action buttons inside <main> */
    main button[type="submit"]:not([class*="bg-red"]):not([class*="bg-rose"]):not([class*="border"]):not([name*="deny"]):not([name*="cancel"]),
    main input[type="submit"]:not([class*="bg-red"]):not([class*="bg-rose"]),
    .btn-primary {
        background-color: #f97316 !important; /* Bright Orange */
        color: #ffffff !important;
        transition: background-color 150ms ease;
    }

    aside form button,
aside button[type="submit"] {
    background-color: #00674F !important;
    color: #ffffff !important;
    transition: background-color 150ms ease;
}

    aside form button:hover,
    aside button[type="submit"]:hover {
        background-color: #004d3b !important; /* Darker emerald shade on hover */
    }

    main button[type="submit"]:not([class*="bg-red"]):not([class*="bg-rose"]):not([class*="border"]):not([name*="deny"]):not([name*="cancel"]):hover,
    .btn-primary:hover {
        background-color: #ea580c !important; /* Darker orange on hover */
    }

    /* Ensure Sidebar / Aside buttons (Logout) are NEVER overridden */
    aside button,
    aside form button,
    aside a {
        background-color: initial;
    }

        
        /* ---------------------------------------------------------
           SIDEBAR NAVIGATION & COMPACT LAYOUT
           --------------------------------------------------------- */
        .nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            width: 100%;
            padding: 0.5rem 0.75rem;
            border-radius: 0.5rem;
            color: rgba(255, 255, 255, 0.75);
            font-size: 0.85rem;
            font-weight: 500;
            transition: background-color 150ms ease, color 150ms ease;
        }
        .nav-slink:hover {
            background: #0d4e48 !important;
            color: #ffffff !important;
        }
        .nav-link.active {
            background: #0d4e48 !important;
            color: #ffffff !important;
            font-weight: 600;
        }
        .nav-icon {
            width: 1.25rem;
            text-align: center;
            flex-shrink: 0;
            opacity: 0.85;
            font-size: 0.9rem;
        }
        .nav-link:hover .nav-icon {
            opacity: 1;
        }
        /* ---------------------------------------------------------
           SIDEBAR SECTION LABELS
           --------------------------------------------------------- */
        .nav-section-title {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            margin-top: 0.25rem;
            margin-bottom: 0.35rem;
            font-size: 0.625rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: rgba(255, 255, 255, 0.45);
        }
        /* ---------------------------------------------------------
           SCROLLBAR
           --------------------------------------------------------- */
        #mainSidebar nav::-webkit-scrollbar {
            width: 4px;
        }
        #mainSidebar nav::-webkit-scrollbar-track {
            background: transparent;
        }
        #mainSidebar nav::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 999px;
        }
             
        #mainSidebar {
            transition: transform 200ms ease;
        }
        /* ---------------------------------------------------------
           PAGE ANIMATION
           --------------------------------------------------------- */
        .page-content {
            animation: pageEnter 180ms ease-out;
        }
        @keyframes pageEnter {
            from {
                opacity: 0;
                transform: translateY(4px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
/* Sidebar Hover and Active Page Color */
aside a.nav-link:hover,
aside a.nav-link.active {
    background-color: #0d4e48 !important; /* Dark Green-Blue */
    color: #ffffff !important;
    font-weight: 600 !important;
}

/* ---------------------------------------------------------
   SIDEBAR SCROLLBAR (Firefox & WebKit)
   --------------------------------------------------------- */
#mainSidebar nav {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.4) transparent;
}

#mainSidebar nav::-webkit-scrollbar {
    width: 8px; /* Wider scrollbar */
}

#mainSidebar nav::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.15); /* Subtle dark track */
    border-radius: 999px;
}

#mainSidebar nav::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.4); /* High contrast white bar */
    border-radius: 999px;
}

#mainSidebar nav::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.7); /* Brighter on hover */
}
