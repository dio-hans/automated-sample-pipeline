            @click.prevent="activeTab = 'quality'" 
            :class="activeTab === 'quality' ? 'text-orange-600 border-b-2 border-orange-500 bg-orange-50/30' : 'text-slate-500 hover:text-slate-800 hover:bg-slate-50'" 
