<script>
    document.addEventListener("DOMContentLoaded", function() {
        const setups = [
            { checkboxId: "id_size_sachet", targetId: "price-section-sachet" },
            { checkboxId: "id_size_50g", targetId: "price-section-50g" },
            { checkboxId: "id_size_250g", targetId: "price-section-250g" },
            { checkboxId: "id_size_500g", targetId: "price-section-500g" },
            { checkboxId: "id_size_1kg", targetId: "price-section-1kg" }
        ];

        setups.forEach(setup => {
            const checkbox = document.getElementById(setup.checkboxId);
            const container = document.getElementById(setup.targetId);

            if (checkbox && container) {
                // Function to toggle visibility classes
                const toggleVisibility = () => {
                    if (checkbox.checked) {
                        container.classList.remove('hidden');
                    } else {
                        container.classList.add('hidden');
                    }
                };

                // Listen for changes
                checkbox.addEventListener('change', toggleVisibility);
                
                // Run once on page load (in case form has validation errors validation back from POST)
                toggleVisibility();
            }
        });
    });
</script>
