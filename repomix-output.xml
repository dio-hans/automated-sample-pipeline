                            {{ item.product.blend.name }} · {{ item.product.pack_size.label }}
                        </td>
                        <!-- Form -->
                        <td class="px-6 py-4 font-medium text-slate-500 capitalize">
                            {{ item.product.get_form_display }}
                        </td>
                        <!-- Current Stock -->
                        <td class="px-6 py-4 text-right font-black text-rose-600 bg-rose-50/10">
                            {{ item.available }} Pcs
                        </td>
                        <!-- Reorder Point -->
                        <td class="px-6 py-4 text-right font-medium text-slate-400">
                            {{ item.reorder_level|default:"10" }} Pcs
                        </td>
                        <!-- Status Badge -->
                        <td class="px-6 py-4 text-center whitespace-nowrap">
                            {% if item.available <= 0 %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-700 border border-rose-200 uppercase tracking-wider">Out of Stock</span>
                            {% else %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700 border border-amber-200 uppercase tracking-wider">Low Threshold</span>
                            {% endif %}
                        </td>
                        <!-- View button trigger -->
                        <td class="px-6 py-4 text-right whitespace-nowrap">
                            <a href="{% url 'packaging_run_create' %}" class="text-xs font-bold text-rust hover:text-rust-dark hover:underline">
