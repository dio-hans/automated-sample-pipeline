            {% if f.is_converted_to_contract %}<span class="px-2 py-1 rounded-full text-xs bg-olive/10 text-olive">Yes</span>{% else %}<span class="px-2 py-1 rounded-full text-xs bg-gold/10 text-gold">Pending</span>{% endif %}
          </td>
          <td class="px-4 py-3"><a href__="{% url 'followup_detail' f.pk %}" class="text-olive hover:underline">Manage</a></td>
        </tr>
        {% empty %}
        <tr><td colspan="7" class="text-center py-12 text-gray-500">No follow-ups yet.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
</file>

<file path="web/templates/pipeline/pack_return_approval_list.html">
{% extends "pipeline/base.html" %}
{% load humanize %}

{% block title %}Return Approvals | Nonda{% endblock %}
{% block breadcrumb %}Inventory / Return Approvals{% endblock %}
{% block page_title %}Store Return Approvals{% endblock %}

{% block page_subtitle %}
<p class="mt-0.5 text-xs text-slate-500">
    Verify the physical crate items before the approved return affects warehouse stock levels or the account ledger.
</p>
{% endblock %}

{% block content %}
<div class="max-w-5xl mx-auto space-y-5">
    
    <!-- Top Context Ribbon Header Control Layout (Sticky Alignment) -->
    <div class="flex items-center justify-between border-b border-slate-200 pb-4 select-none">
        <span class="bg-slate-900 text-white font-mono text-[10px] font-bold px-2.5 py-1 rounded-md tracking-wider">
            {{ pending_returns|length }} PENDING RETURN{{ pending_returns|length|pluralize|upper }}
        </span>
    </div>

    <!-- Active List Items Main Operational Responsive Grid Queue -->

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-2">
    {% for item in pending_returns %}
    <div class="bg-white border border-slate-200 rounded-md px-3 py-2.5">

        <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-semibold text-slate-700">
                Return #{{ item.pk }}
            </span>
            <span class="text-[10px] text-slate-400 whitespace-nowrap">
                {{ item.returned_at|date:"d M, H:i" }}
            </span>
        </div>

        <div class="mt-1.5">
            <p class="text-sm font-medium text-slate-800 truncate"
               title="{{ item.release.product.blend.name }}">
                {{ item.release.product.blend.name }}
            </p>
            <p class="text-[11px] text-slate-500">
                {{ item.release.product.pack_size.label }}
                · Order #{{ item.release.request_item.request.short_number }}
            </p>
        </div>

        <div class="flex items-center justify-between mt-2">
            <span class="text-xs font-semibold text-slate-700">
                {{ item.packs_returned }} packs
            </span>

            <span class="text-[10px] font-medium
                {% if item.condition == 'good' %}
                    text-emerald-700
                {% else %}
                    text-rose-600
                {% endif %}">
                {{ item.condition|cut:"_"|title }}
            </span>
        </div>

        <div class="flex items-center justify-between gap-2 mt-2 pt-2 border-t border-slate-100">
            <span class="text-[10px] text-slate-400 truncate"
                  title="{{ item.submitted_by|default:item.received_by }}">
                {{ item.submitted_by|default:item.received_by|default:"Unknown" }}
            </span>

            <div class="flex gap-1.5 shrink-0">
                <form method="post"
                      action="{% url 'pack_return_approve' item.pk %}"
                      onsubmit="return confirm('Reject this return?');">
                    {% csrf_token %}
                    <input type="hidden" name="action" value="reject">
                    <button type="submit"
                            class="px-2 py-1 text-[11px] font-medium text-slate-600 border border-slate-200 rounded hover:bg-slate-50">
                        Reject
                    </button>
                </form>

                <form method="post"
                      action="{% url 'pack_return_approve' item.pk %}"
                      onsubmit="return confirm('Approve this return?');">
                    {% csrf_token %}
                    <input type="hidden" name="action" value="approve">
                    <button type="submit"
                            class="px-2 py-1 text-[11px] font-medium text-white bg-orange-600 rounded hover:bg-orange-700">
                        Approve
                    </button>
                </form>
            </div>
        </div>

    </div>
    {% empty %}
    <div class="col-span-full bg-white border border-slate-200 rounded-md p-5 text-center">
        <p class="text-sm text-slate-600">No pending returns.</p>
    </div>
    {% endfor %}
</div>

</div>
{% endblock %}
</file>

