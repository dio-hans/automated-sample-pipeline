<file path="web/templates/pipeline/packaged_product_form.html">
{% extends "pipeline/base.html" %}

{% block title %}Create Packaged Product | Nonda{% endblock %}
{% block breadcrumb %}Inventory / Packaged Coffee / New Product{% endblock %}

{% block content %}

    <form method="POST" autocomplete="off" class="space-y-3">
        {% csrf_token %}

        {% if form.errors %}
        <div class="p-2 rounded bg-red-50 border border-red-200 text-xs text-red-600 font-medium">
            Please resolve the form errors below before saving.
        </div>
        {% endif %}

        <!-- Blend Selection Input -->
        <div class="bg-slate-50/60 p-2.5 rounded border border-[#E4DECB]">
            <div class="max-w-md">
                <label class="block text-xs font-semibold text-slate-700 mb-1">
                    {{ form.blend_input.label }}
                </label>
                {{ form.blend_input }}
                <datalist id="blend-list">
                    {% for b in form.existing_blends %}
                        <option value="{{ b.name }}"></option>
                    {% endfor %}
                </datalist>
                {% if form.blend_input.errors %}
                    <p class="text-red-500 text-[11px] mt-0.5">{{ form.blend_input.errors.0 }}</p>
                {% endif %}
            </div>
        </div>

        <!-- Compact Matrix Table -->
        <div class="border border-[#E4DECB] rounded overflow-hidden">
            <table class="w-full text-left border-collapse bg-white text-xs">
                <thead>
                    <tr class="bg-slate-100/80 border-b border-[#E4DECB] text-slate-600 font-semibold">
                        <th class="py-1.5 px-3 w-1/4">Pack Size</th>
                        <th class="py-1.5 px-3 w-16 text-center">Enable</th>
                        <th class="py-1.5 px-3 w-1/3">Whole Beans Price (UGX)</th>
                        <th class="py-1.5 px-3 w-1/3">Ground Coffee Price (UGX)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E4DECB]">
                    <!-- Sachet -->
                    <tr class="hover:bg-slate-50/60 size-row" data-size-key="sachet">
                        <td class="py-1 px-3 font-medium text-slate-900">Sachet (15g)</td>
                        <td class="py-1 px-3 text-center">{{ form.size_sachet }}</td>
                        <td class="py-1 px-3">{{ form.price_sachet_beans }}</td>
                        <td class="py-1 px-3"><span class="text-[11px] text-slate-400 italic">Beans only</span></td>
                    </tr>
                    <!-- 50g -->
                    <tr class="hover:bg-slate-50/60 size-row" data-size-key="50g">
                        <td class="py-1 px-3 font-medium text-slate-900">50g</td>
                        <td class="py-1 px-3 text-center">{{ form.size_50g }}</td>
                        <td class="py-1 px-3">{{ form.price_50g_beans }}</td>
                        <td class="py-1 px-3">{{ form.price_50g_ground }}</td>
                    </tr>
                    <!-- 250g -->
                    <tr class="hover:bg-slate-50/60 size-row" data-size-key="250g">
                        <td class="py-1 px-3 font-medium text-slate-900">250g</td>
                        <td class="py-1 px-3 text-center">{{ form.size_250g }}</td>
                        <td class="py-1 px-3">{{ form.price_250g_beans }}</td>
                        <td class="py-1 px-3">{{ form.price_250g_ground }}</td>
                    </tr>
                    <!-- 500g -->
                    <tr class="hover:bg-slate-50/60 size-row" data-size-key="500g">
                        <td class="py-1 px-3 font-medium text-slate-900">500g</td>
                        <td class="py-1 px-3 text-center">{{ form.size_500g }}</td>
                        <td class="py-1 px-3">{{ form.price_500g_beans }}</td>
                        <td class="py-1 px-3">{{ form.price_500g_ground }}</td>
                    </tr>
                    <!-- 1kg -->
                    <tr class="hover:bg-slate-50/60 size-row" data-size-key="1kg">
                        <td class="py-1 px-3 font-medium text-slate-900">1kg</td>
                        <td class="py-1 px-3 text-center">{{ form.size_1kg }}</td>
                        <td class="py-1 px-3">{{ form.price_1kg_beans }}</td>
                        <td class="py-1 px-3">{{ form.price_1kg_ground }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Action Buttons -->
        <div class="flex justify-end items-center gap-2 pt-2 border-t border-[#E4DECB]">
            <a href="{% url 'packaged_inventory_list' %}" class="px-3 py-1.5 text-xs font-medium text-slate-600 hover:text-slate-800 rounded border border-[#E4DECB]">
                Cancel
            </a>
            <button type="submit" class="px-4 py-1.5 bg-rust hover:bg-rust-dark text-white rounded text-xs font-semibold shadow-xs transition">
                Save Product
            </button>
        </div>
    </form>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const rows = document.querySelectorAll(".size-row");
    rows.forEach(row => {
        const checkbox = row.querySelector("input[type='checkbox']");
        const beanInput = row.querySelector("input[data-type='beans']");
        const groundInput = row.querySelector("input[data-type='ground']");

        function toggleInputs() {
            const active = checkbox.checked;
            if (beanInput) beanInput.disabled = !active;
            if (groundInput) groundInput.disabled = !active;
            if (!active) {
                if (beanInput) beanInput.value = '';
                if (groundInput) groundInput.value = '';
            }
        }
        if (checkbox) {
            checkbox.addEventListener("change", toggleInputs);
            toggleInputs();
        }
        if (beanInput && groundInput) {
            beanInput.addEventListener("input", function () {
                if (!groundInput.value) groundInput.value = beanInput.value;
            });
        }
    });
});
</script>
{% endblock %}
</file>

<file path="web/templates/pipeline/record_payment_form.html">
{% extends "pipeline/base.html" %}
{% load static humanize %}

{% block title %}Record Payment | Nonda{% endblock %}
{% block breadcrumb %}Accounts / Receive Payment{% endblock %}
{% block page_title %}Record Cashier Collection{% endblock %}
{% block page_subtitle %}
<p class="mt-0.5 text-xs text-slate-500">
    Record a partial or full payment installment received against this active distribution account.
</p>
{% endblock %}

{% block header_action %}
<a href="{% url 'credit_control_ledger' %}"
   class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-slate-200 bg-white text-slate-700 text-xs font-semibold hover:bg-slate-50 transition shadow-sm">
    View Credit Ledger
</a>
{% endblock %}

{% block content %}
<div class="max-w-lg mx-auto">
    <div class="bg-white rounded-xl shadow-2xl overflow-hidden border border-slate-200 text-left flex flex-col">
        
        <!-- Dark Header Bar -->
        <div class="bg-slate-950 text-white px-4 py-2.5 flex items-center justify-between border-b border-slate-800 shrink-0">
            <div>
                <span class="text-[9px] font-mono tracking-wider text-emerald-400 font-bold uppercase block">
                    RELEASE #{{ release.pk }}
                </span>
                <h3 class="text-xs font-bold text-white">Record Order Settlement</h3>
            </div>
        </div>

        <!-- Body Container -->
        <div class="p-4 space-y-3">
            
            <!-- Customer & Financial Summary -->
            <div class="bg-slate-50 border border-slate-200/80 rounded-lg p-2.5 grid grid-cols-2 gap-2 text-xs">
                <div>
                    <span class="text-[9px] uppercase font-bold text-slate-400 tracking-wider block">Account Holder</span>
                    <p class="text-xs font-bold text-slate-800 truncate">
                        {{ release.released_to.name|default:"Unassigned Account" }}
                    </p>
                </div>
                <div class="text-right">
                    <span class="text-[9px] uppercase font-bold text-slate-400 tracking-wider block">Outstanding Balance</span>
                    <p class="text-sm font-black text-rose-600 font-mono">UGX {{ release.outstanding_balance|intcomma|default:"0" }}</p>
                </div>
            </div>

            <!-- Allocated Products Payload -->
            <div class="space-y-1.5">
                <div class="flex items-center justify-between border-b border-slate-100 pb-1">
                    <h4 class="text-[9px] uppercase tracking-wider font-bold text-slate-500">
                        Allocated Products Payload
                    </h4>
                    <span class="text-[9px] text-slate-400 font-mono">1 item</span>
                </div>
                
                <div class="space-y-1">
                    <div class="bg-slate-50 border border-slate-200/60 rounded-md px-2.5 py-1.5 flex justify-between items-center text-xs">
                        <div class="flex items-center gap-2 truncate">
                            <div class="truncate">
                                <p class="font-bold text-slate-800 leading-tight truncate">
                                    {% if release.product.blend %}{{ release.product.blend.name }}{% else %}{{ release.product }}{% endif %}
                                </p>
                                <p class="text-[9px] text-slate-500 leading-tight">
                                    {% if release.product.pack_size %}{{ release.product.pack_size.label }}{% endif %}
                                    {% if release.product.get_form_display %} · {{ release.product.get_form_display }}{% endif %}
                                </p>
                            </div>
                        </div>
                        <div class="text-right shrink-0">
                            <p class="font-mono font-bold text-slate-700 text-xs">{{ release.packs_out }} pk</p>
                            <p class="text-[9px] font-mono text-slate-400">Bal: {{ release.outstanding_balance|intcomma|default:"0" }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Exact Payment Form Structure -->
            <form id="form_settlement_{{ release.pk }}" method="post" class="space-y-2 border-t border-slate-100 pt-2.5">
      
                {% csrf_token %}
                
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-[9px] uppercase font-bold text-slate-500 mb-0.5">
                            Amount Received (UGX)
                        </label>
                        <input type="number" 
                               name="amount" 
                               step="1" 
                               max="{{ release.outstanding_balance }}"
                               value="{{ release.outstanding_balance }}" 
                               required
                               class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 rounded-md px-2 py-1.5 text-xs font-mono font-bold text-slate-900">
                    </div>
                    <div>
                        <label class="block text-[9px] uppercase font-bold text-slate-500 mb-0.5">
                            Payment Method
                        </label>
                        <select name="payment_method" required class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 rounded-md px-2 py-1.5 text-xs font-semibold text-slate-800">
                            <option value="cash" selected>Cash Payment</option>
                            <option value="mobile_money">Mobile Money (MoMo)</option>
                            <option value="bank_transfer">Bank Wire Transfer</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                </div>
                
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-[9px] uppercase font-bold text-slate-500 mb-0.5">
                            Reference Hash / ID
                        </label>
                        <input type="text" 
                               name="payment_reference" 
                               placeholder="e.g. MM Txn ID"
                               class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 rounded-md px-2 py-1 text-xs text-slate-800">
                    </div>
                    <div>
                        <label class="block text-[9px] uppercase font-bold text-slate-500 mb-0.5">
                            Audit Comments
                        </label>
                        <input type="text"
                               name="notes" 
                               placeholder="Optional comments..."
                               class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 rounded-md px-2 py-1 text-xs text-slate-800">
                    </div>
                </div>
            </form>

        </div>

        <!-- Modal Footer Actions Bar -->
        <div class="bg-slate-50 px-4 py-2.5 border-t border-slate-200 flex items-center justify-between gap-3 shrink-0">
            <a href="{% url 'credit_control_ledger' %}" class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-md text-[11px] font-bold transition-all cursor-pointer">
                Cancel
            </a>
            <button type="submit" form="form_settlement_{{ release.pk }}" class="px-4 py-1.5 bg-orange-500 hover:bg-orange-600 text-white rounded-md text-[11px] font-bold transition-all shadow-xs cursor-pointer">
                Post & Clear Payment
            </button>
        </div>

    </div>
</div>
{% endblock %}
</file>

