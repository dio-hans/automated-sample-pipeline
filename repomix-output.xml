                        {{ form.notes.errors.0 }}
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Active Checkbox -->
        <div class="flex items-center gap-2 pt-0.5">
            {{ form.is_active }}
            <label for="{{ form.is_active.id_for_label }}" class="text-[11px] font-semibold text-slate-700 cursor-pointer">
                Account Active
            </label>
            {% if form.is_active.errors %}
                <span class="text-rose-600 text-[10px] font-semibold ml-2">
                    {{ form.is_active.errors.0 }}
                </span>
            {% endif %}
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
            <a href="{% url 'account_holder_list' %}" class="px-3 py-1 border border-slate-200 text-slate-600 font-bold text-xs rounded-lg hover:bg-slate-50 transition">
                Cancel
            </a>
            <button type="submit" class="px-3.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-lg shadow-sm transition">
                Save Account Holder
            </button>
        </div>
    </form>
</div>
{% endblock %}
</file>

