            </p>

            <p class="mt-0.5 text-lg font-semibold text-rust">
                {{ outstanding|floatformat:0|intcomma }}
            </p>
        </div>

    </section>

    <!-- INVENTORY -->
    <section class="rounded-lg border border-line bg-white shadow-sm overflow-hidden">

        <div class="border-b border-line px-3 py-2.5">

            <h2 class="text-sm font-semibold text-slate-800">
