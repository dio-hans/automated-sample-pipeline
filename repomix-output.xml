                                    Roasted
                                </span>
                            {% elif run.source_stage == "ground" %}
                                <span class="inline-flex px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-orange-50 text-orange-700 border border-orange-200">
                                    Ground
                                </span>
                            {% else %}
                                <span class="inline-flex px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-600 border border-slate-200">
                                    {{ run.get_source_stage_display|default:run.source_stage|title }}
                                </span>
                            {% endif %}
                        </td>
                        
                        <td class="px-6 py-4 text-right text-slate-500 font-mono">
                            {{ run.input_kg|floatformat:2 }} kg
                        </td>
                        
                        <td class="px-6 py-4 text-right font-bold text-slate-900 font-mono">
                            {{ run.packs_produced }}
                        </td>
                        
                        <td class="px-6 py-4 text-right text-amber-700 font-medium font-mono">
                            {{ run.loss_kg|floatformat:2 }} kg
                        </td>
                        
                        <td class="px-6 py-4 text-center">
                            <a href="{% url 'packaging_run_detail' run.pk %}"
                               class="inline-flex items-center px-3 py-1.5 bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-lg font-semibold text-xs shadow-xs transition">
                                View Details
                            </a>
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="7" class="px-6 py-10 text-center text-slate-400 italic">
                            No packaging runs recorded for this selected time period.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
</file>

<file path="web/templates/pipeline/stock_request_fulfill.html">
{% extends "pipeline/base.html" %}
{% load static %}

{% block title %}Fulfil Request {{ stock_request.short_number }} | Nonda{% endblock %}
{% block breadcrumb %}Stock Control / Requests / Fulfil{% endblock %}
{% block page_title %}Fulfil Request {{ stock_request.short_number }}{% endblock %}

{% block page_subtitle %}
<p class="mt-1 text-sm text-slate-500">Dispatch requested quantities. Items set to zero or left underfilled will remain open as partial delivery balances.</p>
{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto">

    <form method="post" autocomplete="off">
        {% csrf_token %}
        {{ formset.management_form }}
        {{ bulk_formset.management_form }}

        {% if formset.non_form_errors %}
            <div class="mb-5 p-4 rounded-xl bg-rust/5 border border-rust/20 text-sm text-rust font-medium">
                {{ formset.non_form_errors }}
            </div>
        {% endif %}

        <div class="bg-white border border-[#E4DECB] rounded-xl overflow-hidden shadow-sm">

            <!-- Card Header Header -->
            <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
                <h2 class="text-sm font-semibold text-slate-800">
                    Issue Packaged Stock
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">
                    Enter the quantity actually handed out and the price attached to this release action.
                </p>
            </div>

            <!-- Dynamic Formset Items Loop -->
            <div class="divide-y divide-slate-100">
                {% for form in formset %}
                    <div class="p-6">
                        {{ form.item_id }}

                        {% if form.non_field_errors %}
                            <div class="mb-4 p-3 rounded-lg bg-rust/5 border border-rust/20 text-xs text-rust font-medium">
                                {{ form.non_field_errors }}
                            </div>
                        {% endif %}

                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-end">

                            <!-- Col 1: Product Lot Descriptions (5 Columns) -->
                            <div class="lg:col-span-5 min-w-0">
                                <p class="text-[11px] uppercase font-bold tracking-wider text-slate-400 mb-1">
                                    Product Variant
                                </p>
                                <p class="font-bold text-slate-800 text-sm truncate">
                                    {% with item_id=form.item_id.value %}
                                        {% for item in stock_request.items.all %}
                                            {% if item.pk|stringformat:"s" == item_id|stringformat:"s" %}
                                                {{ item.product.blend.name }} · {{ item.product.pack_size.label }}
                                            {% endif %}
                                        {% endfor %}
                                    {% endwith %}
                                </p>
                                <p class="text-xs text-amber-600 font-semibold mt-1">
                                    {% with item_id=form.item_id.value %}
                                        {% for item in stock_request.items.all %}
                                            {% if item.pk|stringformat:"s" == item_id|stringformat:"s" %}
                                                {{ item.outstanding_quantity }} pack(s) remaining
                                            {% endif %}
                                        {% endfor %}
                                    {% endwith %}
                                </p>
                            </div>

                            <!-- Col 2: Issue Quantity field (2 Columns) -->
                            <div class="lg:col-span-2">
                                <label for="{{ form.issue_quantity.id_for_label }}" class="block text-xs font-semibold text-slate-600 mb-1.5">
                                    Issue Quantity
                                </label>
                                {{ form.issue_quantity }}
                                {% if form.issue_quantity.errors %}
                                    <p class="mt-1 text-xs text-rust font-medium">{{ form.issue_quantity.errors.0 }}</p>
                                {% endif %}
                            </div>

                            <!-- Col 3: Price per Pack field (2 Columns) -->
                            <div class="lg:col-span-2">
                                <label for="{{ form.selling_price.id_for_label }}" class="block text-xs font-semibold text-slate-600 mb-1.5">
                                    Price / Pack (UGX)
                                </label>
                                {{ form.selling_price }}
                                {% if form.selling_price.errors %}
                                    <p class="mt-1 text-xs text-rust font-medium">{{ form.selling_price.errors.0 }}</p>
                                {% endif %}
                            </div>

                            <!-- Col 4: Run Annotation Notes field (3 Columns) -->
                            <div class="lg:col-span-3">
                                <label for="{{ form.notes.id_for_label }}" class="block text-xs font-semibold text-slate-600 mb-1.5">
                                    Run Annotation Note
                                </label>
                                {{ form.notes }}
                                {% if form.notes.errors %}
                                    <p class="mt-1 text-xs text-rust font-medium">{{ form.notes.errors.0 }}</p>
                                {% endif %}
                            </div>

                        </div>
                    </div>
                {% empty %}
                    <div class="px-6 py-12 text-center text-xs text-slate-400 italic bg-white">
                        There are no active items left available for fulfilment on this request ticket.
                    </div>
                {% endfor %}
            </div>

            <div class="mt-6 bg-white border border-[#E4DECB] rounded-xl overflow-hidden shadow-sm">
                <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
                    <h2 class="text-sm font-semibold text-slate-800">Issue Bulk Coffee (kg)</h2>
                    <p class="text-xs text-slate-500 mt-1">Available stock is rechecked against the stage ledger at dispatch.</p>
                </div>
                <div class="divide-y divide-slate-100">
                    {% for bulk_form in bulk_formset %}
                        <div class="p-6">
                            {{ bulk_form.item_id }}
                            {% if bulk_form.non_field_errors %}
                                <div class="mb-3 text-xs text-rose-600">{{ bulk_form.non_field_errors }}</div>
                            {% endif %}
                            {% with item_id=bulk_form.item_id.value %}
                                {% for item in stock_request.bulk_items.all %}
                                    {% if item.pk|stringformat:"s" == item_id|stringformat:"s" %}
                                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-end">
                                            <div class="lg:col-span-5">
                                                <p class="text-sm font-bold text-slate-800">{{ item.stock.batch_number }} · {{ item.stock.variety.name }}</p>
                                                <p class="text-xs text-slate-500">{{ item.get_stage_display }} · {{ item.outstanding_quantity }} kg remaining</p>
                                                <p class="text-[11px] text-slate-400">Requested deal price: UGX {{ item.price_per_kg|floatformat:2 }} / kg</p>
                                            </div>
                                            <div class="lg:col-span-3">
                                                <label for="{{ bulk_form.issue_quantity.id_for_label }}" class="block text-xs font-semibold text-slate-600 mb-1.5">Issue Quantity (kg)</label>
                                                {{ bulk_form.issue_quantity }}
                                                {% if bulk_form.issue_quantity.errors %}<p class="mt-1 text-xs text-rose-600">{{ bulk_form.issue_quantity.errors.0 }}</p>{% endif %}
                                            </div>
                                            <div class="lg:col-span-4">
                                                <label for="{{ bulk_form.price_per_kg.id_for_label }}" class="block text-xs font-semibold text-slate-600 mb-1.5">Confirmed Price / kg (UGX)</label>
                                                {{ bulk_form.price_per_kg }}
                                                {% if bulk_form.price_per_kg.errors %}<p class="mt-1 text-xs text-rose-600">{{ bulk_form.price_per_kg.errors.0 }}</p>{% endif %}
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            {% endwith %}
                        </div>
                    {% empty %}
                        <p class="p-6 text-xs text-slate-400 italic">No bulk coffee requested on this order.</p>
                    {% endfor %}
                </div>
            </div>

                <!-- CORE BUTTON CONTROLS FOOTER ROW -->
            <div class="px-6 py-4 bg-slate-50 border-t border-[#E4DECB] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                
                <!-- LEFT WALL PANEL: Completely isolated request denial trigger button -->
                <div>
                    <button type="submit" 
        form="global-cancel-form" 
        style="background-color: transparent !important; color: #475569 !important; border: 1px solid #cbd5e1 !important;"
        class="w-full sm:w-auto px-4 py-2 rounded-lg text-xs font-bold hover:!bg-rose-50 hover:!text-rose-700 hover:!border-rose-300 transition active:scale-95 shadow-2xs">
    Deny & Cancel Request
</button>
                </div>

                <!-- RIGHT WALL PANEL: Core operations flow buttons -->
                <div class="flex items-center justify-end gap-3 w-full sm:w-auto">
                    <a href="{% url 'stock_request_detail' stock_request.pk %}"
                       class="w-full sm:w-auto text-center px-4 py-2 border border-[#E4DECB] hover:bg-white bg-slate-50 rounded-lg text-xs font-semibold text-slate-600 transition">
                        Back to Details
                    </a>
                    <button type="submit"
                            class="w-full sm:w-auto px-5 py-2 bg-rust hover:bg-rust-dark text-white rounded-lg text-xs font-bold shadow-sm transition active:scale-95">
                        Release Verified Stock
                    </button>
                </div>

            </div>

        </div>
    </form>

    <!-- SECONDARY ISOLATED METHOD CAPTURE FORM: Fires completely independently -->
    <form id="global-cancel-form" method="POST" action="{% url 'stock_request_cancel' stock_request.pk %}" class="hidden" onsubmit="return confirm('Are you sure you want to completely deny and cancel this stock request ticket? This cannot be undone.');">
        {% csrf_token %}
    </form>

</div>
{% endblock %}
</file>

<file path="web/templates/pipeline/inventory_dashboard.html">
{% extends "pipeline/base.html" %}
{% block title %}Inventory Dashboard | Nonda{% endblock %}
{% block breadcrumb %}Inventory / Dashboard{% endblock %}
