                </a>

                <button type="submit"
                        class="px-5 py-2.5 text-sm font-semibold rounded-md bg-rust text-white hover:bg-rust-dark transition">
                    {% if object %}
                        Save Changes
                    {% else %}
                        Add Stock
                    {% endif %}
                </button>

            </div>

        </form>

    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {

    const varietyInput = document.getElementById('{{ form.variety_name.id_for_label }}');
    const hint = document.getElementById('variety_hint');

    if (!varietyInput) return;

    const fieldByDataset = {
        coffeeType: '{{ form.coffee_type.id_for_label }}',
        grade: '{{ form.grade.id_for_label }}',
        source: '{{ form.source.id_for_label }}',
        process: '{{ form.process.id_for_label }}',
        foreignSmell: '{{ form.foreign_smell.id_for_label }}',
    };

    function matchedOption() {
        const typed = varietyInput.value.trim().toLowerCase();
        if (!typed) return null;

        return Array.from(
            document.querySelectorAll('#variety_list option')
        ).find(option => option.value.trim().toLowerCase() === typed) || null;
    }

    function applyVarietyDefaults() {
        const option = matchedOption();

        if (!option) {
            hint.classList.add('hidden');
            return;
        }

        // Only prefill fields the user has left empty, so a typed batch
        // detail is never overwritten by the master default.
        Object.entries(fieldByDataset).forEach(([key, fieldId]) => {
            const value = option.dataset[key];
            const field = document.getElementById(fieldId);

            if (!value || !field || field.value) return;

            field.value = value;
            field.dispatchEvent(new Event('change', { bubbles: true }));
        });

        hint.textContent =
            'Existing coffee â€” this intake restocks "' + option.value + '".';
        hint.classList.remove('hidden');
    }

    varietyInput.addEventListener('input', applyVarietyDefaults);
    varietyInput.addEventListener('change', applyVarietyDefaults);

    applyVarietyDefaults();
});

document.addEventListener('DOMContentLoaded', function () {
    // 1. Grab input references
    const qtyReceivedInput = document.getElementById('{{ form.quantity_received.id_for_label }}');
    const defectsInput = document.getElementById('{{ form.defects.id_for_label }}');
    const qtyAfterSortingInput = document.getElementById('{{ form.quantity_after_sorting.id_for_label }}');

    function calculateAfterSorting() {
        if (!qtyAfterSortingInput) return;

        // Parse current numeric values (default to 0 if empty or invalid)
        const qtyReceived = parseFloat(qtyReceivedInput ? qtyReceivedInput.value : 0) || 0;
        const defects = parseFloat(defectsInput ? defectsInput.value : 0) || 0;

        // Compute net quantity (prevent negative numbers)
        const netAfterSorting = Math.max(0, qtyReceived - defects);

        // Update the target input field formatted to 2 decimal places
        qtyAfterSortingInput.value = netAfterSorting.toFixed(2);
    }

    // 2. Attach event listeners for real-time input updates
    if (qtyReceivedInput) {
        qtyReceivedInput.addEventListener('input', calculateAfterSorting);
    }
    if (defectsInput) {
        defectsInput.addEventListener('input', calculateAfterSorting);
    }
});
</script>
{% endblock %}



