          <th class="px-4 py-3">Coffee</th>
          <th class="px-4 py-3">Sent</th>
          <th class="px-4 py-3">Guide sent</th>
          <th class="px-4 py-3">Contract prompt</th>
          <th class="px-4 py-3 text-center">Converted</th>
          <th class="px-4 py-3">Actions</th>
