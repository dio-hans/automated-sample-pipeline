@login_required
def account_holder_detail(request, pk):
    account = get_object_or_404(AccountHolder, pk=pk)

    payment_roles = (
        User.Role.CASHIER,
        User.Role.ACCOUNTS,
        User.Role.MANAGER,
        User.Role.ADMIN,
    )

    can_collect_payment = (
        request.user.is_superuser
        or getattr(request.user, "role", None) in payment_roles
    )

    # --------------------------------------------------
    # RECORD AN ACCOUNT-LEVEL PAYMENT
    # --------------------------------------------------
    if request.method == "POST":
        if request.POST.get("action") != "record_account_payment":
            messages.error(request, "Invalid account action.")
            return redirect(request.get_full_path())

        if not can_collect_payment:
            messages.error(
                request,
                "You do not have permission to record account payments.",
            )
            return redirect(request.get_full_path())

        try:
            amount = Decimal(request.POST.get("amount", "").strip())

            method = request.POST.get("method", "").strip()
            payment_reference = request.POST.get(
                "payment_reference", ""
            ).strip()
            notes = request.POST.get("notes", "").strip()

            if not amount.is_finite() or amount <= Decimal("0.00"):
                raise ValidationError(
                    "Enter a payment amount greater than zero."
                )

            with transaction.atomic():
                # Lock this account's releases while allocating the payment.
                account_releases = list(
                    PackRelease.objects
                    .select_for_update()
                    .filter(released_to=account)
                    .prefetch_related(
                        "settlements",
                        "payments",
                        "returns",
                    )
                    .order_by("released_at", "pk")
                )
                account_bulk_sales = list(
                    CoffeeBatchSale.objects
                    .select_for_update()
                    .filter(account_holder=account)
                    .prefetch_related("payments")
                    .order_by("sold_at", "pk")
                )

                debts = [
                    (release.released_at, "release", release, release.outstanding_balance)
                    for release in account_releases
                    if release.outstanding_balance > Decimal("0.00")
                ] + [
                    (sale.sold_at, "bulk_sale", sale, sale.outstanding_balance)
                    for sale in account_bulk_sales
                    if sale.outstanding_balance > Decimal("0.00")
                ]
                debts.sort(key=lambda item: (item[0], item[2].pk))

                total_due = sum(
                    (balance for _, _, _, balance in debts),
                    Decimal("0.00"),
                )

                if total_due <= Decimal("0.00"):
                    raise ValidationError(
                        "This account has no outstanding debt to collect."
                    )

                if amount > total_due:
                    raise ValidationError(
                        f"Payment exceeds the account's outstanding "
                        f"balance of UGX {total_due:,.2f}."
                    )

                remaining = amount

                # Allocate oldest outstanding debt first.
                for _, sale_type, sale, balance in debts:
                    if remaining <= Decimal("0.00"):
                        break

                    allocation = min(balance, remaining)

                    if allocation <= Decimal("0.00"):
                        continue

                    payment_args = {
                        "amount": allocation,
                        "method": method,
                        "payment_reference": payment_reference,
                        "collected_by": request.user,
                        "notes": notes,
                    }
                    if sale_type == "release":
                        record_installment_payment(release=sale, **payment_args)
                    else:
                        record_bulk_sale_payment(bulk_sale=sale, **payment_args)

                    remaining -= allocation

            messages.success(
                request,
                f"Payment of UGX {amount:,.2f} recorded successfully "
                f"for {account.name}.",
            )

        except (InvalidOperation, AttributeError):
            messages.error(
                request,
                "Enter a valid payment amount.",
            )

        except ValidationError as exc:
            error_message = (
                "; ".join(exc.messages)
                if hasattr(exc, "messages")
                else str(exc)
            )
            messages.error(request, error_message)

        return redirect(request.get_full_path())

    # --------------------------------------------------
    # ALL ACCOUNT RELEASES
    # --------------------------------------------------
    all_releases_qs = (
        PackRelease.objects
        .filter(released_to=account)
        .select_related(
            "product__blend",
            "product__pack_size",
        )
        .prefetch_related(
            "settlements",
            "payments",
            "returns",
        )
        .order_by("-released_at")
    )

    # Apply the selected date filter to the table only.
    releases, preset, today, start, end = apply_date_filters(
        request,
        all_releases_qs,
        date_field="released_at",
    )

    all_releases = list(all_releases_qs)
    all_bulk_sales_qs = (
        CoffeeBatchSale.objects
        .filter(account_holder=account)
        .select_related("stock__variety", "bulk_request_item__request", "created_by")
        .prefetch_related("payments")
        .order_by("-sold_at", "-pk")
    )
    bulk_sales, _, _, _, _ = apply_date_filters(
        request,
        all_bulk_sales_qs,
        date_field="sold_at",
    )
    all_bulk_sales = list(all_bulk_sales_qs)

    # Lifetime account figures, not just the selected date range.
    total_value = sum(
        (release.gross_amount for release in all_releases),
        Decimal("0.00"),
    ) + sum((sale.total_amount_due for sale in all_bulk_sales), Decimal("0.00"))

    total_paid = sum(
        (release.total_amount_paid for release in all_releases),
        Decimal("0.00"),
    ) + sum((sale.total_amount_paid for sale in all_bulk_sales), Decimal("0.00"))

    total_outstanding = sum(
        (release.outstanding_balance for release in all_releases),
        Decimal("0.00"),
    ) + sum((sale.outstanding_balance for sale in all_bulk_sales), Decimal("0.00"))

    labels = {
        "today": "Today",
        "yesterday": "Yesterday",
        "this_week": "This Week",
        "last_7_days": "Last 7 Days",
        "this_month": "This Month",
        "overall": "All Time",
    }

    if preset == "custom" and start and end:
        range_label = (
            f"{start.strftime('%d %b %Y')} – "
            f"{end.strftime('%d %b %Y')}"
        )
    else:
        range_label = labels.get(preset, "All Time")

    context = {
        "account": account,
        "releases": releases,
        "bulk_sales": bulk_sales,
        "total_value": total_value,
        "total_paid": total_paid,
        "total_outstanding": total_outstanding,
        "preset": preset,
        "period": {
            "start_date": start,
            "end_date": end,
        },
        "selected_range_label": range_label,
        "can_collect_payment": can_collect_payment,
        "payment_methods": PaymentReceipt._meta.get_field(
            "payment_method"
        ).choices,
            }

    return render(
        request,
        "pipeline/account_holder_detail.html",
        context,
    )

