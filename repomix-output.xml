                All consignment stock belongs to a physical branch.
            </p>

        </div>

        <div class="grid grid-cols-1 gap-3 p-3 md:grid-cols-2">

            {% for field in form %}

                {% if field.name == "branch_name" or field.name == "branch_address" or field.name == "branch_contact_person" or field.name == "branch_phone" %}

                <div>

                    <label
                        for="{{ field.id_for_label }}"
                        class="mb-1 block text-[11px] font-semibold text-slate-600"
                    >
                        {{ field.label }}
                    </label>

                    {{ field }}

                    {% for error in field.errors %}
                    <p class="mt-1 text-[10px] text-rose-600">
                        {{ error }}
                    </p>
                    {% endfor %}

                </div>

                {% endif %}

            {% endfor %}

        </div>

    </section>


    <div class="flex justify-end gap-2">

        <a
            href="{% url 'consignment_list' %}"
            class="inline-flex h-8 items-center rounded-md
                   border border-line bg-white px-3
                   text-xs font-medium text-slate-600"
