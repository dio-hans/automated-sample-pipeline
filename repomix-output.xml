                {% for entry in top_products %}
                <div class="px-4 py-2 flex items-center justify-between hover:bg-slate-50/50 transition-colors">
                    <div>
                        <p class="font-semibold text-slate-800">{{ entry.product.blend.name }} &middot; {{ entry.product.pack_size.label }}</p>
