                        <td class="px-6 py-4 whitespace-nowrap">
                            <a href="{% url 'stock_detail' stock.pk %}" class="font-mono font-bold text-rust hover:underline">
                                {{ stock.batch_number }}
                            </a>
                        </td>
                        <!-- Variety -->
                        <td class="px-6 py-4 font-semibold text-slate-800">
                            {{ stock.variety.name }}
                        </td>
                        <!-- Weight -->
                        <td class="px-6 py-4 text-right font-bold text-slate-800">
                            {{ stock.quantity_available|floatformat:1 }} <span class="text-[10px] text-slate-400 font-normal">Kg</span>
                        </td>
                        <!-- Threshold -->
                        <td class="px-6 py-4 text-right font-medium text-slate-400">
                            {{ stock.reorder_level|floatformat:1 }} <span class="text-[10px] text-slate-400 font-normal">Kg</span>
                        </td>
                        <!-- Status Badge -->
                        <td class="px-6 py-4 text-center whitespace-nowrap">
                            {% if stock.quantity_available <= 0 %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-700 border border-rose-200 uppercase tracking-wider">Depleted</span>
                            {% else %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700 border border-amber-200 uppercase tracking-wider">Low Mass</span>
                            {% endif %}
                        </td>
                        <!-- Action -->
                        <td class="px-6 py-4 text-right whitespace-nowrap">
                            <a href="{% url 'stock_detail' stock.pk %}" class="text-xs font-bold text-rust hover:text-rust-dark hover:underline">
                                Process Run →
                            </a>
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-slate-400 italic bg-white">
                            ✓ No bulk mass coffee batches are currently dropping below safety levels.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
</file>

