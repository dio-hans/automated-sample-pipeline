<file path="web/templates/reports/operations.html">
{% extends "pipeline/base.html" %}
{% load humanize %}

{% block title %}
Operations | Nonda
{% endblock %}

{% block breadcrumb %}
Management / Reports / Operations
{% endblock %}

{% block page_title %}
Operations Report
{% endblock %}

{% block page_subtitle %}
<p class="mt-1 text-sm text-slate-500">
    Processing performance and operational exceptions · {{ period_label }}
</p>
{% endblock %}


{% block header_action %}
<a
    href="{% url 'reports_operations_detail' %}?{{ request.GET.urlencode }}"
    class="px-3 py-2 rounded-lg border border-line
           bg-white text-[10px] font-semibold text-slate-700
           hover:bg-slate-50"
>
    Full Details
</a>
{% endblock %}


{% block content %}

<div class="space-y-3 text-xs text-gray-700 pb-4">


    <!-- =====================================================
         FILTER + KPI AREA
         ===================================================== -->
    <div class="space-y-1">

        {% include "reports/components/report_filters.html" %}


        <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">

            <!-- COMPLETED RUNS -->
            <div class="p-2.5 bg-white border border-gray-200
                        rounded-lg shadow-sm">

                <p class="text-[9px] font-bold
                          text-gray-400 uppercase tracking-wider">
                    Completed Runs
                </p>

                <p class="mt-1 text-base sm:text-lg
                          font-bold text-gray-900">
                    {{ processing.runs|intcomma }}

                    <span class="text-[9px] font-normal text-gray-400">
                        runs
                    </span>
                </p>

            </div>


            <!-- YIELD -->
            <div class="p-2.5 bg-white border border-gray-200
                        rounded-lg shadow-sm">

                <p class="text-[9px] font-bold
                          text-gray-400 uppercase tracking-wider">
                    Processing Yield
                </p>

                <p class="mt-1 text-base sm:text-lg
                          font-bold text-emerald-700">
                    {{ processing.yield_pct }}%
                </p>

            </div>


            <!-- LOSS -->
            <div class="p-2.5 bg-white border border-gray-200
                        rounded-lg shadow-sm">

                <p class="text-[9px] font-bold
                          text-gray-400 uppercase tracking-wider">
                    Processing Loss
                </p>

                <p class="mt-1 text-base sm:text-lg
                          font-bold text-amber-700">
                    {{ processing.loss_kg|floatformat:2|intcomma }}

                    <span class="text-[9px] font-normal text-gray-400">
                        kg
                    </span>
                </p>

            </div>


            <!-- PACKS -->
            <div class="p-2.5 bg-white border border-gray-200
                        rounded-lg shadow-sm">

                <p class="text-[9px] font-bold
                          text-gray-400 uppercase tracking-wider">
                    Packs Produced
                </p>

                <p class="mt-1 text-base sm:text-lg
                          font-bold text-gray-900">
                    {{ packaging.packs_produced|intcomma }}
                </p>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PROCESSING PERFORMANCE
         ===================================================== -->
    <section class="bg-white border border-gray-200
                    rounded-lg shadow-sm overflow-hidden">

        <div class="px-3 py-2
                    border-b border-gray-100
                    flex items-center justify-between gap-3">

            <div>

                <h2 class="text-[10px] font-bold
                           text-gray-800 uppercase tracking-wider">
                    Processing Performance
                </h2>

                <p class="text-[9px] text-gray-400 mt-0.5">
                    Input, output, loss and yield by operation.
                </p>

            </div>


            <a
                href="{% url 'reports_operations_detail' %}?{{ request.GET.urlencode }}"
                class="text-[9px] font-semibold text-olive
                       hover:underline whitespace-nowrap"
            >
                Inspect →
            </a>

        </div>


        <!-- MOBILE -->
        <div class="md:hidden divide-y divide-gray-100">

            {% for row in process_rows %}

                <div class="px-3 py-2">

                    <div class="flex items-center
