        self.fields["name"].widget.attrs.update({
            "placeholder": "e.g. Capital Shoppers",
        })

        self.fields["city"].widget.attrs.update({
            "placeholder": "e.g. Kampala",
        })

        self.fields["contact_person"].widget.attrs.update({
