<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const canvas = document.getElementById("stockConsumptionChart");

    if (!canvas) {
        return;
    }

    const labelsElement = document.getElementById("consumption-labels");
    const valuesElement = document.getElementById("consumption-values");

    if (!labelsElement || !valuesElement) {
        return;
    }

    const labels = JSON.parse(labelsElement.textContent);
    const values = JSON.parse(valuesElement.textContent);

    if (!values.length) {
        return;
    }

    new Chart(canvas, {
        type: "doughnut",

        data: {
            labels: labels,

            datasets: [{
                data: values,

                backgroundColor: [
                    "#556B2F",
                    "#B66A3C",
                    "#D9A441",
                    "#718096",
                    "#B45353",
                    "#5F7C8A",
                    "#8B6F47",
                    "#A0AEC0"
                ],

                borderWidth: 2,
                borderColor: "#ffffff",
                hoverOffset: 5
            }]
        },

        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: "65%",

            plugins: {

                legend: {
                    display: false
                },

                tooltip: {
                    callbacks: {

                        label: function (context) {

                            const total = context.dataset.data.reduce(
                                (sum, value) => sum + Number(value),
                                0
                            );

                            const value = Number(context.raw);

                            const percentage = total
                                ? ((value / total) * 100).toFixed(1)
                                : "0.0";

                            return (
                                context.label +
                                ": " +
                                value.toLocaleString() +
                                " kg (" +
                                percentage +
                                "%)"
                            );
                        }
                    }
                }
            }
        }
    });

});
</script>


