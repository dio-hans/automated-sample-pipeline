<file path="web/templates/pipeline/pack_return_form.html">
{% extends "pipeline/base.html" %}
{% load humanize %}

{% block title %}Prepare Return | Nonda{% endblock %}
{% block breadcrumb %}Sales / Orders / {{ order.short_number }} / Return{% endblock %}
{% block page_title %}Prepare Returned Stock{% endblock %}

{% block page_subtitle %}
<p class="mt-0.5 text-xs text-slate-500">
    Select only the products that physically came back in the warehouse crate, then set the exact quantity returned.
</p>
{% endblock %}

{% block content %}
<div class="max-w-5xl mx-auto flex flex-col gap-4">
    
    <!-- System Notification Banner Blocks -->
    {% if messages %}
        <div class="space-y-2 shrink-0">
            {% for message in messages %}
                <div class="p-3 rounded-xl text-xs font-semibold {% if message.tags == 'error' %}bg-rose-50 text-rose-700 border border-rose-200{% else %}bg-emerald-50 text-emerald-700 border border-emerald-200{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <!-- MASTER WORKSHEET LAYOUT CARD -->
    <div class="bg-white border border-slate-200 rounded-xl shadow-xs overflow-hidden flex flex-col max-h-[80vh]">
        
        <!-- Header Operational Identification Bar -->
        <div class="bg-slate-950 text-white px-4 py-3 flex flex-wrap justify-between items-center gap-2 shrink-0 border-b border-slate-800">
            <div>
                <span class="text-[9px] font-mono tracking-wider {% if stage == 'review' %}text-emerald-400{% else %}text-orange-400{% endif %} uppercase font-bold">
                    {% if stage == 'review' %}Stage 2 of 2: Confirm Allocation Summary{% else %}Stage 1 of 2: Worksheet Intake{% endif %}
                </span>
                <h2 class="text-xs font-bold text-slate-200 mt-0.5">Return Intake Worksheet · #{{ order.short_number }}</h2>
            </div>
            <div class="text-right text-xs">
                <span class="text-slate-400 text-[10px] font-medium block">Assigned Attendant</span>
                <span class="font-bold text-slate-200 text-xs">
                    {% if order.requested_by %}
                        {{ order.requested_by.get_full_name|default:order.requested_by.username }}
                    {% else %}
                        {{ order.account_holder|default:"Field Kiosk Representative" }}
                    {% endif %}
                </span>
            </div>
        </div>

        {% if stage == 'review' %}
        <!-- =========================================================
             STAGE 2: REVIEW & CONFIRMATION PREVIEW SCREEN
             ========================================================= -->
        <form method="post" class="flex flex-col flex-1 min-h-0">
            {% csrf_token %}
            <input type="hidden" name="stage" value="confirm">

            <div class="p-6 overflow-y-auto space-y-5">
                <div class="bg-amber-50/80 border border-amber-200/80 rounded-xl p-4 flex items-start gap-3">
                    
                    <div class="text-xs text-amber-950">
                        <p class="font-bold">Verify Staged Return Manifest</p>
                        <p class="mt-0.5 opacity-90">Submitting will forward this log for Store Manager or Store Cashier verification before stock balances and physical ledgers update.</p>
                    </div>
                </div>

                <div class="space-y-2">
                    <h4 class="text-[10px] uppercase tracking-wider font-bold text-slate-400">Items Staged for Inbound Intake</h4>
                    <div class="border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100">
                        {% for item in preview_items %}
                        <div class="p-3.5 grid grid-cols-12 gap-2 items-center bg-white text-xs">
                            <div class="col-span-6 flex items-center gap-3">
                              
                                <div>
                                    <p class="font-bold text-slate-800">{{ item.release.product.blend.name }}</p>
                                    <p class="text-[10px] text-slate-400 font-mono">{{ item.release.product.pack_size.label }} · {{ item.release.product.get_form_display }}</p>
                                </div>
                            </div>
                            <div class="col-span-3 text-center">
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Returning Value</span>
                                <span class="font-mono font-bold text-orange-600 text-sm">+{{ item.qty }} packs</span>
                            </div>
                            <div class="col-span-3 text-right">
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Condition</span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-semibold border {% if item.condition == 'good' %}bg-emerald-50 text-emerald-700 border-emerald-200{% else %}bg-rose-50 text-rose-700 border-rose-200{% endif %}">
                                    {{ item.condition|upper }}
                                </span>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label class="block text-[10px] uppercase font-bold text-slate-500">Intake Audit Notes</label>
                    <textarea name="final_notes" rows="2" placeholder="Record any crate observations, missing seal details, or condition references..." class="w-full bg-slate-50 border border-slate-300 focus:border-orange-500 focus:ring-1 focus:ring-orange-500 rounded-lg p-2.5 text-xs text-slate-800"></textarea>
                </div>
            </div>

            <!-- Footer Controls -->
            <div class="bg-slate-50 border-t border-slate-200/80 px-6 py-4 flex items-center justify-between shrink-0">
                <a href="{% url 'pack_return_form' order.pk %}" class="px-4 py-2 border border-slate-200 bg-white hover:bg-slate-50 text-xs font-bold text-slate-600 rounded-lg shadow-2xs transition-all">
                     Edit Selections
                </a>
                <button type="submit" class="px-5 py-2.5 bg-orange-500 hover:bg-orange-600 active:scale-[0.98] text-white rounded-lg text-xs font-bold shadow-sm transition-all cursor-pointer">
                    Submit Return for Store Verification 
                </button>
            </div>
        </form>

        {% else %}
        <!-- =========================================================
             STAGE 1: INTERACTIVE WORKSHEET INTAKE FORM
             ========================================================= -->
        <form method="post" class="flex flex-col flex-1 min-h-0">
            {% csrf_token %}
            <input type="hidden" name="stage" value="entry">

            <!-- Data Table Sheet Section -->
            <div class="flex-1 min-h-0 flex flex-col">
                <!-- Grid Table Headers Bar -->
                <div class="bg-slate-50 border-b border-slate-200 px-4 py-2.5 grid grid-cols-12 gap-2 text-[9px] uppercase font-bold text-slate-400 tracking-wider shrink-0 select-none">
                    <div class="col-span-1 text-center">Include</div>
                    <div class="col-span-5">Product Details</div>
                    <div class="col-span-2 text-center">Outstanding</div>
                    <div class="col-span-2 text-center">Quantity</div>
                    <div class="col-span-2 text-center">Condition</div>
                </div>

                <!-- Scrollable Body Table Zone -->
                <div class="overflow-y-auto divide-y divide-slate-100 max-h-[340px] bg-white min-h-0">
                    {% for release in active_releases %}
                    <div class="px-4 py-3 grid grid-cols-12 gap-2 items-center hover:bg-slate-50/40 transition-colors text-xs">
                        
                        <!-- Col 1: Include Checkbox Input -->
                        <div class="col-span-1 flex justify-center">
                            <input type="checkbox" 
                                   name="selected_items" 
                                   value="{{ release.id }}" 
                                   id="chk_{{ release.id }}" 
                                   onchange="toggleRowState('{{ release.id }}')" 
                                   class="w-4 h-4 rounded text-orange-500 border-slate-300 focus:ring-orange-500 cursor-pointer">
                        </div>

                        <!-- Col 2: Brand/Label Descriptions -->
                        <div class="col-span-5 pr-2">
                            <p class="font-bold text-slate-800 tracking-tight">{{ release.product.blend.name }}</p>
                            <p class="text-[10px] text-slate-400 font-mono mt-0.5">{{ release.product.pack_size.label }} · {{ release.product.get_form_display }}</p>
                        </div>

                        <!-- Col 3: Outstanding Bounds Counter -->
                        <div class="col-span-2 text-center font-mono font-bold text-slate-600">
                            {{ release.packs_outstanding }} packs
                        </div>

                        <!-- Col 4: Quantity Count Box Inputs Toggles -->
                        <div class="col-span-2 opacity-40 transition-opacity flex justify-center" id="wrapper_qty_{{ release.id }}">
                            <div class="w-24 relative flex items-center">
                                <button type="button" 
                                        onclick="stepCount('{{ release.id }}', -1, {{ release.packs_outstanding }})" 
                                        class="absolute left-1 text-slate-400 hover:text-slate-800 font-bold p-1 text-[10px] select-none shadow-2xs bg-white rounded border border-slate-200 cursor-pointer">-</button>
                                
                                <input type="number" 
                                       name="qty_{{ release.id }}" 
                                       id="num_{{ release.id }}"
                                       max="{{ release.packs_outstanding }}" 
                                       min="0" 
                                       value="0"
                                       disabled
                                       class="w-full text-center rounded-lg border border-slate-200 px-7 py-1 font-mono font-bold text-slate-900 text-xs bg-slate-50 focus:outline-none">
                                
                                <button type="button" 
                                        onclick="stepCount('{{ release.id }}', 1, {{ release.packs_outstanding }})" 
                                        class="absolute right-1 text-slate-400 hover:text-slate-800 font-bold p-1 text-[10px] select-none shadow-2xs bg-white rounded border border-slate-200 cursor-pointer">+</button>
                            </div>
                        </div>

                        <!-- Col 5: Condition Choice Selection Menu -->
                        <div class="col-span-2 opacity-40 transition-opacity" id="wrapper_cond_{{ release.id }}">
                            <select name="condition_{{ release.id }}" 
                                    id="cond_{{ release.id }}" 
                                    disabled 
                                    class="w-full rounded-lg border border-slate-200 px-2 py-1 text-[11px] font-semibold text-slate-700 bg-white focus:border-orange-500 focus:outline-none cursor-pointer">
                                <option value="good" selected>Good Condition</option>
                                <option value="damaged">Damaged Pack</option>
                                <option value="vip_gift">PR / VIP Gift</option>
                            </select>
                        </div>

                    </div>
                    {% empty %}
                    <div class="p-8 text-center text-xs text-slate-400 italic">
                        There are no outstanding coffee packages to return for this order.
                    </div>
                    {% endfor %}
                </div>
            </div>

            <!-- LOWER AUDIT METRICS SUMMARY BLOCK & SUBMISSION BAR -->
            <div class="bg-slate-50 border-t border-slate-200/80 px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 shrink-0">
                <div class="flex items-start gap-3 text-xs max-w-md">
                   
                    <div class="text-[11px] text-slate-500 leading-normal">
            
                    </div>
                </div>

                <div class="flex items-center gap-2.5 self-end sm:self-auto">
                    <a href="{% url 'order_queue' %}" class="px-4 py-2 border border-slate-200 bg-white hover:bg-slate-50 text-xs font-bold text-slate-600 rounded-lg shadow-2xs transition-all">
                        Cancel
                    </a>
                    <button type="submit" class="px-5 py-2.5 bg-orange-500 hover:bg-orange-600 active:scale-[0.98] text-white rounded-lg text-xs font-bold shadow-sm transition-all cursor-pointer">
                        Review & Confirm 
                    </button>
                </div>
            </div>
        </form>
        {% endif %}
    </div>
</div>

<!-- DYNAMIC ROW CONTROLS ENGINE -->
<script>
function toggleRowState(releaseId) {
    const chk = document.getElementById(`chk_${releaseId}`);
    const wrapQty = document.getElementById(`wrapper_qty_${releaseId}`);
    const wrapCond = document.getElementById(`wrapper_cond_${releaseId}`);
    const numInput = document.getElementById(`num_${releaseId}`);
    const condSelect = document.getElementById(`cond_${releaseId}`);

    if (chk && chk.checked) {
        wrapQty.classList.remove("opacity-40");
        wrapCond.classList.remove("opacity-40");
        numInput.removeAttribute("disabled");
        numInput.classList.remove("bg-slate-50");
        condSelect.removeAttribute("disabled");
        condSelect.classList.remove("bg-slate-50");
        if (parseInt(numInput.value) === 0) {
            numInput.value = 1; // Auto-increment to 1 when row is checked
        }
    } else if (chk) {
        wrapQty.classList.add("opacity-40");
        wrapCond.classList.add("opacity-40");
        numInput.setAttribute("disabled", "true");
        numInput.classList.add("bg-slate-50");
        condSelect.setAttribute("disabled", "true");
        condSelect.classList.add("bg-slate-50");
        numInput.value = 0;
    }
}

function stepCount(releaseId, amount, maxLimit) {
    const chk = document.getElementById(`chk_${releaseId}`);
    if (chk && !chk.checked) return;

    const input = document.getElementById(`num_${releaseId}`);
    let val = parseInt(input.value) || 0;
    val += amount;

    if (val < 1) val = 1;
    if (val > maxLimit) val = maxLimit;

    input.value = val;
}
</script>
{% endblock %}
</file>

<file path="web/templates/pipeline/stock_request_form.html">
{% extends "pipeline/base.html" %}
    
{% block title %}Request Stock | Nonda{% endblock %}
{% block breadcrumb %}Sales / Stock Request{% endblock %}
{% block page_title %}Request Coffee Stock{% endblock %}
{% block content %}
<form
    method="post"
    id="stock-request-form"
    autocomplete="off"
    class="space-y-3 pb-24"
>
    {% csrf_token %}
    {{ item_formset.management_form }}
    {{ bulk_formset.management_form }}
    
    <!-- GLOBAL ERRORS -->
    {% if form.non_field_errors or item_formset.non_form_errors or bulk_formset.non_form_errors %}
        <div class="rounded-lg border border-rust/20 bg-rust/5 px-4 py-3 text-sm text-rust">
            {{ form.non_field_errors }}
            {{ item_formset.non_form_errors }}
            {{ bulk_formset.non_form_errors }}
        </div>
    {% endif %}

    <!-- 1. REQUEST DETAILS -->
    <section class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
        <!-- SECTION HEADER -->
        <h2 class="text-[11px] font-bold uppercase tracking-wider text-slate-700 border-b border-slate-100 pb-1.5 mb-2.5">
            1. Request Details
        </h2>
        
        <!-- FORM GRID -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            {% for field in form %}
                {% if field.is_hidden %}
                    {{ field }}
                {% else %}
                    <div class="{% if field.name == 'account_holder' %}md:col-span-2{% endif %}">
                        <label for="{{ field.id_for_label }}" class="block text-[10px] uppercase tracking-wider font-bold text-slate-600 mb-1">
                            {{ field.label }}
                        </label>
                        <div class="[&_input]:w-full [&_input]:rounded-md [&_input]:border [&_input]:border-slate-200 [&_input]:px-2.5 [&_input]:py-1.5 [&_input]:text-xs [&_input]:text-slate-800 [&_input]:focus:outline-none [&_input]:focus:ring-2 [&_input]:focus:ring-rust [&_input]:focus:border-rust [&_select]:w-full [&_select]:rounded-md [&_select]:border [&_select]:border-slate-200 [&_select]:px-2.5 [&_select]:py-1.5 [&_select]:text-xs [&_select]:text-slate-800 [&_select]:focus:outline-none [&_select]:focus:ring-2 [&_select]:focus:ring-rust [&_select]:focus:border-rust [&_textarea]:w-full [&_textarea]:rounded-md [&_textarea]:border [&_textarea]:border-slate-200 [&_textarea]:px-2.5 [&_textarea]:py-1.5 [&_textarea]:text-xs [&_textarea]:text-slate-800 [&_textarea]:rows-2 [&_textarea]:focus:outline-none [&_textarea]:focus:ring-2 [&_textarea]:focus:ring-rust [&_textarea]:focus:border-rust">
                            {{ field }}
                        </div>
                        {% if field.errors %}
                            {% for error in field.errors %}
                                <p class="mt-1 text-[11px] text-rose-600 font-bold bg-rose-50 px-2 py-0.5 rounded border border-rose-100">
                                    {{ error }}
                                </p>
                            {% endfor %}
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </section>

    <!-- BULK STOCK REQUEST (MATCHED TO SECTION 1) -->
    <section class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
        <div class="flex flex-col gap-2 border-b border-slate-100 pb-2 mb-2.5 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h2 class="text-[11px] font-bold uppercase tracking-wider text-slate-700">
                    Bulk Stock Request
                </h2>
                <p class="text-[11px] text-slate-400">Add batches, quantities, coffee stages, and agreed prices per kilogram.</p>
            </div>
            <button type="button" id="add-bulk-line"
                    class="inline-flex items-center justify-center gap-1.5 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-emerald-100">
                <i class="fa-solid fa-plus text-[10px]" aria-hidden="true"></i>
                Add Another Item
            </button>
        </div>

        {% if bulk_formset.non_form_errors %}
            <div class="mb-2 rounded-md border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs text-rose-700">
                {{ bulk_formset.non_form_errors }}
            </div>
        {% endif %}

        <div class="overflow-x-auto">
            <table class="w-full min-w-[760px] text-xs">
                <thead>
                    <tr class="text-left text-[10px] font-bold uppercase tracking-wider text-slate-500">
                        <th class="w-[30%] px-1 pb-1">Batch <span class="text-rose-500">*</span></th>
                        <th class="w-[18%] px-1 pb-1">Quantity (kg) <span class="text-rose-500">*</span></th>
                        <th class="w-[24%] px-1 pb-1">Product Type <span class="text-rose-500">*</span></th>
                        <th class="w-[23%] px-1 pb-1">Price (UGX/kg) <span class="text-rose-500">*</span></th>
                        <th class="w-10 px-1 pb-1"><span class="sr-only">Remove line</span></th>
                    </tr>
                </thead>
                <tbody id="bulk-request-rows" class="divide-y divide-slate-100">
                    {% for bulk_form in bulk_formset %}
                        <tr class="bulk-request-row" data-bulk-row>
                            <td class="px-1 py-1 align-top">
                                {{ bulk_form.stock }}
                                {{ bulk_form.DELETE.as_hidden }}
                                {% if bulk_form.stock.errors %}<p class="mt-0.5 text-[10px] text-rose-600">{{ bulk_form.stock.errors.0 }}</p>{% endif %}
                            </td>
                            <td class="px-1 py-1 align-top">
                                {{ bulk_form.quantity_requested }}
                                {% if bulk_form.quantity_requested.errors %}<p class="mt-0.5 text-[10px] text-rose-600">{{ bulk_form.quantity_requested.errors.0 }}</p>{% endif %}
                            </td>
                            <td class="px-1 py-1 align-top">
                                {{ bulk_form.stage }}
                                {% if bulk_form.stage.errors %}<p class="mt-0.5 text-[10px] text-rose-600">{{ bulk_form.stage.errors.0 }}</p>{% endif %}
                            </td>
                            <td class="px-1 py-1 align-top">
                                {{ bulk_form.price_per_kg }}
                                {% if bulk_form.price_per_kg.errors %}<p class="mt-0.5 text-[10px] text-rose-600">{{ bulk_form.price_per_kg.errors.0 }}</p>{% endif %}
                            </td>
                            <td class="px-1 py-1 align-top text-center">
                                <button type="button" data-remove-bulk-line
                                        class="rounded p-1 text-slate-400 transition hover:text-rose-600"
                                        aria-label="Remove bulk request line">
                                    <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>
                        {% if bulk_form.non_form_errors %}
                            <tr><td colspan="5" class="px-1 pb-1 text-[10px] text-rose-600">{{ bulk_form.non_form_errors }}</td></tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
            <template id="bulk-request-row-template">
                <tr class="bulk-request-row" data-bulk-row>
                    <td class="px-1 py-1 align-top">{{ bulk_formset.empty_form.stock }}{{ bulk_formset.empty_form.DELETE.as_hidden }}</td>
                    <td class="px-1 py-1 align-top">{{ bulk_formset.empty_form.quantity_requested }}</td>
                    <td class="px-1 py-1 align-top">{{ bulk_formset.empty_form.stage }}</td>
                    <td class="px-1 py-1 align-top">{{ bulk_formset.empty_form.price_per_kg }}</td>
                    <td class="px-1 py-1 align-top text-center">
                        <button type="button" data-remove-bulk-line
                                class="rounded p-1 text-slate-400 transition hover:text-rose-600"
                                aria-label="Remove bulk request line">
                            <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                        </button>
                    </td>
                </tr>
            </template>
        </div>
    </section>

    <!-- 2. ERP WORKSPACE -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
        <!-- PRODUCT CATALOG -->
        <section
            class="lg:col-span-7 bg-white border border-slate-200 rounded-lg p-4 shadow-sm space-y-3"
        >
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-100">
                <div>
                    <h2 class="text-[11px] font-bold uppercase tracking-wider text-slate-700">
                        2. Select Store Products
                    </h2>
                    <p class="text-[11px] text-slate-400 mt-0.5">
                        Click a product card to add it to your request cart[cite: 9].
                    </p>
                </div>
                <!-- SEARCH -->
                <div class="relative w-full sm:w-64">
                    <input
                        type="text"
                        id="catalog-search"
                        class="w-full rounded-md border border-slate-200 px-2.5 py-1.5 bg-slate-50 text-xs focus:outline-none focus:ring-2 focus:ring-rust focus:bg-white"
                        placeholder="Search product name or size..."
                        aria-label="Search products"
                    >
                </div>
            </div>
            
            <!-- PRODUCT GRID -->
            <div
                id="catalog-grid"
                class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 max-h-[450px] overflow-y-auto pr-1"
            >
                {% for catalog_item in catalog_products %}
                    {% with product=catalog_item.product available=catalog_item.available %}
                        <button
                            type="button"
                            class="product-card text-left p-3 border border-slate-200 bg-white rounded-lg hover:border-rust hover:bg-rust/5 transition flex flex-col justify-between group active:scale-95"
                            data-product-id="{{ product.pk }}"
                            data-product-name="{{ product }}"
                        >
                            <span
                                class="block text-xs font-bold text-slate-700 group-hover:text-rust truncate-2-lines leading-relaxed"
                            >
                                {{ product }}
                            </span>
                            <div class="mt-2.5 flex items-center justify-between text-[11px] font-medium text-slate-500">
                                <div class="flex items-center gap-2">
                                    <span
                                        class="uppercase tracking-wider px-1.5 py-0.5 bg-slate-100 rounded text-slate-400 font-bold text-[9px]"
                                    >
                                        In Store
                                    </span>
                                    <span class="font-bold text-slate-700 tabular-nums">
                                        {{ available|default:"0" }} packs
                                    </span>
                                </div>
                                {% if available > 0 %}
                                    <span class="font-bold text-emerald-600">
                                        Available
                                    </span>
                                {% else %}
                                    <span class="font-bold text-amber-600">
                                        Awaiting Stock
                                    </span>
                                {% endif %}
                            </div>
                        </button>
                    {% endwith %}
                {% empty %}
                    <div class="col-span-2 py-8 text-center text-xs text-slate-400">
                        No packaged products found.
                    </div>
                {% endfor %}
            </div>
        </section>

        <!-- ACTIVE CART -->
        <section
            class="lg:col-span-5 bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden flex flex-col"
        >
            <div class="p-4 border-b border-slate-100 bg-slate-50/50">
                <h2 class="text-[11px] font-bold uppercase tracking-wider text-slate-700">
                    3. Active Request Cart
                </h2>
                <p class="text-[11px] text-slate-400 mt-0.5">
                    Adjust required quantities or remove line items[cite: 9].
                </p>
            </div>
            <div
                id="cart-items-list"
                class="p-4 overflow-y-auto max-h-[380px]"
            >
                <div
                    id="hidden-formset-rows"
                    class="hidden"
                ></div>
                <!-- VISIBLE CART -->
                <div
                    id="visible-cart-cards"
                    class="space-y-2"
                ></div>
                <!-- EMPTY STATE -->
                <div
                    id="cart-empty-state"
                    class="text-center py-10 text-slate-400"
                >
                    <p class="text-xs">
                        Your request cart is currently empty[cite: 9].
                    </p>
                    <p class="text-[11px] text-slate-400/80 mt-1">
                        Click a product on the left to add it[cite: 9].
                    </p>
                </div>
            </div>
        </section>
    </div>
</form>

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-200 bg-white/95 px-4 py-3 shadow-md backdrop-blur lg:left-64">
    <div class="mx-auto flex max-w-7xl items-center justify-end gap-3">
        <a href="{% url 'record_sale' %}"
           class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50">
            Cancel
        </a>
        <button
            type="submit"
            id="submit-request-button"
            form="stock-request-form"
            class="inline-flex items-center gap-2 rounded-lg bg-emerald-700 px-5 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-800"
        >
            Submit Request
        </button>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
document.addEventListener("DOMContentLoaded", function () {
    const bulkRows = document.getElementById("bulk-request-rows");
    const addBulkLineButton = document.getElementById("add-bulk-line");
    const bulkTotalForms = document.getElementById("id_bulk-TOTAL_FORMS");
    const bulkRowTemplate = document.getElementById("bulk-request-row-template");

    function updateBulkLineControls() {
        if (!bulkRows || !bulkTotalForms || !addBulkLineButton) return;
        const visibleRows = bulkRows.querySelectorAll(
            '[data-bulk-row]:not([data-deleted="true"])'
        );
        addBulkLineButton.disabled = Number(bulkTotalForms.value) >= 20;
        addBulkLineButton.classList.toggle("opacity-50", addBulkLineButton.disabled);
        visibleRows.forEach(function (row) {
            const removeButton = row.querySelector("[data-remove-bulk-line]");
            if (removeButton) removeButton.disabled = false;
        });
    }

    if (bulkRows && bulkTotalForms && bulkRowTemplate && addBulkLineButton) {
        addBulkLineButton.addEventListener("click", function () {
            const index = Number(bulkTotalForms.value);
            if (index >= 20) return;
            const row = document.createElement("tbody");
            row.innerHTML = bulkRowTemplate.innerHTML.replace(/__prefix__/g, index);
            const newRow = row.firstElementChild;
            bulkRows.appendChild(newRow);
            bulkTotalForms.value = String(index + 1);
            updateBulkLineControls();
        });

        bulkRows.addEventListener("click", function (event) {
            const button = event.target.closest("[data-remove-bulk-line]");
            if (!button) return;
            const row = button.closest("[data-bulk-row]");
            const deleteInput = row.querySelector('input[name$="-DELETE"]');
            if (deleteInput) deleteInput.value = "on";
            row.dataset.deleted = "true";
            row.classList.add("hidden");
            updateBulkLineControls();
        });

        updateBulkLineControls();
    }

    const totalFormsInput = document.getElementById("id_items-TOTAL_FORMS");
    const visibleCartContainer = document.getElementById("visible-cart-cards");
    const emptyStateElement = document.getElementById("cart-empty-state");
    const nativeContainer = document.getElementById("hidden-formset-rows");
    const productCards = document.querySelectorAll(".product-card");
    const searchInput = document.getElementById("catalog-search");

    if (!totalFormsInput) {
        console.error("Django formset management form not found. Expected id_items-TOTAL_FORMS.");
        return;
    }

    let activeCart = [];

    if (searchInput) {
        searchInput.addEventListener("input", function () {
            const query = this.value.toLowerCase().trim();
            productCards.forEach(function (card) {
                const productName = (card.dataset.productName || "").toLowerCase();
                card.style.display = productName.includes(query) ? "" : "none";
            });
        });
    }

    function updateFormsetValues() {
        nativeContainer.innerHTML = "";
        visibleCartContainer.innerHTML = "";

        if (activeCart.length === 0) {
            emptyStateElement.classList.remove("hidden");
            totalFormsInput.value = "0";
            return;
        }

        emptyStateElement.classList.add("hidden");

        activeCart.forEach(function (item, index) {
            const row = document.createElement("div");
            row.className = "flex items-center justify-between p-2.5 bg-slate-50 rounded-lg border border-slate-200";

            const name = document.createElement("span");
            name.className = "text-xs font-bold text-slate-700 truncate mr-2";
            name.textContent = item.name;

            const controls = document.createElement("div");
            controls.className = "flex items-center gap-2 shrink-0";

            const quantityInput = document.createElement("input");
            quantityInput.type = "number";
            quantityInput.min = "1";
            quantityInput.step = "1";
            quantityInput.value = item.quantity;
            quantityInput.className = "cart-qty-trigger w-14 text-center rounded-md border border-slate-200 py-1 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-rust";
            quantityInput.dataset.prodId = item.id;

            const removeButton = document.createElement("button");
            removeButton.type = "button";
            removeButton.className = "cart-remove-trigger text-slate-400 hover:text-rose-600 p-1";
            removeButton.dataset.prodId = item.id;
            removeButton.setAttribute("aria-label", "Remove " + item.name);
            removeButton.innerHTML = `
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
            `;

            controls.appendChild(quantityInput);
            controls.appendChild(removeButton);
            row.appendChild(name);
            row.appendChild(controls);
            visibleCartContainer.appendChild(row);

            const idInput = document.createElement("input");
            idInput.type = "hidden";
            idInput.name = `items-${index}-id`;
            idInput.id = `id_items-${index}-id`;
            idInput.value = "";

            const productInput = document.createElement("input");
            productInput.type = "hidden";
            productInput.name = `items-${index}-product`;
            productInput.id = `id_items-${index}-product`;
            productInput.value = item.id;

            const quantityFormInput = document.createElement("input");
            quantityFormInput.type = "hidden";
            quantityFormInput.name = `items-${index}-quantity_requested`;
            quantityFormInput.id = `id_items-${index}-quantity_requested`;
            quantityFormInput.value = item.quantity;

            nativeContainer.appendChild(idInput);
            nativeContainer.appendChild(productInput);
            nativeContainer.appendChild(quantityFormInput);
        });

        totalFormsInput.value = activeCart.length;
        attachCartListeners();
    }

    function attachCartListeners() {
        document.querySelectorAll(".cart-qty-trigger").forEach(function (input) {
            input.addEventListener("change", function () {
                const productId = this.dataset.prodId;
                let quantity = parseInt(this.value, 10);
                if (!Number.isInteger(quantity) || quantity < 1) {
                    quantity = 1;
                    this.value = "1";
                }
                const item = activeCart.find(function (cartItem) {
                    return cartItem.id === productId;
                });
                if (item) {
                    item.quantity = quantity;
                    updateFormsetValues();
                }
            });
        });

        document.querySelectorAll(".cart-remove-trigger").forEach(function (button) {
            button.addEventListener("click", function () {
                const productId = this.dataset.prodId;
                activeCart = activeCart.filter(function (item) {
                    return item.id !== productId;
                });
                updateFormsetValues();
            });
        });
    }

    productCards.forEach(function (card) {
        card.addEventListener("click", function () {
            const productId = this.dataset.productId;
            const productName = this.dataset.productName;
            const existingItem = activeCart.find(function (item) {
                return item.id === productId;
            });
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                activeCart.push({
                    id: productId,
                    name: productName,
                    quantity: 1
                });
            }
            updateFormsetValues();
        });
    });

    updateFormsetValues();
});
</script>
{% endblock %}
</file>

<file path="web/templates/pipeline/stock_detail.html">
{% extends "pipeline/base.html" %}
{% load static %}

{% block title %}
{{ stock.variety_name }} — {{ stock.batch_number }} | Nonda
{% endblock %}

{% block breadcrumb %}
Inventory / Coffee Stock / {{ stock.batch_number }}
{% endblock %}

{% block page_title %}
