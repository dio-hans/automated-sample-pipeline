<script>
document.addEventListener("DOMContentLoaded", function () {

    const sidebarNav = document.getElementById("sidebarNav");
    const navLinks = document.querySelectorAll("#mainSidebar a.nav-link");
    const currentPath = window.location.pathname;

    /*
     * =========================================================
     * 1. RESTORE SIDEBAR SCROLL POSITION
     * =========================================================
     */
    if (sidebarNav) {

        const savedScroll = sessionStorage.getItem(
            "nondaSidebarScrollPosition"
        );

        if (savedScroll !== null) {
            sidebarNav.scrollTop = parseInt(savedScroll, 10) || 0;
        }

        /*
         * Continuously remember where the user has scrolled.
         */
        sidebarNav.addEventListener(
            "scroll",
            function () {

                sessionStorage.setItem(
                    "nondaSidebarScrollPosition",
                    sidebarNav.scrollTop
                );

            },
            {
                passive: true
            }
        );
    }


    /*
     * =========================================================
     * 2. ACTIVE LINK HANDLING
     * =========================================================
     */
    navLinks.forEach(function (link) {

        const linkPath = link.getAttribute("href");

        if (
            linkPath &&
            linkPath !== "#" &&
            currentPath === linkPath
        ) {
            link.classList.add("active");
        }


        /*
         * =====================================================
         * 3. SAVE POSITION BEFORE NAVIGATION
         * =====================================================
         */
        link.addEventListener("click", function () {

            if (!sidebarNav) {
                return;
            }

            sessionStorage.setItem(
                "nondaSidebarScrollPosition",
                sidebarNav.scrollTop
            );

        });

    });

});
</script>
</body>
