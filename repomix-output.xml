                                {{ stock.source }}
                            </p>
                        {% endif %}

                    </td>


                    <td class="px-6 py-4">

                        <span class="inline-flex px-2.5 py-1
                                     rounded-full bg-olive/10
                                     text-olive text-xs font-medium">
