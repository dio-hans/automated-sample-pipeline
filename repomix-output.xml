                            <a class="text-rust font-bold hover:underline" href="{% url 'bulk_sale_payment' sale.pk %}">Collect</a>
                        {% endif %}
                    </td>
                </tr>
            {% empty %}
                <tr><td colspan="9" class="px-4 py-12 text-center text-slate-400">No bulk coffee sales have been recorded.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
</file>

