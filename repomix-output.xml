<file path="web/templates/pipeline/followup_detail.html">
{% extends "pipeline/base.html" %}
{% block title %}Follow-up {{ followup.pk }}{% endblock %}
{% block breadcrumb %}Pipeline / Follow-ups / {{ followup.sample.company.name }}{% endblock %}
{% block page_title %}Follow-up: {{ followup.sample.company.name }}{% endblock %}

{% block content %}
<div class="max-w-4xl space-y-6">
  <div class="bg-white rounded-lg shadow-sm border p-6">
    <p class="eyebrow text-clay">Sample</p>
    <p class="mt-1">{{ followup.sample.coffee_stock.variety_name }} · {{ followup.sample.sample_weight|floatformat:2 }} kg · sent {{ followup.sample.date_sent|date:"d M Y" }}</p>
  </div>

  <div class="bg-white rounded-lg shadow-sm border p-6">
    <h2 class="font-semibold text-lg mb-4">Follow-up timeline</h2>
    <dl class="divide-y">
      <div class="py-3 flex justify-between"><dt class="text-sm text-gray-500">Dispatch alert</dt><dd class="text-sm">{{ followup.dispatch_alert_sent_at|date:"d M Y, H:i"|default_if_none:"—" }}</dd></div>
      <div class="py-3 flex justify-between"><dt class="text-sm text-gray-500">Day-3 guide</dt><dd class="text-sm">{{ followup.day_3_guide_sent_at|date:"d M Y"|default_if_none:"—" }}</dd></div>
      <div class="py-3 flex justify-between"><dt class="text-sm text-gray-500">Day-7 contract prompt</dt><dd class="text-sm">{{ followup.day_7_contract_sent_at|date:"d M Y"|default_if_none:"—" }}</dd></div>
      <div class="py-3 flex justify-between"><dt class="text-sm text-gray-500">Converted to contract</dt><dd class="text-sm">{% if followup.is_converted_to_contract %}Yes{% else %}No{% endif %}</dd></div>
    </dl>

    {% if not followup.is_converted_to_contract %}
    <div class="flex gap-3 mt-6">
      <form method="post" action="{% url 'followup_mark_guide' followup.pk %}">{% csrf_token %}<button class="px-4 py-2 text-sm rounded-md border border-[#E4DECB] hover:bg-paper">Mark guide sent</button></form>
      <form method="post" action="{% url 'followup_mark_contract' followup.pk %}">{% csrf_token %}<button class="px-4 py-2 text-sm rounded-md border border-[#E4DECB] hover:bg-paper">Mark contract prompt sent</button></form>
    </div>
    {% endif %}
  </div>

  {% if not followup.is_converted_to_contract %}
  <div class="bg-white rounded-lg shadow-sm border p-6">
    <h2 class="font-semibold text-lg mb-4">Convert to contract</h2>
    <form method="post" action="{% url 'followup_convert' followup.pk %}" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {% csrf_token %}
      <div><label class="field-label block mb-2 text-xs">Volume / cycle (kg)</label>{{ contract_form.volume_per_cycle_kg }}</div>
      <div><label class="field-label block mb-2 text-xs">Price / kg</label>{{ contract_form.price_per_kg }}</div>
      <div><label class="field-label block mb-2 text-xs">Frequency</label>{{ contract_form.delivery_frequency }}</div>
      <div><label class="field-label block mb-2 text-xs">Signed by</label>{{ contract_form.signed_name }}</div>
      <div class="md:col-span-2"><button class="px-5 py-2.5 text-sm font-semibold rounded-md bg-rust text-white hover:bg-rust-dark">Sign contract</button></div>
    </form>
  </div>
  {% else %}
  <div class="rounded-md border border-olive/30 bg-olive/10 px-4 py-3">
    <p class="text-olive font-medium">Converted — this company is now a signed contract holder.</p>
  </div>
  {% endif %}
</div>
{% endblock %}
</file>

<file path="web/templates/pipeline/pack_return_confirmation.html">
{% extends "pipeline/base.html" %}
{% load humanize %}

{% block title %}Confirm Returns | Nonda{% endblock %}
{% block breadcrumb %}Sales / Orders / {{ order.short_number }} / Confirm Return{% endblock %}
{% block page_title %}Confirm Returned Stock{% endblock %}

{% block page_subtitle %}
<p class="mt-0.5 text-xs text-slate-500">
    Review the crate contents before submitting them for store approval.
</p>
{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto flex flex-col gap-4">
    
    <!-- MASTER LAYOUT CARD CONTAINER -->
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden flex flex-col">
        
        <!-- Top Status Branding Bar Header -->
        <div class="bg-slate-950 text-white px-4 py-3 flex justify-between items-center border-b border-slate-800 select-none">
            <div>
                <span class="text-[9px] font-mono tracking-wider text-orange-400 uppercase font-bold">Stage 2 of 2: Approval Gate</span>
                <h2 class="text-xs font-bold text-slate-200 mt-0.5">Return Confirmation · #{{ order.short_number }}</h2>
            </div>
            <span class="text-xs font-mono text-slate-400">{{ order.company.name|default:"Individual Account" }}</span>
        </div>

        <div class="p-6 space-y-6">
            <!-- Warning Informational Context Box -->
            <div class="bg-amber-50/60 border border-amber-200 rounded-xl p-4 flex items-start gap-3">
                <span class="text-base">⚠️</span>
                <div class="text-[11px] text-amber-950 leading-normal">
                    <p class="font-bold">Verify Staged Return Manifest</p>
                    <p class="mt-0.5 opacity-90">Submitting creates pending return records only. Nothing changes in stock, sold quantities, or account ledger balances until a store manager or cashier approves the return.</p>
                </div>
            </div>

            <!-- Staged Inbound Table Items Grid Structure -->
            <div class="space-y-2">
                <h3 class="text-[10px] uppercase tracking-wider font-bold text-slate-400 select-none">Items Staged for Inbound Intake</h3>
                <div class="border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100 shadow-2xs">
                    <!-- Column Header Names Row -->
                    <div class="bg-slate-50 px-4 py-2.5 grid grid-cols-12 gap-2 text-[9px] uppercase font-bold text-slate-400 tracking-wider select-none border-b border-slate-200">
                        <div class="col-span-6">Product Description</div>
                        <div class="col-span-3 text-center">Return Qty</div>
                        <div class="col-span-3 text-right">Condition / Value</div>
                    </div>

                    <!-- 🎯 FIXED LOOP STRUCTURE: Encapsulates row content correctly -->
                    {% for item in selections %}
                    <div class="px-4 py-3.5 grid grid-cols-12 gap-2 items-center bg-white text-xs">
                        <!-- Product description block -->
                        <div class="col-span-6 pr-2">
                            <p class="font-bold text-slate-800 tracking-tight">{{ item.product }}</p>
                        </div>
                        <!-- Returning quantity volume -->
                        <div class="col-span-3 text-center font-mono font-bold text-slate-700">
                            {{ item.quantity }} packs
                        </div>
                        <!-- Evaluation metrics and calculated values -->
                        <div class="col-span-3 text-right">
                            <span class="font-mono font-bold text-orange-600 block text-xs">UGX {{ item.value|floatformat:0|intcomma }}</span>
                            <span class="text-[9px] font-mono uppercase font-bold tracking-wider text-slate-400 bg-slate-100 border border-slate-200/60 px-1.5 py-0.5 rounded inline-block mt-1">
                                {{ item.condition|cut:"_"|upper }}
                            </span>
                        </div>
                    </div>
                    {% empty %}
                    <div class="p-6 text-center text-xs text-slate-400 italic">
                        No products selected for staging intake logs.
                    </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Totals Metrics Cards Summary Row -->
            <div class="grid grid-cols-2 gap-4 pt-2 select-none">
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 shadow-3xs">
                    <span class="text-[9px] uppercase font-bold text-slate-400 tracking-wider block">Total Packs Returning</span>
                    <p class="text-xl font-bold font-mono text-slate-800 mt-1">{{ total_packs }}</p>
                </div>
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-right shadow-3xs">
                    <span class="text-[9px] uppercase font-bold text-slate-400 tracking-wider block">Return Value to be Cleared</span>
                    <p class="text-xl font-black font-mono text-orange-500 mt-1">UGX {{ total_value|floatformat:0|intcomma }}</p>
                </div>
            </div>

            <!-- Form Multi-Action Control Toolbar Section -->
            <form method="post" class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-4 border-t border-slate-100 mt-2">
                {% csrf_token %}
                
                <!-- Cancel / Back to worksheet execution action trigger -->
                <button type="submit" name="action" value="cancel" class="w-full sm:w-auto px-4 py-2 border border-slate-200 bg-white hover:bg-slate-50 text-xs font-bold text-slate-600 rounded-lg shadow-2xs transition-all cursor-pointer text-center">
                    Back to Worksheet
                </button>
                
                <!-- Commit action execution trigger to submit sheet for manager approval -->
                <button type="submit" name="action" value="confirm" class="w-full sm:w-auto px-5 py-2.5 bg-orange-500 hover:bg-orange-600 text-white rounded-lg text-xs font-bold shadow-sm transition-all cursor-pointer text-center active:scale-[0.98]">
                    Submit for Store Approval
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
</file>

