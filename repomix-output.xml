        super().clean()
        seen = set()
        for form in self.forms:
            if not hasattr(form, "cleaned_data") or not form.cleaned_data:
                continue
            row = form.cleaned_data
            if row.get("DELETE") or not row.get("stock") or not row.get("stage"):
