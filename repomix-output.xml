<file path="web/templates/pipeline/expense_list.html">
{% extends "pipeline/base.html" %}
{% load static humanize %}

{% block title %}Expense History | Nonda{% endblock %}

{% block breadcrumb %}
Accounts / Expenses / History
{% endblock %}

{% block header_action %}

    <a href="{% url 'expense_tracker' %}" 
           class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 bg-green-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-lg shadow-sm transition shrink-0">
            
            Record Expense
        </a>


{% endblock %}    
{% block content %}
<div class="px-3 py-2 sm:px-4 sm:py-3 space-y-3 w-full">

    <!-- PAGE HEADER -->
    <div class="flex items-center justify-between gap-3">
        <div>
            <h1 class="text-lg sm:text-xl font-bold text-slate-800 tracking-tight">Expense History</h1>
            <p class="text-xs text-slate-500">Review and filter Nonda business expenses.</p>
        </div>
        
    </div>

    <!-- SUMMARY CARD -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-sm px-3.5 py-2.5 max-w-sm flex items-center justify-between gap-3">
        <div class="space-y-0.5">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Total Expenses</span>
            <div class="text-base sm:text-lg font-bold text-slate-900 tracking-tight">
                UGX {{ total_expenses|floatformat:0|intcomma }}
            </div>
        </div>
        <div>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                {{ selected_range_label }}
            </span>
        </div>
    </div>

    <!-- REPORT DATE FILTERS & CATEGORY SELECT -->
    <div class="space-y-2">
        {% include "reports/components/report_filters.html" %}

        <!-- CATEGORY QUICK FILTER BAR -->
        {% if categories %}
        <div class="bg-white border border-slate-200 rounded-lg shadow-sm px-3 py-1.5 flex items-center gap-2 overflow-x-auto text-xs">
            <span class="text-slate-400 font-semibold text-[10px] shrink-0">Category:</span>
            <a href="?{% if extra_qs %}{{ extra_qs|safe }}&{% endif %}category="
               class="px-2 py-0.5 rounded-md border text-[10px] font-semibold transition shrink-0
               {% if not category_filter %}bg-slate-800 text-white border-slate-800{% else %}bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100{% endif %}">
                All Categories
            </a>
            {% for code, label in categories %}
                <a href="?{% if preset %}period={{ preset }}&{% endif %}{% if period.start_date %}start_date={{ period.start_date|date:'Y-m-d' }}&{% endif %}{% if period.end_date %}end_date={{ period.end_date|date:'Y-m-d' }}&{% endif %}category={{ code }}"
                   class="px-2 py-0.5 rounded-md border text-[10px] font-semibold transition shrink-0
                   {% if category_filter == code %}bg-slate-800 text-white border-slate-800{% else %}bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100{% endif %}">
                    {{ label }}
                </a>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    <!-- TRANSACTIONS TABLE CARD -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
        
        <!-- CARD HEADER -->
        <div class="px-4 py-2.5 border-b border-slate-100 flex items-center justify-between">
            <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Transactions</h2>
            <span class="text-[10px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">
                {{ paginator.count }} record{{ paginator.count|pluralize }}
            </span>
        </div>

        <!-- TABLE WRAPPER -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 text-[10px] font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
                        <th class="px-4 py-2">Date</th>
                        <th class="px-4 py-2">Category</th>
                        <th class="px-4 py-2">Description</th>
                        <th class="px-4 py-2">Logged By</th>
                        <th class="px-4 py-2 text-right">Amount (UGX)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-xs text-slate-700">
                    {% for expense in expenses %}
                        <tr class="hover:bg-slate-50/70 transition">
                            <td class="px-4 py-2.5 whitespace-nowrap font-medium text-slate-900">
                                {{ expense.expense_date|date:"d M Y" }}
                            </td>
                            <td class="px-4 py-2.5 whitespace-nowrap">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-slate-100 text-slate-700 border border-slate-200">
                                    {{ expense.get_category_display }}
                                </span>
                            </td>
                            <td class="px-4 py-2.5 text-slate-600 max-w-xs truncate">
                                {{ expense.notes|default:"—" }}
                            </td>
                            <td class="px-4 py-2.5 whitespace-nowrap text-slate-600">
                                {{ expense.logged_by.username|default:"System" }}
                            </td>
                            <td class="px-4 py-2.5 whitespace-nowrap text-right font-bold text-slate-900">
                                UGX {{ expense.amount|floatformat:0|intcomma }}
                            </td>
                        </tr>
                    {% empty %}
                        <tr>
                            <td colspan="5" class="px-4 py-6 text-center text-slate-400 text-xs">
                                No expense records found for this period.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        {% if is_paginated %}
            <div class="px-4 py-2 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600">
                <div>
                    Page <span class="font-semibold text-slate-800">{{ page_obj.number }}</span> of <span class="font-semibold text-slate-800">{{ page_obj.paginator.num_pages }}</span>
                </div>
                <div class="flex items-center gap-1.5">
                    {% if page_obj.has_previous %}
                        <a href="?page={{ page_obj.previous_page_number }}{% if extra_qs %}&{{ extra_qs }}{% endif %}" 
                           class="px-2.5 py-1 rounded-md border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium transition shadow-sm text-[11px]">
                            ← Previous
                        </a>
                    {% endif %}
                    {% if page_obj.has_next %}
                        <a href="?page={{ page_obj.next_page_number }}{% if extra_qs %}&{{ extra_qs }}{% endif %}" 
                           class="px-2.5 py-1 rounded-md border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium transition shadow-sm text-[11px]">
                            Next →
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
</file>

<file path="web/templates/pipeline/registration.html">
{% extends "pipeline/base.html" %}

{% block title %}User Management | Nonda{% endblock %}
{% block breadcrumb %}Administration / User Management{% endblock %}
{% block page_title %}User Management{% endblock %}
{% block page_subtitle %}
<p class="mt-0.5 text-xs text-stone-500">Create staff accounts, assign operational roles, and manage system access.</p>
{% endblock %}

{% block content %}
<style>
    /* Styling Django default form input outputs */
    .compact-form input[type="text"],
    .compact-form input[type="email"],
    .compact-form input[type="password"],
    .compact-form select {
        width: 100%;
        height: 30px;
        padding: 2px 8px;
        border: 1px solid #cbd5e1;
        border-radius: 5px;
        font-size: 12px;
        color: #0f172a;
        background-color: #ffffff;
        outline: none;
        transition: border-color 0.15s ease;
    }
    .compact-form input:focus, 
    .compact-form select:focus {
        border-color: #00674F;
        box-shadow: 0 0 0 1px #00674F;
    }
</style>

<div class="max-w-7xl mx-auto space-y-3">

    <!-- 1. CREATE USER FORM (TOP CARD) -->
    <div class="bg-white rounded-lg border border-stone-200 shadow-sm p-3">
        <div class="flex items-center justify-between border-b border-stone-100 pb-2 mb-2.5">
            <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-stone-400">New Account</span>
                <h2 class="text-xs font-bold text-stone-900">Create Staff User</h2>
            </div>
        </div>

        <form method="post" class="compact-form space-y-2.5">
            {% csrf_token %}
            
            {% if form.non_field_errors %}
                <div class="rounded-md bg-red-50 border border-red-200 text-red-700 text-xs p-2">
                    {{ form.non_field_errors }}
                </div>
            {% endif %}

            <!-- Multi-column grid layout for form fields -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
                {% for field in form %}
                {% if field.name == "email" or field.name == "contact" %}
                    {% comment %}Keep these optional registration fields available in the form definition, but hidden from this template for now.{% endcomment %}
                {% else %}
                <div>
                    <label for="{{ field.id_for_label }}" class="block text-[10px] font-bold uppercase tracking-wider text-stone-500 mb-0.5">
                        {{ field.label }}
                    </label>
                    <div>
                        {{ field }}
                    </div>
                    {% for error in field.errors %}
                        <p class="text-[10px] text-red-600 mt-0.5">{{ error }}</p>
                    {% endfor %}
                </div>
                {% endif %}
                {% endfor %}
            </div>

            <div class="flex justify-end pt-1">
                <button type="submit" class="h-7 px-4 bg-[#8B3A2B] hover:bg-[#722f23] text-white text-xs font-bold rounded transition-colors shadow-sm cursor-pointer">
                    + Create Account
                </button>
            </div>
        </form>
    </div>

    <!-- 2. SYSTEM USERS TABLE (FULL WIDTH UNDERNEATH) -->
    <div class="bg-white rounded-lg border border-stone-200 shadow-sm overflow-hidden">
        <div class="px-3.5 py-2.5 border-b border-stone-200 bg-stone-50/50 flex items-center justify-between">
            <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Access Control</span>
                <h3 class="text-xs font-bold text-stone-900">System Users</h3>
            </div>
            <span class="text-[10px] font-bold bg-stone-100 text-stone-600 px-2 py-0.5 rounded-full border border-stone-200">
                Total Users: {{ users|length }}
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-stone-50 border-b border-stone-200 text-[10px] font-bold uppercase tracking-wider text-stone-500">
                        <th class="px-3.5 py-2">User</th>
                        <th class="px-3.5 py-2">Employee ID</th>
                        <th class="px-3.5 py-2">Role</th>
                        <th class="px-3.5 py-2">Status</th>
                        <th class="px-3.5 py-2 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-stone-100">
                    {% for employee in users %}
                    <tr class="hover:bg-stone-50/50 transition-colors">
                        <td class="px-3.5 py-2 whitespace-nowrap">
                            <p class="font-bold text-stone-900 leading-tight">{{ employee.username }}</p>
                            <p class="text-[10px] text-stone-500 mt-0.5">{{ employee.email|default:"No email" }}</p>
                        </td>
                        <td class="px-3.5 py-2 text-stone-600 font-mono text-[11px] whitespace-nowrap">
                            {{ employee.employee_id|default:"—" }}
                        </td>
                        <td class="px-3.5 py-2 font-medium text-stone-800 whitespace-nowrap">
                            {{ employee.get_role_display }}
                        </td>
                        <td class="px-3.5 py-2 whitespace-nowrap">
                            {% if employee.is_active %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Active</span>
                            {% else %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-red-800">Suspended</span>
                            {% endif %}
                        </td>
                        <td class="px-3.5 py-2 text-right whitespace-nowrap">
                            {% if employee != request.user and not employee.is_superuser %}
                            <form method="post" action="{% url 'toggle_user_status' employee.id %}" class="inline">
                                {% csrf_token %}
                                <button type="submit" class="px-2.5 py-1 text-[11px] font-bold rounded-md transition-colors cursor-pointer {% if employee.is_active %}bg-red-600 text-white hover:bg-red-700{% else %}bg-emerald-600 text-white hover:bg-emerald-700{% endif %}">
                                    {% if employee.is_active %}Suspend{% else %}Activate{% endif %}
                                </button>
                            </form>
                            {% else %}
                                <span class="text-[10px] font-semibold text-stone-400 bg-stone-100 px-2 py-0.5 rounded">Protected</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="5" class="px-3.5 py-6 text-center text-stone-500">No staff accounts found.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
</file>

