                                    Allocated Products Payload
                                </h4>
                                <span class="text-[9px] text-slate-400 font-mono">
                                    {{ order.queue_releases|length }} item{{ order.queue_releases|length|pluralize }}
                                </span>
                            </div>
                            
                            <div class="space-y-1">
                                {% for release in order.queue_releases %}
                                <div class="bg-slate-50 border border-slate-200/60 rounded-md px-2.5 py-1.5 flex justify-between items-center text-xs">
                                    <div class="flex items-center gap-2 truncate">
                                        <div class="truncate">
                                            <p class="font-bold text-slate-800 leading-tight truncate">{{ release.product.blend.name }}</p>
                                            <p class="text-[9px] text-slate-500 leading-tight">{{ release.product.pack_size.label }} · {{ release.product.get_form_display }}</p>
                                        </div>
                                    </div>
                                    <div class="text-right shrink-0">
                                        <p class="font-mono font-bold text-slate-700 text-xs">{{ release.packs_out }} pk</p>
