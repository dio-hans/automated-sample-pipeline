            <div>
                <span class="text-slate-400 block font-medium">Destination</span>
                <span class="font-bold text-slate-700">{{ stock_request.company.name|default:"Direct / Floating" }}</span>
            </div>
            <div>
                <span class="text-slate-400 block font-medium">Date Created</span>
                <span class="font-mono text-slate-600">{{ stock_request.created_at|date:"d M Y, H:i" }}</span>
            </div>
        </div>

        {% if stock_request.notes %}
        <div class="mt-4 pt-3 border-t border-slate-100 text-xs">
            <span class="text-slate-400 font-medium block">Notes:</span>
            <p class="text-slate-600 mt-0.5">{{ stock_request.notes }}</p>
        </div>
        {% endif %}
    </div>

    <!-- Packaged Items Table -->
    <div class="bg-white border border-[#E4DECB] rounded-xl shadow-xs overflow-hidden">
        <div class="px-4 py-3 bg-slate-50 border-b border-[#E4DECB] flex justify-between items-center">
            <h2 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Requested Line Items</h2>
            <span class="text-xs font-mono font-bold text-slate-500">{{ stock_request.items.all|length }} Items</span>
        </div>

        <div class="bg-white border border-[#E4DECB] rounded-xl shadow-xs overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 border-b border-[#E4DECB]">
                <h2 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Bulk Coffee Lines</h2>
            </div>
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-[#E4DECB] text-slate-400 uppercase tracking-wider text-[10px] bg-slate-50/50">
                        <th class="px-4 py-2.5">Batch / Stage</th>
                        <th class="px-4 py-2.5 text-right">Requested</th>
                        <th class="px-4 py-2.5 text-right">Issued</th>
                        <th class="px-4 py-2.5 text-right">Remaining</th>
                        <th class="px-4 py-2.5 text-right">Agreed Price / kg</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E4DECB] text-slate-700">
                    {% for item in stock_request.bulk_items.all %}
                        <tr>
                            <td class="px-4 py-2.5 font-bold">{{ item.stock.batch_number }} · {{ item.stock.variety.name }} · {{ item.get_stage_display }}</td>
                            <td class="px-4 py-2.5 text-right font-mono">{{ item.quantity_requested }} kg</td>
                            <td class="px-4 py-2.5 text-right font-mono">{{ item.quantity_issued }} kg</td>
                            <td class="px-4 py-2.5 text-right font-mono">{{ item.outstanding_quantity }} kg</td>
                            <td class="px-4 py-2.5 text-right font-mono">UGX {{ item.price_per_kg|floatformat:2 }}</td>
                        </tr>
                    {% empty %}
                        <tr><td colspan="5" class="px-4 py-6 text-center text-slate-400 italic">No bulk coffee requested.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <table class="w-full text-left border-collapse text-xs">
            <thead>
                <tr class="border-b border-[#E4DECB] text-slate-400 uppercase tracking-wider text-[10px] bg-slate-50/50">
                    <th class="px-4 py-2.5">Product</th>
                    <th class="px-4 py-2.5 text-center">Pack Size</th>
                    <th class="px-4 py-2.5 text-center">Form</th>
                    <th class="px-4 py-2.5 text-right">Requested Qty</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-[#E4DECB] text-slate-700">
                {% for item in stock_request.items.all %}
                <tr class="hover:bg-slate-50/50">
                    <td class="px-4 py-2.5 font-bold text-slate-800">
                        {{ item.product.blend.name }}
                    </td>
                    <td class="px-4 py-2.5 text-center font-mono text-slate-600">
                        {{ item.product.pack_size.label }}
                    </td>
                    <td class="px-4 py-2.5 text-center text-slate-500">
                        {{ item.product.get_form_display }}
                    </td>
                    <td class="px-4 py-2.5 text-right font-mono font-bold text-slate-900">
                        {{ item.quantity_requested }} packs
                    </td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="4" class="px-4 py-6 text-center text-slate-400 italic">
                        No items found on this request.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Bottom Action Footer (If still pending) -->
    {% if stock_request.status == 'pending' %}
    <div class="bg-slate-50 border border-[#E4DECB] rounded-xl p-4 flex items-center justify-between">
        <div class="text-xs text-slate-500">
            <strong>Ready to dispatch stock?</strong> 
        </div>
        <a href="{% url 'stock_request_fulfill' stock_request.pk %}" 
           class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg text-xs font-bold transition-all">
            Fulfill Request 
        </a>
    </div>
    {% endif %}

</div>
{% endblock %}
</file>

