                        <label for="{{ form.moisture_content.id_for_label }}" class="block text-xs font-medium text-slate-700 mb-1">Moisture (%)</label>
                        {{ form.moisture_content }}
                        {% for error in form.moisture_content.errors %}
                            <p class="text-xs text-rust mt-1">{{ error }}</p>
                        {% endfor %}
                    </div>

                    <!-- Process -->
                    <div>
                        <label for="{{ form.process.id_for_label }}" class="block text-xs font-medium text-slate-700 mb-1">Process Method</label>
                        {{ form.process }}
                        {% for error in form.process.errors %}
                            <p class="text-xs text-rust mt-1">{{ error }}</p>
                        {% endfor %}
                    </div>

                    <!-- Fermentation 
                    <div>
                        <label for="{{ form.fermentation_type.id_for_label }}" class="block text-xs font-medium text-slate-700 mb-1">Fermentation</label>
                        {{ form.fermentation_type }}
                        {% for error in form.fermentation_type.errors %}
                            <p class="text-xs text-rust mt-1">{{ error }}</p>
                        {% endfor %}
                    </div>
                    -->

                    <!-- Season -->
                    <div>
                        <label for="{{ form.season_of_harvest.id_for_label }}" class="block text-xs font-medium text-slate-700 mb-1">Harvest Season</label>
                        {{ form.season_of_harvest }}
                        {% for error in form.season_of_harvest.errors %}
                            <p class="text-xs text-rust mt-1">{{ error }}</p>
                        {% endfor %}
                    </div>

                    <!-- Quantity Received -->
