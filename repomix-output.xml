--- FILE: sales_workspace.html.FullName ---

{% extends "pipeline/base.html" %}
{% block title %}Sales Desk | Nonda{% endblock %}
{% block breadcrumb %}Sales / Sales Desk{% endblock %}
{% block page_title %}Sales Desk{% endblock %}
{% block page_subtitle %}<p class="mt-1 text-sm text-clay">Request stock, track what is with you, and keep every customer conversation connected to the business.</p>{% endblock %}
{% block header_action %}<a href="{% url 'stock_request_create' %}" class="inline-flex px-4 py-2.5 rounded-lg bg-rust text-white text-sm font-semibold hover:bg-rust/90">Request Stock</a>{% endblock %}
{% block content %}
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-white border border-line rounded-xl p-5"><p class="text-xs uppercase tracking-wider text-clay font-semibold">My open stock</p><p class="font-display text-3xl mt-2">{{ my_release_count }}</p><p class="text-xs text-clay mt-1">Releases still needing return or clearance</p></div>
    <div class="bg-white border border-line rounded-xl p-5"><p class="text-xs uppercase tracking-wider text-clay font-semibold">My requests</p><p class="font-display text-3xl mt-2">{{ my_requests|length }}</p><p class="text-xs text-clay mt-1">Recent stock requests</p></div>
    <a href="{% url 'followup_list' %}" class="bg-white border border-line rounded-xl p-5 hover:border-rust/40"><p class="text-xs uppercase tracking-wider text-clay font-semibold">Follow-ups</p><p class="font-display text-3xl mt-2">{{ followup_count }}</p><p class="text-xs text-clay mt-1">Customer relationships needing attention</p></a>
</div>
<div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    <section class="bg-white border border-line rounded-xl overflow-hidden">
        <div class="px-6 py-5 border-b border-line"><h2 class="font-display text-xl">My issued stock</h2><p class="text-sm text-clay mt-1">Physical stock currently assigned to you.</p></div>
        <div class="divide-y divide-line">
        {% for release in my_releases %}<a href="{% url 'pack_release_detail' release.pk %}" class="block px-6 py-4 hover:bg-paper"><div class="flex justify-between gap-4"><div><p class="font-semibold">{{ release.product.blend.name }} Â· {{ release.product.pack_size.label }}</p><p class="text-xs text-clay mt-1">Issued {{ release.released_at|date:"d M Y" }} Â· {% if release.request_item %}{{ release.request_item.request.get_purpose_display }}{% else %}Legacy release{% endif %}</p></div><div class="text-right"><p class="font-semibold">{{ release.packs_outstanding }} packs</p><p class="text-xs text-clay">UGX {{ release.stock_value|floatformat:0 }}</p></div></div></a>{% empty %}<div class="px-6 py-10 text-center text-sm text-clay">No outstanding issued stock.</div>{% endfor %}
        </div>
    </section>
    <section class="bg-white border border-line rounded-xl overflow-hidden">
        <div class="px-6 py-5 border-b border-line"><h2 class="font-display text-xl">Recent requests</h2><p class="text-sm text-clay mt-1">Your latest requests and their current status.</p></div>
        <div class="divide-y divide-line">
        {% for request in my_requests %}<a href="{% url 'stock_request_detail' request.pk %}" class="block px-6 py-4 hover:bg-paper"><div class="flex justify-between gap-4"><div><p class="font-semibold">Request {{ request.short_number }}</p><p class="text-xs text-clay mt-1">{{ request.requested_at|date:"d M Y, H:i" }} Â· {{ request.get_purpose_display }}</p></div><span class="text-xs font-semibold text-olive">{{ request.get_status_display }}</span></div></a>{% empty %}<div class="px-6 py-10 text-center text-sm text-clay">You have not submitted a stock request yet.</div>{% endfor %}
        </div>
    </section>
</div>
{% endblock %}



--- FILE: sample_confirm_delete.html.FullName ---

{% extends "pipeline/base.html" %}

{% block title %}
Delete Sample
{% endblock %}

{% block breadcrumb %}
Samples / Delete
{% endblock %}

{% block page_title %}
Delete Sample
{% endblock %}

{% block header_action %}
    <a href="{% url 'sample_detail' sample.pk %}"
       class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium
              border border-[#E4DECB] rounded-md
              text-ink hover:bg-white transition">
        â† Cancel
    </a>
{% endblock %}

{% block content %}

<div class="max-w-xl">

    <div class="card p-6 md:p-8">

        <div class="flex items-start gap-4">

            <div class="h-10 w-10 rounded-full bg-rust/10 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="h-5 w-5 text-rust"
                     fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>

            <div>
                <h2 class="font-display text-xl">
                    Confirm deletion
                </h2>

                <p class="text-sm text-clay mt-1">
                    This will permanently remove the sample record for
                    <span class="font-medium text-ink">{{ sample.company.name }}</span>
                    ({{ sample.coffee_stock.variety_name }},
                    {{ sample.sample_weight|floatformat:2 }} kg).
