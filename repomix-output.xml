function filterTableByName() {
    const input = document.getElementById('tableSearchInput');
    const filter = input.value.toLowerCase().trim();
    const rows = document.querySelectorAll('.release-row');

    rows.forEach(row => {
        const nameAttr = row.getAttribute('data-name') || '';
        const cellText = row.querySelector('.account-holder-cell')?.textContent.toLowerCase() || '';
        const drawerId = row.getAttribute('data-drawer');
        const drawerRow = drawerId ? document.getElementById(drawerId) : null;

        if (nameAttr.includes(filter) || cellText.includes(filter)) {
            row.style.display = ''; // Show row
        } else {
            row.style.display = 'none'; // Hide row
            if (drawerRow) {
                drawerRow.classList.add('hidden'); // Close receipt drawer if parent is hidden
            }
        }
    });
}

</script>
