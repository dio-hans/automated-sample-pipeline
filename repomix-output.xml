{% block content %}<div class="max-w-5xl space-y-6"><section class="bg-white border border-line rounded-xl p-6"><p class="text-xs uppercase tracking-wider text-clay">{{ release.released_at|date:"d M Y, H:i" }}</p><h2 class="font-display text-2xl mt-1">{{ release.product.blend.name }} Â· {{ release.product.pack_size.label }}</h2><p class="text-sm text-clay mt-1">{{ release.product.get_form_display }} Â· Released to {{ release.released_to }}</p>{% if release.request_item %}<p class="text-sm text-clay mt-3">Request {{ release.request_item.request.short_number }} Â· {{ release.request_item.request.get_purpose_display }}</p>{% endif %}</section><section class="grid grid-cols-1 md:grid-cols-4 gap-4"><div class="bg-white border border-line rounded-xl p-5"><p class="text-xs uppercase text-clay">Issued</p><p class="font-display text-3xl mt-2">{{ release.packs_out }}</p></div><div class="bg-white border border-line rounded-xl p-5"><p class="text-xs uppercase text-clay">Returned</p><p class="font-display text-3xl mt-2">{{ release.packs_returned }}</p></div><div class="bg-white border border-line rounded-xl p-5"><p class="text-xs uppercase text-clay">Outstanding</p><p class="font-display text-3xl mt-2">{{ release.packs_outstanding }}</p></div><div class="bg-white border border-line rounded-xl p-5"><p class="text-xs uppercase text-clay">Release value</p><p class="font-display text-2xl mt-2">UGX {{ release.stock_value|floatformat:0 }}</p><p class="text-xs text-clay mt-1">UGX {{ release.selling_price|floatformat:0 }} per pack</p></div></section><section class="bg-white border border-line rounded-xl overflow-hidden"><div class="px-6 py-5 border-b border-line"><h2 class="font-display text-xl">Payment</h2></div><div class="p-6">{% if settlement %}<div class="grid grid-cols-1 md:grid-cols-3 gap-5"><div><p class="text-xs text-clay">Sold</p><p class="font-semibold mt-1">{{ settlement.packs_sold }} packs</p></div><div><p class="text-xs text-clay">Paid</p><p class="font-semibold mt-1">UGX {{ settlement.amount_paid|floatformat:0 }}</p></div><div><p class="text-xs text-clay">Status</p><p class="font-semibold mt-1">{{ settlement.get_status_display }}</p></div></div>{% else %}<p class="text-sm text-clay">No payment has been recorded yet.</p>{% endif %}</div></section><section class="bg-white border border-line rounded-xl overflow-hidden"><div class="px-6 py-5 border-b border-line"><h2 class="font-display text-xl">Returns</h2></div><div class="overflow-x-auto"><table class="w-full text-sm"><thead class="bg-paper"><tr><th class="px-6 py-3 text-left">Date</th><th class="px-6 py-3 text-right">Quantity</th><th class="px-6 py-3 text-left">Reason</th><th class="px-6 py-3 text-left">Received by</th></tr></thead><tbody class="divide-y divide-line">{% for item in returns %}<tr><td class="px-6 py-4">{{ item.returned_at|date:"d M Y, H:i" }}</td><td class="px-6 py-4 text-right font-semibold">{{ item.packs_returned }}</td><td class="px-6 py-4">{{ item.reason|default:"â€”" }}</td><td class="px-6 py-4">{{ item.received_by|default:"â€”" }}</td></tr>{% empty %}<tr><td colspan="4" class="px-6 py-10 text-center text-clay">No returns recorded.</td></tr>{% endfor %}</tbody></table></div></section></div>{% endblock %}



