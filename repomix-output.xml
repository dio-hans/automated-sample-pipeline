    </section>

    <!-- AUDITS + MOVEMENTS -->
    <div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
        <section class="rounded-lg border border-line bg-white shadow-sm overflow-hidden">

            <div class="border-b border-line px-3 py-2.5">
