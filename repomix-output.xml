class PackagedProductForm(forms.Form):
    blend_input = forms.CharField(
        max_length=255,
        label="Blend / Product",
        widget=forms.TextInput(
            attrs={
                "list": "blend-list",
                "class": FIELD_CLASS,
                "autocomplete": "off",
                "placeholder": "Select an existing blend or type a new one...",
            }
        ),
    )

    size_sachet = forms.BooleanField(required=False, label="Sachet", widget=forms.CheckboxInput(attrs={'class': 'rounded text-rust focus:ring-rust'}))
    size_50g = forms.BooleanField(required=False, label="50g", widget=forms.CheckboxInput(attrs={'class': 'rounded text-rust focus:ring-rust'}))
    size_250g = forms.BooleanField(required=False, label="250g", widget=forms.CheckboxInput(attrs={'class': 'rounded text-rust focus:ring-rust'}))
    size_500g = forms.BooleanField(required=False, label="500g", widget=forms.CheckboxInput(attrs={'class': 'rounded text-rust focus:ring-rust'}))
    size_1kg = forms.BooleanField(required=False, label="1kg", widget=forms.CheckboxInput(attrs={'class': 'rounded text-rust focus:ring-rust'}))

    SIZE_CONFIG = {
        "sachet": {"label": "Sachet", "grams": 15, "is_sachet": True},
        "50g": {"label": "50g", "grams": 50, "is_sachet": False},
        "250g": {"label": "250g", "grams": 250, "is_sachet": False},
        "500g": {"label": "500g", "grams": 500, "is_sachet": False},
        "1kg": {"label": "1kg", "grams": 1000, "is_sachet": False},
    }

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.existing_blends = Blend.objects.filter(is_active=True).order_by("name")

        for key, conf in self.SIZE_CONFIG.items():
            # Conditionally set form variants based on package rule logic
            forms_for_size = ["beans"] if conf["is_sachet"] else ["beans", "ground"]
            
            for form_type in forms_for_size:
                field_name = f"price_{key}_{form_type}"
                self.fields[field_name] = forms.DecimalField(
                    required=False,
                    min_value=Decimal("0"),
                    max_digits=10,
                    decimal_places=2,
                    label=f"{conf['label']} â€” {form_type.title()} Price",
                    widget=forms.NumberInput(
                        attrs={
                            "class": FIELD_CLASS,
                            "step": "0.01",
                            "min": "0",
                            "placeholder": "e.g. 15000",
                        }
                    ),
                )

    def save(self):
        """
        Processes form fields and safely returns created variants to the view.
        """
        blend_name = self.cleaned_data["blend_input"].strip()
        blend, _ = Blend.objects.get_or_create(name=blend_name, defaults={"is_active": True})

        created_products = []
        existing_products = []

        for key, conf in self.SIZE_CONFIG.items():
            if self.cleaned_data.get(f"size_{key}"):
                
                # --- FIXED: Query strictly by descriptive labels to sidestep gram collisions ---
                if conf["is_sachet"]:
                    pack_size, _ = PackSize.objects.get_or_create(
                        is_sachet =True,
                        defaults={
                            "label": conf['label'],
                            "grams": conf["grams"],
                            "is_sachet": conf["is_sachet"],
                            "is_active": True
                        }
                    )
                else:
                    # Query standard bags strictly by their unique numeric gram allocations
                    pack_size, _ = PackSize.objects.get_or_create(
                        grams=conf["grams"],
                        is_sachet=False,
                        defaults={
                            "label": conf["label"],
                            "is_active": True
                        }
                    )

                forms_for_size = ["beans"] if conf["is_sachet"] else ["beans", "ground"]

                for form_type in forms_for_size:
                    price = self.cleaned_data[f"price_{key}_{form_type}"]

                    product, created = PackagedProduct.objects.get_or_create(
                        blend=blend,
                        pack_size=pack_size,
                        form=form_type,
                        defaults={"selling_price": price, "is_active": True},
                    )

                    if not created:
                        product.selling_price = price
                        product.is_active = True
                        product.save()
                        existing_products.append(product)
                    else:
                        created_products.append(product)

        return blend, created_products, existing_products
    

