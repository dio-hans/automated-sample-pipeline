        <div class="bg-white border border-line rounded-lg p-3.5 shadow-sm">
            <p class="text-[10px] uppercase tracking-wider font-bold text-slate-400">Gross Sales Value</p>
            <p class="font-display text-xl font-bold text-slate-800 mt-1">UGX {{ gross_value_released|floatformat:0|intcomma }}</p>
        </div>
        <div class="bg-white border border-line rounded-lg p-3.5 shadow-sm">
            <p class="text-[10px] uppercase tracking-wider font-bold text-slate-400">Cash Collected</p>
            <p class="font-display text-xl font-bold text-emerald-600 mt-1">UGX {{ cash_collected|floatformat:0|intcomma }}</p>
        </div>
        <div class="bg-white border border-line rounded-lg p-3.5 shadow-sm">
            <p class="text-[10px] uppercase tracking-wider font-bold text-slate-400">Outstanding Debt</p>
            <p class="font-display text-xl font-bold text-rose-600 mt-1">UGX {{ outstanding_receivables|floatformat:0|intcomma }}</p>
        </div>
        <div class="bg-white border border-line rounded-lg p-3.5 shadow-sm">
            <p class="text-[10px] uppercase tracking-wider font-bold text-slate-400">Packs Sold / Returned</p>
            <p class="font-display text-xl font-bold text-slate-800 mt-1">
                {{ total_packs_sold }} <span class="text-xs font-normal text-slate-400">/ {{ total_returned_packs }}</span>
