            </div>
            <div class="divide-y divide-line text-xs">
                {% for debtor in debtors %}
                <div class="px-4 py-2 flex items-center justify-between hover:bg-slate-50/50 transition-colors">
                    <div>
                        <p class="font-semibold text-slate-800">{{ debtor.name }}</p>
                        <p class="text-[10px] text-slate-400">{{ debtor.orders }} active order{% if debtor.orders != 1 %}s{% endif %}</p>
                    </div>
                    <span class="font-bold text-rose-600">
                        UGX {{ debtor.balance|floatformat:0|intcomma }}
                    </span>
                </div>
                {% empty %}
                <p class="px-4 py-6 text-center text-xs text-slate-400">No outstanding balances. 🎉</p>
                {% endfor %}
            </div>
        </div>

    </div>

    <!-- Bottom Row: Stock Levels -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

       

       

    </div>

</div>

{% endblock %}
</file>

<file path="web/templates/pipeline/sample_detail.html">
{% extends "pipeline/base.html" %}

{% block title %}
Sample {{ sample.pk }}
{% endblock %}

{% block breadcrumb %}
Pipeline / Samples / {{ sample.company.name }}
{% endblock %}

{% block page_title %}
Sample Dispatch
{% endblock %}

{% block header_action %}
<div class="flex items-center gap-2">
    <a href="{% url 'sample_update' sample.pk %}"
       class="bg-rust text-white px-4 py-2 rounded-md hover:opacity-90">
        Edit
    </a>
    <a href="{% url 'sample_list' %}"
       class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium
              border border-[#E4DECB] rounded-md
              text-ink hover:bg-white transition">
        ← Back to Samples
    </a>
</div>
{% endblock %}

{% block content %}

<div class="max-w-5xl space-y-6">

    <!-- Status banner -->
    {% if sample.delivery_status == 'failed' %}
    <div class="rounded-md border border-rust-light bg-rust-50 px-4 py-3">
        <p class="font-medium text-rust-dark">Delivery failed</p>
        <p class="text-sm text-rust-dark mt-0.5">
            This sample was not delivered. Follow up with the courier or resend.
        </p>
    </div>
    {% elif sample.delivery_status == 'delivered' %}
    <div class="rounded-md border border-olive/30 bg-olive/10 px-4 py-3">
        <p class="font-medium text-olive">Delivered</p>
        <p class="text-sm text-olive mt-0.5">
            Sample received on {{ sample.delivered_at|date:"d F Y, H:i" }}. Begin follow-up.
        </p>
    </div>
    {% else %}
    <div class="rounded-md border border-gold/30 bg-gold/10 px-4 py-3">
        <p class="font-medium text-gold">In transit</p>
        <p class="text-sm text-gold mt-0.5">
            Sample dispatched via {{ sample.courier_name }}. Awaiting delivery confirmation.
        </p>
    </div>
    {% endif %}


    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Details -->
        <div class="lg:col-span-2 bg-white rounded-lg shadow-sm border">

            <div class="p-4 border-b">
                <h2 class="font-semibold text-lg">
                    Sample Details
                </h2>
            </div>

            <dl class="divide-y">

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Recipient</dt>
                    <dd class="col-span-2 text-sm font-medium">
                        <a href="{% url 'company_detail' sample.company.pk %}"
                           class="text-olive hover:underline">
                            {{ sample.company.name }}
                        </a>
                    </dd>
                </div>

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Coffee</dt>
                    <dd class="col-span-2 text-sm">
                        {{ sample.coffee_stock.variety_name }}
                        <span class="block text-xs text-gray-400 capitalize">
                            {{ sample.coffee_stock.get_coffee_type_display }}
                            &middot; {{ sample.coffee_stock.source }}
                        </span>
                    </dd>
                </div>

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Sample weight</dt>
                    <dd class="col-span-2 text-sm font-medium">
                        {{ sample.sample_weight|floatformat:2 }} kg
                    </dd>
                </div>

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Date sent</dt>
                    <dd class="col-span-2 text-sm">
                        {{ sample.date_sent|date:"d F Y, H:i" }}
                    </dd>
                </div>

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Courier</dt>
                    <dd class="col-span-2 text-sm">
                        {{ sample.courier_name }}
                    </dd>
                </div>

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Tracking number</dt>
                    <dd class="col-span-2 text-sm font-mono text-xs">
                        {{ sample.tracking_number }}
                    </dd>
                </div>

                <div class="px-4 py-3 grid grid-cols-3 gap-4">
                    <dt class="text-sm text-gray-500">Delivered at</dt>
                    <dd class="col-span-2 text-sm">
                        {% if sample.delivered_at %}
                            {{ sample.delivered_at|date:"d F Y, H:i" }}
                        {% else %}
                            <span class="text-gray-400">—</span>
                        {% endif %}
                    </dd>
                </div>

            </dl>

        </div>

        <!-- Snapshot -->
        <div class="space-y-6">

            <div class="bg-white rounded-lg shadow-sm border p-6">
                <p class="eyebrow text-clay">Delivery status</p>
                <div class="mt-2">

                    {% if sample.delivery_status == 'delivered' %}
                        <span class="px-3 py-1 rounded-full text-sm font-medium bg-olive/10 text-olive">
                            Delivered
                        </span>
                    {% elif sample.delivery_status == 'failed' %}
                        <span class="px-3 py-1 rounded-full text-sm font-medium bg-rust/10 text-rust">
                            Failed
                        </span>
                    {% else %}
                        <span class="px-3 py-1 rounded-full text-sm font-medium bg-gold/10 text-gold">
                            In Transit
                        </span>
                    {% endif %}

                </div>
            </div>

            <div class="bg-white rounded-lg shadow-sm border p-6">
                <p class="eyebrow text-clay">Sample ID</p>
                <p class="font-mono text-xs mt-1 break-all text-gray-500">
                    {{ sample.pk }}
                </p>

                <div class="mt-4 pt-4 border-t border-[#E4DECB]">
                    <p class="eyebrow text-clay">Company stage</p>
                    <p class="text-sm mt-1">
                        {{ sample.company.get_pipeline_stage_display }}
                    </p>
                </div>
            </div>

        </div>

    </div>

</div>

{% endblock %}
</file>

<file path="web/templates/reports/print/finance.html">
{% extends "reports/print/base.html" %}
{% load humanize %}

{% block print_title %}
Finance & Credit Report | Nonda Commodities
{% endblock %}

{% block report_name %}
Finance & Credit Report
{% endblock %}


{% block report_content %}

<!-- =========================================================
     FINANCIAL SUMMARY
     ========================================================= -->
<section class="section avoid-break">

    <h2 class="section-title">
        Financial Summary
    </h2>

    <div class="kpis">

        <div class="kpi">
            <div class="kpi-label">
                Collections
            </div>

            <div class="kpi-value green">
                UGX {{ collections_total|floatformat:0|intcomma }}
            </div>

            <div class="kpi-note">
                {{ payment_count }} recorded receipt{{ payment_count|pluralize }}
            </div>
        </div>


        <div class="kpi">
            <div class="kpi-label">
                Expenses
            </div>

            <div class="kpi-value red">
                UGX {{ expense_total|floatformat:0|intcomma }}
            </div>

            <div class="kpi-note">
                Recorded during {{ period_label }}
            </div>
        </div>


        <div class="kpi">
            <div class="kpi-label">
                Collections Less Expenses
            </div>

            <div class="kpi-value">
                UGX {{ cash_less_expenses|floatformat:0|intcomma }}
            </div>

            <div class="kpi-note">
                Cash movement indicator — not net profit
            </div>
        </div>


        <div class="kpi">
            <div class="kpi-label">
                Outstanding Packaged Debt
            </div>

            <div class="kpi-value amber">
                UGX {{ outstanding_receivables|floatformat:0|intcomma }}
            </div>

            <div class="kpi-note">
                Current unpaid packaged-sales balance
            </div>
        </div>

    </div>

</section>


<!-- =========================================================
     COLLECTIONS + EXPENDITURE
     ========================================================= -->
<section class="section two-column avoid-break">

    <div class="panel">

        <h2 class="section-title">
            Collections by Payment Method
        </h2>

        <table>

            <thead>
                <tr>
                    <th>Method</th>
                    <th class="right">Amount</th>
                </tr>
            </thead>

            <tbody>

                {% for row in payment_methods %}

                    <tr>
                        <td>{{ row.label }}</td>

                        <td class="right">
                            <strong>
                                UGX {{ row.amount|floatformat:0|intcomma }}
                            </strong>
                        </td>
                    </tr>

                {% empty %}

                    <tr>
                        <td colspan="2" class="center">
                            No collections recorded.
                        </td>
                    </tr>

                {% endfor %}

            </tbody>

        </table>

    </div>


    <div class="panel">

        <h2 class="section-title">
            Expenditure Ranking
        </h2>

        <table>

            <thead>
                <tr>
                    <th>Category</th>
                    <th class="right">Amount</th>
                </tr>
            </thead>

            <tbody>

                {% for row in expense_ranking %}

                    <tr>
                        <td>{{ row.label }}</td>

                        <td class="right">
                            <strong>
                                UGX {{ row.total|floatformat:0|intcomma }}
                            </strong>
                        </td>
                    </tr>

                {% empty %}

                    <tr>
                        <td colspan="2" class="center">
                            No expenditure recorded.
                        </td>
                    </tr>

                {% endfor %}

            </tbody>

        </table>

    </div>

</section>


<!-- =========================================================
     DEBTORS
     ========================================================= -->
<section class="section avoid-break">

    <h2 class="section-title">
        Outstanding Debtors
    </h2>

    <table>

        <thead>
            <tr>
                <th>Account</th>
                <th class="center">Releases</th>
                <th class="right">Outstanding Balance</th>
            </tr>
        </thead>

        <tbody>

            {% for row in debtors %}

                <tr>
                    <td>
                        <strong>{{ row.name }}</strong>
                    </td>

                    <td class="center">
                        {{ row.invoices }}
                    </td>

                    <td class="right">
                        UGX {{ row.balance|floatformat:0|intcomma }}
                    </td>
                </tr>

            {% empty %}

                <tr>
                    <td colspan="3" class="center">
                        No outstanding debtor balances.
                    </td>
                </tr>

            {% endfor %}

        </tbody>

    </table>

</section>


<!-- =========================================================
     DEBT AGEING
     ========================================================= -->
<section class="section avoid-break">

    <h2 class="section-title">
        Debt Ageing
    </h2>

    <table>

        <thead>
            <tr>
                <th>Age Bucket</th>
                <th class="right">Outstanding Amount</th>
            </tr>
        </thead>

        <tbody>

            {% for row in ageing %}

                <tr>
                    <td>{{ row.label }}</td>

                    <td class="right">
                        <strong>
                            UGX {{ row.amount|floatformat:0|intcomma }}
                        </strong>
                    </td>
                </tr>

            {% endfor %}

        </tbody>

    </table>

    <div class="note">
        {{ ageing_basis }}
    </div>

</section>


<!-- =========================================================
     DAILY COLLECTIONS
     ========================================================= -->
<section class="section">

    <h2 class="section-title">
        Daily Collections
    </h2>

    <table>

        <thead>
            <tr>
                <th>Date</th>
                <th class="right">Amount Collected</th>
            </tr>
        </thead>

        <tbody>

            {% for row in collection_days %}

                <tr>
                    <td>{{ row.date }}</td>

                    <td class="right">
                        <strong>
                            UGX {{ row.amount|floatformat:0|intcomma }}
                        </strong>
                    </td>
                </tr>

            {% empty %}

                <tr>
                    <td colspan="2" class="center">
                        No collections in this period.
                    </td>
                </tr>

            {% endfor %}

        </tbody>

    </table>

</section>


{% if unallocated_credit %}

<section class="section avoid-break">

    <div class="panel">

        <strong>Unallocated Credit:</strong>

        UGX {{ unallocated_credit|floatformat:0|intcomma }}

        <div class="note">
            Payments recorded in excess of currently matched packaged sales.
        </div>

    </div>

</section>

{% endif %}


<div class="note">

    <strong>Accounting note:</strong>
    Collections and expenditure relate to the selected reporting period.
    Outstanding packaged debt is a current balance snapshot and is not a
    profitability calculation.

</div>

{% endblock report_content %}
</file>

<file path="web/templates/reports/executive_print.html">
{% load humanize %}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        Executive Management Report - {{ period_label }}
    </title>


    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f7f5ee;
            color: #1f2937;
            font-family:
                Arial,
                Helvetica,
                sans-serif;
            font-size: 11px;
        }

        .page {
            width: min(1100px, calc(100% - 24px));
            margin: 12px auto;
            background: #ffffff;
            border: 1px solid #ded8ca;
            border-radius: 8px;
            padding: 18px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ded8ca;
        }

        h1,
        h2,
        h3,
        p {
            margin: 0;
        }

        h1 {
            font-size: 16px;
            letter-spacing: 1px;
        }

        .subtitle {
            margin-top: 3px;
            font-weight: 600;
            color: #475569;
        }

        .muted {
            margin-top: 3px;
            font-size: 9px;
            color: #94a3b8;
        }

        .actions {
            display: flex;
            gap: 6px;
        }

        .btn {
            display: inline-block;
            border: 1px solid #d6d3d1;
            border-radius: 5px;
            padding: 6px 9px;
            background: white;
            font-size: 10px;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-primary {
            color: white;
            background: #1f2937;
            border-color: #1f2937;
        }

        .section {
            margin-top: 12px;
        }

        .section-title {
            padding-bottom: 5px;
            margin-bottom: 6px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .7px;
        }

        .scorecard {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
        }

        .metric {
            padding: 7px;
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 5px;
        }

        .metric-label {
            font-size: 8px;
            color: #64748b;
            text-transform: uppercase;
        }

        .metric-value {
            margin-top: 3px;
            font-size: 11px;
            font-weight: 700;
        }

        .two-column {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .box {
            border: 1px solid #e5e7eb;
            border-radius: 5px;
            padding: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #f8fafc;
            color: #64748b;
            font-size: 8px;
            text-transform: uppercase;
            text-align: left;
        }

        th,
        td {
            border-bottom: 1px solid #eef0f2;
            padding: 4px 5px;
            vertical-align: top;
        }

        .right {
            text-align: right;
        }

        .green {
            color: #047857;
        }

        .red {
            color: #be123c;
        }

        .amber {
            color: #b45309;
        }

        .alert {
            padding: 4px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .footnote {
            margin-top: 12px;
            padding-top: 7px;
            border-top: 1px solid #e5e7eb;
            color: #64748b;
            font-size: 8px;
            line-height: 1.35;
        }


        @media (max-width: 700px) {

            .page {
                width: calc(100% - 12px);
                margin: 6px;
                padding: 10px;
            }

            .header {
                flex-direction: column;
            }

            .scorecard {
                grid-template-columns: repeat(2, 1fr);
            }

            .two-column {
                grid-template-columns: 1fr;
            }

            .table-scroll {
                overflow-x: auto;
            }

            table {
                min-width: 620px;
            }
        }


        @media print {

            @page {
                size: A4;
                margin: 10mm;
            }

            body {
                background: white;
                font-size: 9px;
            }

            .page {
                width: 100%;
                margin: 0;
                border: 0;
                border-radius: 0;
                padding: 0;
            }

            .no-print {
                display: none !important;
            }

            .avoid-break {
                break-inside: avoid;
            }

            .section {
                margin-top: 8px;
            }

            .scorecard {
                gap: 4px;
            }

            .metric {
                padding: 5px;
            }

            th,
            td {
                padding: 3px 4px;
            }
        }

    </style>

</head>


<body>

<div class="page">


    <!-- =====================================================
         HEADER
         ===================================================== -->
    <div class="header">

        <div>

            <h1>
                NONDA COMMODITIES
            </h1>

            <p class="subtitle">
                Executive Management Report · {{ period_label }}
            </p>

            <p class="muted">
                Receivables and open work are current snapshots.
            </p>

        </div>


        <div class="actions no-print">

            <button
                type="button"
                onclick="window.print()"
                class="btn btn-primary"
            >
                Print / Save PDF
            </button>

            <button
                type="button"
                onclick="window.history.back()"
                class="btn"
            >
                Back
            </button>

        </div>

    </div>


    <!-- =====================================================
         SCORECARD
         ===================================================== -->
    <section class="section avoid-break">

        <h2 class="section-title">
            Management Scorecard
        </h2>


        <div class="scorecard">

            <div class="metric">

                <div class="metric-label">
                    Confirmed Sales
                </div>

                <div class="metric-value">

                    {% if sales_comparison.current is not None %}
                        UGX {{ sales_comparison.current|floatformat:0|intcomma }}
                    {% else %}
                        R3 mapping pending
                    {% endif %}

                </div>

            </div>


            <div class="metric">

                <div class="metric-label">
                    Collections
                </div>

                <div class="metric-value green">
                    UGX {{ executive_finance.collections_total|floatformat:0|intcomma }}
                </div>

            </div>


            <div class="metric">

                <div class="metric-label">
                    Expenses
                </div>

                <div class="metric-value red">
                    UGX {{ executive_finance.expense_total|floatformat:0|intcomma }}
                </div>

            </div>


            <div class="metric">

                <div class="metric-label">
                    Outstanding Packaged Debt
                </div>

                <div class="metric-value">
                    UGX {{ executive_finance.outstanding_receivables|floatformat:0|intcomma }}
                </div>

            </div>


            <div class="metric">

                <div class="metric-label">
                    Coffee Consumption
                </div>

                <div class="metric-value">
                    {{ executive_consumption.total_consumed_kg|floatformat:2|intcomma }}
                    kg
                </div>

            </div>


            <div class="metric">

                <div class="metric-label">
                    Processing Yield
                </div>

                <div class="metric-value green">
                    {{ executive_operations.processing.yield_pct }}%
                </div>

            </div>


            <div class="metric">

                <div class="metric-label">
                    Packaging Output
                </div>

                <div class="metric-value">
                    {{ executive_operations.packaging.packs_produced|intcomma }}
                    packs
                </div>

            </div>


            <div class="metric">

                <div class="metric-label">
                    Open Runs / Exceptions
                </div>

                <div class="metric-value amber">

                    {{ executive_operations.open_processing_count|add:executive_operations.open_packaging_count }}

                    /

                    {{ executive_operations.exception_count }}

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         PERIOD COMPARISON
         ===================================================== -->
    <section class="section avoid-break">

        <div style="display:flex; justify-content:space-between; gap:10px;">

            <h2 class="section-title" style="flex:1;">
                Comparison
            </h2>

            <span style="font-size:8px; color:#64748b;">
                {{ comparison_label }}
            </span>

        </div>


        <div class="table-scroll">

            <table>

                <thead>

                    <tr>
                        <th>Metric</th>
                        <th class="right">Current</th>
                        <th class="right">Previous</th>
                        <th class="right">Change</th>
                    </tr>

                </thead>


                <tbody>

                    {% for label, metric in comparison_rows %}

                        <tr>

                            <td>
                                <strong>{{ label }}</strong>
                            </td>

                            <td class="right">
                                {{ metric.current|default_if_none:"Not mapped" }}
                            </td>

                            <td class="right">
                                {{ metric.previous|default_if_none:"N/A" }}
                            </td>

                            <td class="right">

                                {% if metric.percent is not None %}
                                    {{ metric.percent }}%
                                {% else %}
                                    N/A
                                {% endif %}

                            </td>

                        </tr>

                    {% empty %}

                        <tr>
                            <td colspan="4">
                                No comparison metrics available.
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </section>


    <!-- =====================================================
         COLLECTIONS + EXPENSES
         ===================================================== -->
    <section class="section two-column avoid-break">


        <div class="box">

            <h3 class="section-title">
                Collection Methods
            </h3>

            <table>

                <thead>
                    <tr>
                        <th>Method</th>
                        <th class="right">UGX</th>
                    </tr>
                </thead>

                <tbody>

                    {% for x in executive_finance.payment_methods %}

                        <tr>
                            <td>{{ x.label }}</td>

                            <td class="right">
                                <strong>
                                    {{ x.amount|floatformat:0|intcomma }}
                                </strong>
                            </td>
                        </tr>

                    {% empty %}

                        <tr>
                            <td colspan="2">
                                No collections recorded.
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>


        <div class="box">

            <h3 class="section-title">
                Expenditure Ranking
            </h3>

            <table>

                <thead>
                    <tr>
                        <th>Category</th>
                        <th class="right">UGX</th>
                    </tr>
                </thead>

                <tbody>

                    {% for x in executive_finance.expense_ranking %}

                        <tr>
                            <td>{{ x.label }}</td>

                            <td class="right">
                                <strong>
                                    {{ x.total|floatformat:0|intcomma }}
                                </strong>
                            </td>
                        </tr>

                    {% empty %}

                        <tr>
                            <td colspan="2">
                                No expenses recorded.
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </section>


    <!-- =====================================================
         DEBT + CONSUMPTION
         ===================================================== -->
    <section class="section two-column avoid-break">


        <div class="box">

            <h3 class="section-title">
                Debt & Ageing
            </h3>

            {% for x in executive_finance.ageing %}

                <div style="
                    display:flex;
                    justify-content:space-between;
                    gap:10px;
                    padding:3px 0;
                    border-bottom:1px solid #f1f5f9;
                ">

                    <span>
                        {{ x.label }}
                    </span>

                    <strong>
                        UGX {{ x.amount|floatformat:0|intcomma }}
                    </strong>

                </div>

            {% endfor %}


            <h3 class="section-title" style="margin-top:8px;">
                Top Debtors
            </h3>

            {% for x in executive_finance.debtors|slice:":10" %}

                <div style="
                    display:flex;
                    justify-content:space-between;
                    gap:10px;
                    padding:3px 0;
                    border-bottom:1px solid #f1f5f9;
                ">

                    <span>
                        {{ x.name }}
                    </span>

                    <strong>
                        UGX {{ x.balance|floatformat:0|intcomma }}
                    </strong>

                </div>

            {% empty %}

                <p class="muted">
                    No confirmed debtor balances.
                </p>

            {% endfor %}

        </div>


        <div class="box">

            <h3 class="section-title">
                Coffee Consumption
            </h3>

            <table>

                <thead>
                    <tr>
                        <th>Category</th>
                        <th class="right">kg</th>
                    </tr>
                </thead>

                <tbody>

                    {% for x in executive_consumption.breakdown %}

                        <tr>
                            <td>{{ x.label }}</td>

                            <td class="right">
                                <strong>
                                    {{ x.kg|floatformat:2|intcomma }}
                                </strong>
                            </td>
                        </tr>

                    {% empty %}

                        <tr>
                            <td colspan="2">
                                No consumption entries recorded.
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </section>


    <!-- =====================================================
         OPERATIONS
         ===================================================== -->
    <section class="section avoid-break">

        <h3 class="section-title">
            Processing Operations
        </h3>


        <div class="table-scroll">

            <table>

                <thead>

                    <tr>
                        <th>Operation</th>
                        <th class="right">Input kg</th>
                        <th class="right">Output kg</th>
                        <th class="right">Loss kg</th>
                        <th class="right">Yield</th>
                    </tr>

                </thead>


                <tbody>

                    {% for x in executive_operations.process_rows %}

                        <tr>

                            <td>
                                <strong>{{ x.name }}</strong>
                            </td>

                            <td class="right">
                                {{ x.input_kg|floatformat:2|intcomma }}
                            </td>

                            <td class="right green">
                                {{ x.output_kg|floatformat:2|intcomma }}
                            </td>

                            <td class="right amber">
                                {{ x.loss_kg|floatformat:2|intcomma }}
                            </td>

                            <td class="right">
                                <strong>{{ x.yield_pct }}%</strong>
                            </td>

                        </tr>

                    {% empty %}

                        <tr>
                            <td colspan="5">
                                No processing operations in this period.
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </section>


    <!-- =====================================================
         ALERTS
         ===================================================== -->
    <section class="section box avoid-break">

        <h3 class="section-title">
            Management Alerts
        </h3>

        {% for x in executive_alerts %}

            <div class="alert">

                <strong>
                    {{ x.title }}
                </strong>

                —
                {{ x.detail }}

            </div>

        {% empty %}

            <p class="muted">
                No current rule-based alerts.
            </p>

        {% endfor %}

    </section>


    <div class="footnote">

        Profitability figures remain excluded pending reliable cost accounting.
        Bulk receivables remain excluded where payment linkage has not been verified.
        Collections are based on recorded payment timestamps.

    </div>

</div>

</body>

</html>
