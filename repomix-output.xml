                                       text-right text-[11px] outline-none
                                       focus:border-olive"
                            >

                        </td>

                        <td class="px-2 py-2 border-l border-line/60">

                            <input
                                type="number"
                                min="0"
                                value="0"
                                name="shrinkage_shelf_{{ inv.product_id }}"
                                class="shrink-shelf mx-auto block h-7 w-16
                                       rounded-md border border-line px-1.5
                                       text-right text-[11px] outline-none
                                       focus:border-olive"
                            >

                        </td>

                        <td class="px-2 py-2">

                            <input
                                type="number"
                                min="0"
                                value="0"
                                name="shrinkage_backroom_{{ inv.product_id }}"
                                class="shrink-backroom mx-auto block h-7 w-16
                                       rounded-md border border-line px-1.5
                                       text-right text-[11px] outline-none
                                       focus:border-olive"
                            >

                        </td>

                        <td class="px-2 py-2 border-l border-line/60">

                            <input
                                type="number"
                                min="0"
                                step="0.01"
                                required
                                value="{{ inv.audit_price }}"
                                name="selling_price_{{ inv.product_id }}"
                                class="unit-price ml-auto block h-7 w-24
                                       rounded-md border border-line px-1.5
                                       text-right text-[11px] outline-none
                                       focus:border-olive"
