<file path="web/templates/pipeline/stock_movement_list.html">
{% extends "pipeline/base.html" %}
{% load pipeline_tags humanize %}

{% block title %}Movement Ledger | Nonda{% endblock %}

{% block content %}
<div class="space-y-3">

    <!-- TOP BAR: BREADCRUMB + PAGE TITLE -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-1 border-b border-[#E4DECB]">
        <div>
            <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                Inventory / Movement Ledger
            </div>
            <h1 class="text-base font-bold text-slate-800 leading-tight">
                Movement Ledger
            </h1>
        </div>
    </div>

    <!-- NAVIGATION TABS -->
        <!-- =========================================================
         2. LIVE DATE CONTROL FILTER DASHBOARD BAR
         ========================================================= -->
     {% include "reports/components/report_filters.html" %}


    <!-- MOVEMENT LEDGER TABLE -->
    <div class="bg-white border border-[#E4DECB] rounded-lg shadow-2xs overflow-hidden">
        <div class="px-3 py-2 bg-slate-50/80 border-b border-[#E4DECB] flex items-center justify-between">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Inventory Movements</h2>
            <span class="text-[11px] text-slate-400">Complete historical record of stock movements</span>
        </div>
        <div class="overflow-x-auto w-full">
           <table class="w-full text-xs text-left border-collapse bg-white min-w-[850px]">
    <thead>
        <tr class="bg-slate-100 border-b border-[#E4DECB] text-slate-600 font-semibold uppercase text-[10px] tracking-wider">
            <th class="px-3 py-2.5">Date & Time</th>
            <th class="px-3 py-2.5">Batch</th>
            <th class="px-3 py-2.5">Movement Type</th>
            <th class="px-3 py-2.5">Stage Flow</th>
            <th class="px-3 py-2.5 text-right">Quantity</th>
            <th class="px-3 py-2.5 text-right">Processing Loss</th>
            <th class="px-3 py-2.5">Recorded By</th>
            <th class="px-3 py-2.5">Reference / Notes</th>
        </tr>
    </thead>
    <tbody class="divide-y divide-[#E4DECB] text-slate-700">
        {% for movement in movements %}
        <tr class="hover:bg-slate-50/80 transition">
            <!-- Date -->
            <td class="px-3 py-2 text-slate-400 font-medium whitespace-nowrap">
                {{ movement.created_at|date:"d M Y, H:i" }}
            </td>

            <!-- Batch -->
            <td class="px-3 py-2 whitespace-nowrap">
                {% if movement.stock %}
                    <a href="{% url 'stock_detail' movement.stock.pk %}" class="font-mono text-xs font-bold text-rust hover:underline">
                        {{ movement.stock.batch_number }}
                    </a>
                    <p class="text-[10px] text-slate-400 leading-tight">
                        {{ movement.stock.variety_name }}
                    </p>
                {% else %}
                    <span class="font-mono text-xs text-slate-400 italic">No linked stock</span>
                {% endif %}
            </td>

            <!-- Movement Type Badge -->
            <td class="px-3 py-2 whitespace-nowrap">
                {% if "COMPLETE" in movement.movement_type or "RECEIVED" in movement.movement_type %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        IN • {{ movement.get_movement_type_display }}
                    </span>
                {% elif "ISSUED" in movement.movement_type or "SAMPLE" in movement.movement_type %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        OUT • {{ movement.get_movement_type_display }}
                    </span>
                {% elif "LOSS" in movement.movement_type or "QUAKER" in movement.movement_type %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        LOSS • {{ movement.get_movement_type_display }}
                    </span>
                {% else %}
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600">
                        {{ movement.get_movement_type_display }}
                    </span>
                {% endif %}
            </td>

            <!-- Consolidated Stage Flow -->
            <td class="px-3 py-2 font-medium text-slate-600 whitespace-nowrap">
                {% if movement.from_stage and movement.to_stage %}
                    {{ movement.from_stage }} <span class="text-slate-300">→</span> {{ movement.to_stage }}
                {% elif movement.to_stage %}
                    <span class="text-slate-400">Into</span> {{ movement.to_stage }}
                {% elif movement.from_stage %}
                    <span class="text-slate-400">From</span> {{ movement.from_stage }}
                {% else %}
                    <span class="text-slate-300">—</span>
                {% endif %}
            </td>

            <!-- Quantity with Directional Sign (+ / -) -->
            <td class="px-3 py-2 text-right font-mono font-bold whitespace-nowrap">
                {% if "ISSUED" in movement.movement_type or "LOSS" in movement.movement_type or "SAMPLE" in movement.movement_type %}
                    <span class="text-amber-700">- {{ movement.quantity|floatformat:2 }} kg</span>
                {% else %}
                    <span class="text-emerald-700">+ {{ movement.quantity|floatformat:2 }} kg</span>
                {% endif %}
            </td>

            <!-- Processing Loss -->
        <td class="px-3 py-2 text-right font-mono font-bold whitespace-nowrap">
            {% if movement.movement_type == "loss" %}
                <span class="text-rose-700">
                    {{ movement.quantity|floatformat:2 }} kg
                </span>
            {% else %}
                <span class="text-slate-300">—</span>
            {% endif %}
        </td>

            <!-- Recorded By (Preserving movement.created_by) -->
            <td class="px-3 py-2 text-slate-600 font-medium whitespace-nowrap">
                {% if movement.created_by %}
                    {{ movement.created_by.username }}
                {% else %}
                    <span class="text-slate-400 italic">System</span>
                {% endif %}
            </td>

            <!-- Reference / Notes -->
            <td class="px-3 py-2 text-slate-500 text-[11px] max-w-[200px] truncate">
                {% if movement.reference %}
                    <span class="font-mono text-slate-600">{{ movement.reference }}</span>
                {% endif %}
                {% if movement.notes %}
                    <span class="block text-slate-400 text-[10px]">{{ movement.notes }}</span>
                {% endif %}
                {% if not movement.reference and not movement.notes %}
                    <span class="text-slate-300">—</span>
                {% endif %}
            </td>
        </tr>
        {% empty %}
        <tr>
            <td colspan="7" class="px-3 py-8 text-center text-slate-400 italic">
                No stock movements recorded.
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
        </div>
    </div>

</div>
{% endblock %}
</file>

<file path="web/templates/pipeline/login.html">
{% extends 'pipeline/base.html' %}


{% load crispy_forms_tags static %}

{% block sidebar_wrapper %}
{% endblock sidebar_wrapper %}

{% block topbar %}
{% endblock %}

{% block extra_head %}
<style>
    /* =====================================================
       LOGIN view password styles
       ===================================================== *
       /* Password visibility toggle button positioning */
.password-toggle-btn {
    position: absolute;
    right: 0.875rem;
    bottom: 0.55rem;
    color: #94A3B8;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    font-size: 0.875rem;
    transition: color 0.2s ease;
    z-index: 10;
}
.password-toggle-btn:hover {
    color: #3A5333;
}


    /* 1. Force remove browser scrollbars on the login page */
    html, body {
        overflow: hidden !important;
        height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
        padding: 0!important
    }

    /* 2. Compact styling for Crispy Form non-field errors */
    .login-card .alert-danger,
    .login-card .alert-block,
    .login-card .asteriskField + .alert,
    .login-card div.alert {
        background-color: #FEF2F2 !important;
        border: 1px solid #FECDD3 !important;
        color: #9F1239 !important;
        font-size: 0.75rem !important;
        line-height: 1.35 !important;
        padding: 0.625rem 0.875rem !important;
        border-radius: 0.5rem !important;
        margin-bottom: 0.75rem !important;
    }

    .login-card .alert ul { margin: 0 !important; padding: 0 !important; list-style: none !important; }
    .login-card .alert li { margin: 0 !important; padding: 0 !important; }

    /* Input & FontAwesome icon styling */
    .login-card input {
        border-color: #E4DECB !important;
        background-color: #F9FAFB !important;
        color: #211815 !important;
        border-radius: 0.5rem !important;
        padding-left: 2.5rem !important;
        padding-top: 0.5rem !important;
        padding-bottom: 0.5rem !important;
        font-size: 0.875rem !important;
        transition: all 0.2s ease;
    }

    .login-card input:focus {
        outline: none !important;
        background-color: #FFFFFF !important;
        border-color: #3A5333 !important;
        box-shadow: 0 0 0 3px rgba(58, 83, 51, 0.15) !important;
    }

    .login-card label {
        font-family: 'Inter', sans-serif;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #8A6F63;
        margin-bottom: 0.25rem;
        display: block;
    }

    .login-card #div_id_username,
    .login-card #div_id_password {
        position: relative;
    }

    .login-card #div_id_username::after {
        content: "\f007";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        position: absolute;
        left: 0.875rem;
        bottom: 0.55rem;
        color: #94A3B8;
        font-size: 0.875rem;
        pointer-events: none;
    }

    .login-card #div_id_password::after {
        content: "\f023";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        position: absolute;
        left: 0.875rem;
        bottom: 0.55rem;
        color: #94A3B8;
        font-size: 0.875rem;
        pointer-events: none;
    }

    .login-submit-spinner {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        border: 2px solid #2563EB;
        border-right-color: transparent;
        border-radius: 50%;
        animation: login-submit-spin 0.7s linear infinite;
    }

    html.login-submitting,
    html.login-submitting * {
        cursor: wait !important;
    }

    @keyframes login-submit-spin {
        to { transform: rotate(360deg); }
    }
</style>
<script>
    function lockLoginSubmit(event, form) {
        if (form.dataset.submitting === "true") {
            event.preventDefault();
            return false;
        }

        form.dataset.submitting = "true";
        form.setAttribute("aria-busy", "true");
        document.documentElement.classList.add("login-submitting");

        const button = event.submitter || form.querySelector('button[type="submit"]');
        if (button) {
            button.disabled = true;
            button.setAttribute("aria-busy", "true");
            button.setAttribute("aria-label", "Signing in");

            const spinner = document.createElement("span");
            spinner.className = "login-submit-spinner";
            spinner.setAttribute("aria-hidden", "true");
            button.prepend(spinner);

            const label = button.querySelector("[data-login-label]");
            if (label) label.textContent = "Signing in...";
        }

        return true;
    }
</script>
{% endblock %}

{% block title %}Sign In · Nonda Commodities{% endblock %}

{% block content %}
<!-- Margin offset (-ml-12 sm:-ml-24 md:-ml-32) pushes the login card smoothly to the left -->
<div class="h-screen w-full overflow-hidden flex flex-col items-center justify-center -ml-12 sm:-ml-24 md:-ml-32 p-2">

    <div class="w-full max-w-md">

        <!-- Login card -->
        <div class="login-card bg-white border border-[#E4DECB] rounded-2xl shadow-xl overflow-hidden">

            <!-- Card header -->
            <div class="px-8 py-5 border-b border-[#E4DECB]" style="background-color: #3A5333;">
                <h3 class="font-serif text-xl font-bold text-white tracking-wide">
                    Nonda Sign in
                </h3>
                <p class="text-xs text-emerald-100/80 mt-0.5">
                    Enter your credentials to access stock management
                </p>
            </div>

            <div class="p-6 sm:p-8 space-y-5">

                <!-- EMBEDDED SYSTEM MESSAGES -->
                {% if messages %}
                <div class="space-y-2.5">
                    {% for message in messages %}
                        <div class="flex items-center justify-between p-3.5 px-4 rounded-xl text-xs font-medium border shadow-2xs transition-all duration-200
                            {% if message.tags == 'success' %}
                                bg-emerald-50 text-emerald-800 border-emerald-200
                            {% elif message.tags == 'error' or message.tags == 'danger' %}
                                bg-rose-50 text-rose-800 border-rose-200
                            {% elif message.tags == 'warning' %}
                                bg-amber-50 text-amber-800 border-amber-200
                            {% else %}
                                bg-sky-50 text-sky-800 border-sky-200
                            {% endif %}">
                            
                            <div class="flex items-center gap-2.5">
                                <span class="text-sm shrink-0">
                                    {% if message.tags == 'success' %}
                                        <i class="fa-solid fa-circle-check text-emerald-600"></i>
                                    {% elif message.tags == 'error' or message.tags == 'danger' %}
                                        <i class="fa-solid fa-circle-xmark text-rose-600"></i>
                                    {% elif message.tags == 'warning' %}
                                        <i class="fa-solid fa-triangle-exclamation text-amber-600"></i>
                                    {% else %}
                                        <i class="fa-solid fa-circle-info text-sky-600"></i>
                                    {% endif %}
                                </span>
                                <span>{{ message }}</span>
                            </div>

                            <button type="button" 
                                    onclick="this.closest('.flex').remove()" 
                                    class="ml-3 text-slate-400 hover:text-slate-600 transition cursor-pointer">
                                <i class="fa-solid fa-xmark text-xs"></i>
                            </button>
                        </div>
                    {% endfor %}
                </div>
                {% endif %}

                <!-- LOGIN FORM -->
                <form method="POST"
                      action=""
                      autocomplete="off"
                      novalidate
                      data-submit-guard="inline"
                      onsubmit="return lockLoginSubmit(event, this)"
                      class="space-y-4">

                    {% csrf_token %}

                    <div class="space-y-4">
                        {{ form|crispy }}
                    </div>

                    <div class="flex items-center justify-end pt-1">
                        <a href="{% url 'forgot_password' %}"
                           class="text-xs font-medium text-slate-500 hover:text-orange-600 transition">
                            Forgot password?
                        </a>
                    </div>

                    <div class="pt-2">
                        <button type="submit"
                                class="w-full bg-orange-600 hover:bg-orange-700 text-white font-bold
                                       py-3 rounded-xl text-xs uppercase tracking-wider
                                       transition-all shadow-sm flex items-center justify-center gap-2
                                       cursor-pointer active:scale-[0.99]">
                            <i class="fa-solid fa-right-to-bracket text-sm"></i>
                            <span data-login-label>Sign In</span>
                        </button>
                    </div>

                </form>

            </div>

        </div>

        <p class="mt-4 text-center text-xs text-slate-400 font-medium">
            Nonda Commodities &bull; 2026
        </p>

    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const passwordContainer = document.getElementById('div_id_password');
        const passwordInput = document.getElementById('id_password');

        if (passwordContainer && passwordInput) {
            // Add right padding so typed text doesn't overlap the eye icon
            passwordInput.style.paddingRight = '2.5rem';

            // Create toggle button
            const toggleBtn = document.createElement('button');
            toggleBtn.type = 'button';
            toggleBtn.className = 'password-toggle-btn';
            toggleBtn.setAttribute('aria-label', 'Toggle password visibility');
            toggleBtn.innerHTML = '<i class="fa-solid fa-eye"></i>';

            // Append button inside the password container
            passwordContainer.appendChild(toggleBtn);

            // Toggle input type and icon on click
            toggleBtn.addEventListener('click', function () {
                const isPassword = passwordInput.getAttribute('type') === 'password';
                passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                
                const icon = toggleBtn.querySelector('i');
                if (isPassword) {
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                } else {
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            });
        }
    });
</script>

{% block footer %}
{% endblock %}

{% endblock %}
</file>

