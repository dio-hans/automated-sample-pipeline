        self.assertEqual(CoffeeStock.objects.count(), 1)

        stock = CoffeeStock.objects.get()

        self.assertEqual(stock.quantity_received, Decimal("620.00"))
        self.assertEqual(stock.quantity_available, Decimal("620.00"))

