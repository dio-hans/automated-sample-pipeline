                {% endfor %}
            </div>
        {% endif %}

        <!-- Tabbed Container -->
        <div class="bg-white border border-[#E4DECB] rounded-xl shadow-sm overflow-hidden" x-data="{ activeTab: 'identity' }">
            
            <!-- Tab Navigation Bar -->
            <!-- Sticky Tab Navigation Bar -->
<div class="sticky top-0 z-20 flex border-b border-[#E4DECB] bg-white/95 backdrop-blur-sm text-xs font-semibold overflow-x-auto">
    <button type="button" 
            @click.prevent="activeTab = 'identity'" 
            :class="activeTab === 'identity' ? 'text-orange-600 border-b-2 border-orange-500 bg-orange-50/30' : 'text-slate-500 hover:text-slate-800 hover:bg-slate-50'" 
            class="px-5 py-3 transition-all whitespace-nowrap focus:outline-none flex items-center gap-2">
