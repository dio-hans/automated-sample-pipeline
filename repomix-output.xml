        for name, field in self.fields.items():

            if isinstance(field.widget, forms.Select):
                field.widget.attrs.update({
                    "class": select_class,
                })

            elif isinstance(field.widget, forms.Textarea):
                field.widget.attrs.update({
                    "class": textarea_class,
                    "rows": 2,
