                <p class="text-xl font-black text-slate-800 leading-tight">
                    {{ stock.quantity_available|floatformat:2 }} <span class="text-xs font-semibold text-slate-400">Kg</span>
                </p>
            </div>
            <span class="text-[10px] bg-orange-50 text-orange-700 px-1.5 py-0.5 rounded font-medium border border-orange-200">Active</span>
        </div>

        <!-- Green -->
