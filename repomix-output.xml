      <section class="lg:col-span-7 bg-white border border-slate-200 rounded-lg p-3 shadow-2xs flex flex-col justify-between">
          <div class="space-y-3">
              <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                  <div>
                      <h2 class="text-xs font-bold text-slate-900 tracking-tight">Warehouse Breakdown</h2>
                      <p class="text-[10px] text-slate-400">Live operational summary of raw vs processed bulk inventory.</p>
                  </div>
                  <span class="text-[9px] font-mono text-slate-400 bg-slate-50 px-1.5 py-0.5 rounded border border-slate-100">KG NET</span>
              </div>
              <!-- 3-Column Stock Display -->
              <div class="grid grid-cols-3 gap-2">
