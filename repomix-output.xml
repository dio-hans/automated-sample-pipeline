        {{ stock.batch_number }}
    </span>
</div>
{% endblock %}

{% block header_action %}
<div class="flex items-center gap-2">
    <a href="{% url 'stock_update' stock.pk %}"
       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-[#E4DECB] text-slate-700 text-xs font-semibold hover:bg-slate-50 transition shadow-sm">
        Edit
    </a>
    <a href="{% url 'stock_list' %}"
       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-orange-600 text-white text-xs font-semibold hover:bg-orange-700 transition shadow-sm">
        
        Stock List
    </a>
</div>
{% endblock %}

{% block content %}
<div class="space-y-3 max-w-7xl mx-auto">

    <!-- COMPACT KPI STRIP -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
