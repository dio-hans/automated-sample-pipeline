class PackagingRunOutput(models.Model):
    """A finished product/pack-size quantity produced by a packaging run."""
    run = models.ForeignKey(
        PackagingRun,
        on_delete=models.PROTECT,
        related_name="outputs",
    )
    product = models.ForeignKey(
        PackagedProduct,
        on_delete=models.PROTECT,
        related_name="packaging_outputs",
    )
    packs_produced = models.PositiveIntegerField()

    class Meta:
        ordering = ["product__pack_size__grams", "pk"]
        constraints = [
            models.CheckConstraint(
                condition=models.Q(packs_produced__gt=0),
                name="packrun_output_gt0",
            ),
            models.UniqueConstraint(
                fields=["run", "product"],
                name="uniq_packrun_product",
            ),
        ]

    @property
    def coffee_used_kg(self):
        return self.product.kg_per_pack * self.packs_produced

    def __str__(self):
        return f"Run #{self.run_id}: {self.packs_produced} × {self.product}"

# 6. PACKAGED INVENTORY  (live stock per product)
#    packs_in - packs_released + packs_returned
class PackagedInventory(models.Model):

    product = models.OneToOneField(
        PackagedProduct,
        on_delete=models.PROTECT,
        related_name="inventory",
    )

    updated_at = models.DateTimeField(
        auto_now=True,
    )

    class Meta:
        ordering = ["product__blend__name"]

    def __str__(self):
        return f"{self.product}: {self.available} packs available"

    @property
    def packs_produced(self):
        if "_packs_produced_cache" in self.__dict__:
            return self.__dict__["_packs_produced_cache"]

        return sum(
            output.packs_produced
            for output in self.product.packaging_outputs.filter(run__status="completed")
        )

    @property
    def packs_released(self):
        if "_packs_released_cache" in self.__dict__:
            return self.__dict__["_packs_released_cache"]

        return sum(
            release.packs_out
            for release in self.product.releases.all()
        )

    @property
    def packs_returned(self):
        if "_packs_returned_cache" in self.__dict__:
            return self.__dict__["_packs_returned_cache"]

        return sum(
            ret.packs_returned
            for release in self.product.releases.all()
            for ret in release.returns.all()
            if ret.status == 'approved' and ret.condition == 'good'
        )

    @property
    def available(self):
        if "_available_cache" in self.__dict__:
            return self.__dict__["_available_cache"]

        return (
            self.packs_produced
            - self.packs_released
            + self.packs_returned
        )

