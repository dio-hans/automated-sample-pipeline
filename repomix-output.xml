<file path="web/templates/pipeline/expense_tracker.html">
{% extends "pipeline/base.html" %}
{% load static %}

{% block title %}Record Expense | Nonda{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{% static 'css/expense_tracker.css' %}">
{% endblock %}

{% block breadcrumb %}
Accounts / Expenses / Record Expense
{% endblock %}

{% block content %}
<div class="expense-entry-page">

     {% if request.user.role == "ACCOUNTS" or request.user.role == "ADMIN" %}

     

    {% endif %}
    <!-- FORM CARD -->
    <div class="expense-form-card">
        <div class="expense-form-card-header">
        <h1>Record Business Expense</h1>
        <p>Capture an operational expense for Nonda Commodities.</p>
    </div>
        <form method="POST" action="{% url 'expense_tracker' %}" class="expense-form">
            {% csrf_token %}
            <!-- CATEGORY -->
            <div class="expense-field">
                <label for="{{ form.category.id_for_label }}">Category</label>
                {{ form.category }}
                {% if form.category.errors %}
                    <p class="expense-error">{{ form.category.errors.0 }}</p>
                {% endif %}
            </div>

            <!-- AMOUNT + DATE -->
            <div class="expense-two-column">
                <div class="expense-field">
                    <label for="{{ form.amount.id_for_label }}">Amount (UGX)</label>
                    {{ form.amount }}
                    {% if form.amount.errors %}
                        <p class="expense-error">{{ form.amount.errors.0 }}</p>
                    {% endif %}
                </div>
                <div class="expense-field">
                    <label for="{{ form.expense_date.id_for_label }}">Date Incurred</label>
                    {{ form.expense_date }}
                    {% if form.expense_date.errors %}
                        <p class="expense-error">{{ form.expense_date.errors.0 }}</p>
                    {% endif %}
                </div>
            </div>

            <!-- NOTES -->
            <div class="expense-field">
                <label for="{{ form.notes.id_for_label }}">Notes / Description</label>
                {{ form.notes }}
                <span class="expense-field-help">
                    Required when category is "Others".
                </span>
                {% if form.notes.errors %}
                    <p class="expense-error">{{ form.notes.errors.0 }}</p>
                {% endif %}
            </div>

            <!-- SAVE -->
            <button type="submit" class="expense-save-button">
                Save Expense Record
            </button>
        </form>
    </div>


</div>
{% endblock %}
</file>

<file path="web/templates/pipeline/low_stock_list.html">
{% extends "pipeline/base.html" %}
{% load static humanize %}

{% block title %}Low Stock Warnings | Nonda{% endblock %}
{% block breadcrumb %}Inventory / Low Stock{% endblock %}
{% block page_title %}Low Stock Alert Workspace{% endblock %}

{% block header_action %} 
<a href="{% url 'stock_list' %}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-[#E4DECB] bg-white text-slate-700 text-xs font-semibold hover:bg-slate-50 transition shadow-sm">
