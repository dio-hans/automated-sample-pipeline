<file path="web/templates/internal_stock/internal_stock_issue_detail.html">
{% extends "pipeline/base.html" %}

{% block title %}
Internal Stock Issue #{{ issue.pk }} | Nonda
{% endblock %}

{% block breadcrumb %}
Inventory / Internal Stock / Issue #{{ issue.pk }}
{% endblock %}

{% block page_title %}
Internal Stock Issue #{{ issue.pk }}
{% endblock %}

{% block page_subtitle %}
Internal stock issue record
{% endblock %}

{% block header_action %}

<div class="flex items-center gap-2">

    <a
        href="{% url 'internal_stock_issue_list' %}"
        class="inline-flex items-center gap-2
               px-3 py-2 rounded-lg
               border border-slate-200
               bg-white
               text-xs font-semibold text-slate-700
               hover:bg-slate-50 transition"
    >
        <i class="fa-solid fa-arrow-left text-[10px]"></i>
        History
    </a>

    <a
        href="{% url 'internal_stock_issue_create' %}"
        class="inline-flex items-center gap-2
               px-3 py-2 rounded-lg
               bg-rust text-white
               text-xs font-bold
               hover:opacity-90 transition"
    >
        <i class="fa-solid fa-plus text-[10px]"></i>
        Issue Stock
    </a>

</div>

{% endblock %}


{% block content %}

<div class="max-w-6xl mx-auto space-y-4">

    <!-- ISSUE INFORMATION -->
    <section class="bg-white border border-line rounded-xl overflow-hidden">

        <div class="px-5 py-4 border-b border-line flex items-center justify-between">

            <div>
                <h2 class="text-sm font-bold text-slate-900">
                    Issue Information
                </h2>

                <p class="text-[11px] text-slate-400 mt-0.5">
                    Details of this internal stock movement
                </p>
            </div>

            <span class="text-[10px] font-bold uppercase tracking-wider
                         text-slate-400">
                #{{ issue.pk }}
            </span>

        </div>


        <div class="grid grid-cols-2 lg:grid-cols-4 divide-x divide-line">

            <!-- ACCOUNT -->
            <div class="px-5 py-4">
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                    Account
                </p>

                <p class="mt-1 text-sm font-bold text-slate-900">
                    {{ issue.account.name }}
                </p>
            </div>


            <!-- TYPE -->
            <div class="px-5 py-4">
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                    Type
                </p>

                <p class="mt-1 text-sm font-semibold text-slate-700">
                    {{ issue.account.get_account_type_display }}
                </p>
            </div>


            <!-- DATE -->
            <div class="px-5 py-4">
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                    Issue Date
                </p>

                <p class="mt-1 text-sm font-semibold text-slate-700">
                    {{ issue.issue_date|date:"d M Y" }}
                </p>
            </div>


            <!-- RECORDED BY -->
            <div class="px-5 py-4">
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                    Recorded By
                </p>

                <p class="mt-1 text-sm font-semibold text-slate-700">
                    {{ issue.issued_by.username|default:"System" }}
                </p>
            </div>

        </div>


        {% if issue.reason or issue.notes %}

        <div class="px-5 py-4 border-t border-line bg-slate-50/40">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                {% if issue.reason %}
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                        Reason
                    </p>

                    <p class="mt-1 text-sm text-slate-700">
                        {{ issue.reason }}
                    </p>
                </div>
                {% endif %}


                {% if issue.notes %}
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                        Notes
                    </p>

                    <p class="mt-1 text-sm text-slate-600">
                        {{ issue.notes }}
                    </p>
                </div>
                {% endif %}

            </div>

        </div>

        {% endif %}

    </section>


    <!-- STOCK ISSUED -->
    <section class="bg-white border border-line rounded-xl overflow-hidden">

        <div class="px-5 py-4 border-b border-line flex items-center justify-between">

            <div>
                <h2 class="text-sm font-bold text-slate-900">
                    Stock Issued
                </h2>

                <p class="text-[11px] text-slate-400 mt-0.5">
                    Coffee removed from available inventory
                </p>
            </div>

            <div class="text-right">
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                    Items
                </p>

                <p class="text-sm font-bold text-slate-900">
                    {{ items|length }}
                </p>
            </div>

        </div>


        <div class="overflow-x-auto">

            <table class="w-full text-sm">

                <thead class="bg-slate-50 border-b border-line">

                    <tr>

                        <th class="px-5 py-3 text-left
                                   text-[10px] font-bold uppercase
                                   tracking-wider text-slate-400">
                            Coffee
                        </th>

                        <th class="px-5 py-3 text-left
                                   text-[10px] font-bold uppercase
                                   tracking-wider text-slate-400">
                            Stage
                        </th>

                        <th class="px-5 py-3 text-right
                                   text-[10px] font-bold uppercase
                                   tracking-wider text-slate-400">
                            Quantity
                        </th>

                        <th class="px-5 py-3 text-right
                                   text-[10px] font-bold uppercase
                                   tracking-wider text-slate-400">
                            Value
                        </th>

                    </tr>

                </thead>


                <tbody class="divide-y divide-line">

                    {% for item in items %}

                    <tr class="hover:bg-slate-50/50 transition">

                        <!-- COFFEE -->
                        <td class="px-5 py-4">

                            {% if item.packaged_product %}

                                <p class="font-semibold text-slate-900">
                                    {{ item.packaged_product }}
                                </p>

                                <p class="text-[11px] text-slate-400 mt-0.5">
                                    Packaged coffee
                                </p>

                            {% else %}

                                <p class="font-semibold text-slate-900">
                                    {{ item.coffee_stock.variety.name }}
                                </p>

                                <p class="text-[11px] text-slate-400 mt-0.5">
                                    Batch {{ item.coffee_stock.batch_number }}
                                </p>

                            {% endif %}

                        </td>


                        <!-- STAGE -->
                        <td class="px-5 py-4 text-slate-600">

                            {% if item.packaged_product %}
                                Packaged Coffee
                            {% else %}
                                {{ item.get_stock_stage_display }}
                            {% endif %}

                        </td>


                        <!-- QUANTITY -->
                        <td class="px-5 py-4 text-right font-semibold text-slate-900">

                            {% if item.packaged_product %}
                                {{ item.packs }}
                                <span class="text-xs font-normal text-slate-400">
                                    packs
                                </span>
                            {% else %}
                                {{ item.quantity_kg }}
                                <span class="text-xs font-normal text-slate-400">
                                    kg
                                </span>
                            {% endif %}

                        </td>


                        <!-- VALUE -->
                        <td class="px-5 py-4 text-right font-semibold text-slate-900">

                            {% if item.unit_cost %}
                                UGX {{ item.total_value|floatformat:0 }}
                            {% else %}
                                <span class="text-slate-300">—</span>
                            {% endif %}

                        </td>

                    </tr>

                    {% empty %}

                    <tr>

                        <td
                            colspan="4"
                            class="px-5 py-10 text-center text-sm text-slate-400"
                        >
                            No stock items were recorded for this issue.
                        </td>

                    </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>


        <!-- TOTAL -->
        <div class="px-5 py-4 border-t border-line flex justify-end">

            <div class="text-right">

                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                    Recorded Stock Value
                </p>

                <p class="mt-1 text-lg font-bold text-slate-900">
                    UGX {{ total_value|floatformat:0 }}
                </p>

            </div>

        </div>

    </section>

</div>

{% endblock %}
</file>

<file path="web/templates/pipeline/followup_list.html">
