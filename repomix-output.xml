<file path="web/templates/consignments/consignment_delivery.html">
{% extends "pipeline/base.html" %}

{% block title %}Request Delivery | Nonda{% endblock %}

{% block breadcrumb %}
Sales / Consignments / {{ company.name }} / {{ branch.branch_name }} / Delivery
{% endblock %}

{% block page_title %}
Request Branch Delivery
{% endblock %}

{% block page_subtitle %}
<p class="mt-0.5 text-xs text-slate-500">
    Request packaged stock for {{ branch.branch_name }}.
    Products may be requested even when current warehouse stock is unavailable.
</p>
{% endblock %}


{% block content %}

<form
    method="post"
    id="deliveryRequestForm"
    class="max-w-5xl space-y-3"
>

    {% csrf_token %}
    {{ item_formset.management_form }}


    <!-- DESTINATION -->
    <section class="rounded-lg border border-line bg-white">

        <div class="grid grid-cols-1 gap-3 px-3 py-2.5 sm:grid-cols-2">

            <div>
                <p class="text-[10px] uppercase tracking-wide text-slate-400">
                    Consignee
                </p>

                <p class="mt-0.5 text-xs font-semibold text-slate-800">
                    {{ company.name }}
                </p>
            </div>

            <div>
                <p class="text-[10px] uppercase tracking-wide text-slate-400">
                    Destination branch
                </p>

                <p class="mt-0.5 text-xs font-semibold text-slate-800">
                    {{ branch.branch_name }}
                </p>
            </div>

        </div>

    </section>


    <!-- PRODUCTS -->
    <section class="rounded-lg border border-line bg-white overflow-hidden">

        <div class="flex items-center justify-between border-b border-line
                    px-3 py-2">

            <div>
                <h2 class="text-xs font-semibold text-slate-800">
                    Requested products
                </h2>

                <p class="text-[10px] text-slate-400">
                    Unavailable products remain pending until stock is ready.
                </p>
            </div>

            <button
                type="button"
                id="addProductRow"
                class="h-7 rounded-md border border-line bg-white
                       px-2.5 text-[10px] font-semibold text-slate-700
                       hover:bg-slate-50"
            >
                + Add product
            </button>

        </div>


        {% if item_formset.non_form_errors %}
        <div class="border-b border-rose-200 bg-rose-50
                    px-3 py-2 text-xs text-rose-700">
            {{ item_formset.non_form_errors }}
        </div>
        {% endif %}


        <div id="productRows"
             class="divide-y divide-slate-100">

            {% for form in item_formset %}

            <div class="product-row grid grid-cols-1 gap-2
                        px-3 py-2.5 md:grid-cols-[1fr_130px_70px]">

                <div>
                    <label class="mb-1 block text-[10px]
                                  font-semibold text-slate-500">
                        Product
                    </label>

                    {{ form.product }}

                    {% for error in form.product.errors %}
                    <p class="mt-1 text-[10px] text-rose-600">
                        {{ error }}
                    </p>
                    {% endfor %}
                </div>


                <div>
                    <label class="mb-1 block text-[10px]
                                  font-semibold text-slate-500">
                        Quantity
                    </label>

                    {{ form.quantity_requested }}

                    {% for error in form.quantity_requested.errors %}
                    <p class="mt-1 text-[10px] text-rose-600">
                        {{ error }}
                    </p>
                    {% endfor %}
                </div>


                <div class="flex items-end">

                    {% if form.DELETE %}
                        <div class="hidden">
                            {{ form.DELETE }}
                        </div>
                    {% endif %}

                    <button
                        type="button"
                        class="remove-row h-8 w-full rounded-md
                               border border-rose-200 bg-white
                               text-[10px] font-semibold text-rose-600
                               hover:bg-rose-50"
                    >
                        Remove
                    </button>

                </div>

            </div>

            {% endfor %}

        </div>


        <template id="emptyProductRow">

            <div class="product-row grid grid-cols-1 gap-2
                        px-3 py-2.5 md:grid-cols-[1fr_130px_70px]">

                <div>
                    <label class="mb-1 block text-[10px]
                                  font-semibold text-slate-500">
                        Product
                    </label>

                    {{ item_formset.empty_form.product }}
                </div>

                <div>
                    <label class="mb-1 block text-[10px]
                                  font-semibold text-slate-500">
                        Quantity
                    </label>

                    {{ item_formset.empty_form.quantity_requested }}
                </div>

                <div class="flex items-end">

                    {% if item_formset.empty_form.DELETE %}
                    <div class="hidden">
                        {{ item_formset.empty_form.DELETE }}
                    </div>
                    {% endif %}

                    <button
                        type="button"
                        class="remove-row h-8 w-full rounded-md
                               border border-rose-200 bg-white
                               text-[10px] font-semibold text-rose-600"
                    >
                        Remove
                    </button>

                </div>

            </div>

        </template>

    </section>


    <!-- NOTES -->
    <section class="rounded-lg border border-line bg-white p-3">

        <label class="mb-1 block text-[10px]
                      font-semibold text-slate-500">
            Request notes
        </label>

        <textarea
            name="notes"
            rows="2"
            placeholder="Optional delivery / restocking note..."
            class="w-full rounded-md border border-line bg-white
                   px-2.5 py-2 text-xs outline-none
                   focus:border-olive"
        ></textarea>

    </section>


    <div class="flex justify-end gap-2">

        <a
            href="{% url 'consignment_branch_detail' company.pk branch.pk %}"
            class="inline-flex h-8 items-center rounded-md
                   border border-line bg-white px-3
                   text-xs font-medium text-slate-600"
        >
            Cancel
        </a>

        <button
            type="submit"
            class="inline-flex h-8 items-center rounded-md
                   bg-olive px-3 text-xs font-semibold
                   text-white hover:bg-olive/90"
        >
            Submit to Store
        </button>

    </div>

</form>

{% endblock %}


{% block extra_scripts %}
{{ block.super }}

<script>
document.addEventListener("DOMContentLoaded", function () {

    const rows = document.getElementById("productRows");
    const totalForms = document.getElementById("id_items-TOTAL_FORMS");
    const template = document.getElementById("emptyProductRow");
    const addButton = document.getElementById("addProductRow");

    function bindRemove(button) {

        button.addEventListener("click", function () {

            const row = button.closest(".product-row");
            const deleteInput = row.querySelector(
                'input[name$="-DELETE"]'
            );

            if (deleteInput) {
                deleteInput.checked = true;
                row.classList.add("hidden");
            } else {
                row.remove();
            }

        });

    }

    document.querySelectorAll(".remove-row").forEach(bindRemove);


    addButton.addEventListener("click", function () {

        const index = parseInt(totalForms.value, 10);

        const html = template.innerHTML.replaceAll(
            "__prefix__",
            index
        );

        const holder = document.createElement("div");
        holder.innerHTML = html.trim();

        const newRow = holder.firstElementChild;

        rows.appendChild(newRow);

        totalForms.value = index + 1;

        bindRemove(
            newRow.querySelector(".remove-row")
        );

    });

});
</script>

{% endblock %}
</file>

<file path="web/templates/consignments/consignment_invoice.html">
{% extends 'pipeline/base.html' %}
{% load humanize %}

{% block title %}Invoice {{ invoice.number }} | Nonda{% endblock %}
{% block breadcrumb %}
Sales / Consignments / {{ invoice.number }}
{% endblock %}
{% block page_title %}Consignment invoice{% endblock %}

{% block header_action %}

<button
    type="button"
    onclick="window.print()"
    class="inline-flex h-8 items-center gap-1.5
           rounded-md border border-line bg-white
           px-3 text-xs font-medium text-slate-700
           hover:bg-slate-50"
>
    <i class="fa-solid fa-print text-[10px]"></i>
    Print
</button>

{% endblock %}


{% block extra_head %}
{{ block.super }}

<style>
@media print {

    #mainSidebar,
    header,
    footer,
    #sidebarOverlay,
    .no-print {
        display: none !important;
    }

    .lg\:ml-64 {
        margin-left: 0 !important;
    }

    main {
        padding: 0 !important;
    }

    body {
        background: #fff !important;
    }

    .invoice-sheet {
        border: 0 !important;
        box-shadow: none !important;
    }
}
</style>

{% endblock %}


{% block content %}

<div class="invoice-sheet mx-auto max-w-4xl
            rounded-lg border border-line bg-white shadow-sm">

    <!-- HEADER -->
    <div class="flex items-start justify-between gap-4
                border-b border-line px-5 py-4">

        <div>

            <p class="font-display text-base font-semibold text-ink">
                NONDA COMMODITIES
            </p>

            <p class="mt-0.5 text-[10px] uppercase
                      tracking-[0.14em] text-slate-400">
                Consignment sales invoice
            </p>

        </div>

        <div class="text-right">

            <p class="text-sm font-semibold text-slate-800">
                {{ invoice.number }}
            </p>

            <p class="text-[10px] text-slate-400">
                Issued {{ invoice.issued_at|date:'d M Y' }}
            </p>

            <p class="text-[10px] text-slate-400">
                Audit #{{ invoice.audit.pk }}
            </p>

        </div>

    </div>

    <!-- CUSTOMER -->
    <div class="grid grid-cols-2 gap-6
                border-b border-line px-5 py-3 text-xs">

        <div>

            <p class="text-[10px] uppercase tracking-wide text-slate-400">
                Bill to
            </p>

            <p class="mt-1 font-semibold text-slate-800">
                {{ company.name }}
            </p>

            <p class="mt-0.5 text-slate-500">
                {{ company.address }}
            </p>

            <p class="text-slate-500">
                {{ company.city }}, {{ company.country }}
            </p>

        </div>

        <div>

            <p class="text-[10px] uppercase tracking-wide text-slate-400">
                Delivery location
            </p>

            <p class="mt-1 font-semibold text-slate-800">
                {{ branch.branch_name }}
            </p>

            <p class="mt-0.5 text-slate-500">
                {{ branch.address|default:'—' }}
            </p>

            <p class="text-[10px] text-slate-400">
                Approved
                {{ invoice.audit.approved_at|date:'d M Y, H:i' }}
            </p>

        </div>

    </div>

    <!-- ITEMS -->
    <div class="overflow-x-auto">

        <table class="min-w-full text-xs">

            <thead class="bg-slate-50/80 text-[10px]
                          uppercase tracking-wide text-slate-500">

                <tr>
                    <th class="px-5 py-2 text-left">Product</th>
                    <th class="px-3 py-2 text-right">Confirmed sold</th>
                    <th class="px-3 py-2 text-right">Price / pack</th>
                    <th class="px-5 py-2 text-right">Amount · UGX</th>
                </tr>

            </thead>

            <tbody class="divide-y divide-slate-100">

                {% for item in items %}

                {% if item.quantity_sold %}

                <tr>

                    <td class="px-5 py-2.5 font-medium text-slate-800">
                        {{ item.product }}
                    </td>

                    <td class="px-3 py-2.5 text-right">
                        {{ item.quantity_sold }}
                    </td>

                    <td class="px-3 py-2.5 text-right">
                        {{ item.selling_price|floatformat:0|intcomma }}
                    </td>

                    <td class="px-5 py-2.5 text-right font-semibold">
                        {{ item.calculated_amount_due|floatformat:0|intcomma }}
                    </td>

                </tr>

                {% endif %}

                {% endfor %}

            </tbody>

        </table>

    </div>

    <!-- TOTAL -->
    <div class="flex justify-end border-t border-line px-5 py-3">

        <div class="w-72">

            <div class="flex items-center justify-between text-xs">

                <span class="font-medium text-slate-500">
                    Invoice amount · UGX
                </span>

                <span class="text-base font-semibold text-slate-900">
                    {{ invoice.total_amount|floatformat:0|intcomma }}
                </span>

            </div>

        </div>

    </div>

    <div class="border-t border-line bg-slate-50/50
                px-5 py-2.5 text-[10px]
                leading-4 text-slate-400">

        Generated only from approved branch audit #{{ invoice.audit.pk }}.
        This invoice is not a cash receipt; collections are recorded
        against the related display releases.

    </div>

</div>

<div class="no-print mt-3">

    <a
        href="{% url 'consignment_audit_detail' company.pk branch.pk invoice.audit.pk %}"
        class="text-xs font-medium text-slate-500 hover:text-olive"
    >
        ← Back to audit
    </a>

</div>

{% endblock %}
</file>

