{% extends "pipeline/base.html" %}
{% block title %}Request Stock | Nonda{% endblock %}
{% block breadcrumb %}Sales / Stock Request{% endblock %}
{% block page_title %}Request Packaged Coffee{% endblock %}

{% block header_action %}
<a href="{% url 'record_sale' %}" class="px-4 py-2.5 border border-line rounded-lg bg-white text-sm font-medium">Cancel</a>
{% endblock %}

{% block content %}
<form method="post" id="stock-request-form" class="max-w-7xl mx-auto space-y-6">
  {% csrf_token %}

  {% if form.non_field_errors or item_formset.non_form_errors %}
  <div class="rounded-lg border border-rust/20 bg-rust/5 px-4 py-3 text-sm text-rust">
    {{ form.non_field_errors }}{{ item_formset.non_form_errors }}
  </div>
  {% endif %}

  <!-- Top Metadata Panel -->
  <section class="bg-white border border-line rounded-xl p-6 shadow-xs">
    <h2 class="font-display text-xl mb-4">Request details</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {% for field in form %}
      <div class="{% if field.name == 'notes' %}md:col-span-3{% endif %}">
        <label class="block text-sm font-semibold mb-1" for="{{ field.id_for_label }}">{{ field.label }}</label>
        {{ field }}
        {% for error in field.errors %}
        <p class="text-xs text-rust mt-1">{{ error }}</p>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- Dual Panel Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- LEFT PANEL: Grouped Product Selection Grid -->
    <div class="lg:col-span-7 space-y-4">
      <div class="bg-white border border-line rounded-xl p-4 flex flex-col sm:flex-row gap-4 items-center justify-between shadow-xs">
        <div class="w-full">
          <label for="product-search" class="block text-xs font-semibold text-clay mb-1">Search Products</label>
          <input type="text" id="product-search" onkeyup="filterProducts()" placeholder="Type coffee blend or variant name..." class="w-full px-3 py-2 bg-paper border border-line rounded-lg text-sm focus:outline-none focus:border-rust">
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-h-[500px] overflow-y-auto pr-1" id="product-grid">
        {% regroup products by blend__name|default:"Other Products" as blend_list %}
        
        {% for group in blend_list %}
        <!-- Safely containerize the script data with a deterministic alphanumeric ID prefix -->
        <script type="application/json" id="data-json-{{ forloop.counter }}">
          {{ group.list|json_script:"dummy"|cut:"<script type=\"application/json\" id=\"dummy\">"|cut:"</script>"|safe }}
        </script>

        <div class="product-card bg-sky-950 hover:bg-sky-900 text-white rounded-xl p-4 flex flex-col justify-between cursor-pointer transition-all border border-sky-900 shadow-xs"
             data-blend-name="{{ group.grouper|lower }}"
             data-data-id="data-json-{{ forloop.counter }}"
             onclick="handleCardClick(this)">
          <div>
            <span class="text-[10px] font-black tracking-wider uppercase text-sky-300 block mb-1">
              {{ group.list|length }} Option{% if group.list|length > 1 %}s{% endif %}
            </span>
            <h3 class="font-bold text-sm leading-tight text-white group-hover:text-amber-300 transition-colors">
              {{ group.grouper }}
            </h3>
          </div>

          <div class="mt-4 pt-2 border-t border-sky-800/60 flex justify-between items-center text-xs">
            <span class="text-sky-200 text-[11px] font-medium">In Stock</span>
            <span class="bg-sky-800 group-hover:bg-amber-400 group-hover:text-sky-950 text-sky-100 px-2 py-0.5 rounded text-[10px] font-bold transition-colors">+ Select</span>
          </div>
        </div>
        {% empty %}
        <div class="col-span-full bg-white border border-line rounded-xl p-8 text-center text-clay">
          No packaged coffee products currently in stock.
        </div>
        {% endfor %}
      </div>
    </div>

    <!-- RIGHT PANEL: Selected Items Queue -->
    <div class="lg:col-span-5 bg-white border border-line rounded-xl overflow-hidden shadow-xs">
      <div class="px-5 py-4 border-b border-line bg-paper/50 flex justify-between items-center">
        <div>
          <h2 class="font-display text-lg">Requested Items</h2>
          <p class="text-xs text-clay">Products queued for this stock request</p>
        </div>
        <span id="item-count-badge" class="bg-rust/10 text-rust font-bold text-xs px-2.5 py-1 rounded-full">0 items</span>
      </div>

      <div id="item-forms" class="p-4 space-y-3 min-h-[220px] max-h-[420px] overflow-y-auto">
        {{ item_formset.management_form }}
        
        <div id="empty-queue-msg" class="text-center py-12 text-clay">
          <p class="text-sm">No products added yet.</p>
          <p class="text-xs mt-1">Click any product on the left grid to add it.</p>
        </div>

        <div id="formset-rows-container" class="space-y-3">
          {% for item in item_formset %}
            {% if item.product.value %}
            <div class="request-row bg-paper border border-line rounded-lg p-3 flex items-center justify-between gap-3" data-product-id="{{ item.product.value }}">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-slate-800 truncate" id="label-{{ forloop.counter0 }}">
                  {{ item.instance.product.blend.name }} ({{ item.instance.product.pack_size.label }} â€” {{ item.instance.product.form|title }})
                </p>
                <div class="hidden">
                  {{ item.product }}
                </div>
              </div>
              <div class="w-24">
                <label class="block text-[10px] font-bold text-clay uppercase mb-0.5">Qty</label>
                {{ item.quantity_requested }}
              </div>
              <button type="button" class="remove-row text-rust hover:text-rust/80 p-1 text-sm font-bold" title="Remove item">&times;</button>
            </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="p-4 border-t border-line bg-paper/30 flex justify-end">
        <button type="submit" class="w-full sm:w-auto px-6 py-2.5 rounded-lg bg-rust hover:bg-rust/90 text-white text-sm font-semibold transition-all">
          Submit Request
        </button>
      </div>
    </div>

  </div>
</form>

<!-- Single Variant & Quantity Selection Modal -->
<div id="qty-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center hidden z-50 p-4">
  <div class="bg-white rounded-xl max-w-sm w-full p-6 shadow-2xl border border-line space-y-4">
    <div>
      <h3 id="modal-blend-name" class="font-display text-lg">Select Option</h3>
      <p class="text-xs text-clay mt-0.5">Choose variant and quantity required.</p>
    </div>

    <div>
      <label for="modal-variant-select" class="block text-xs font-semibold mb-1">Pack Size / Type</label>
      <select id="modal-variant-select" onchange="onVariantChange()" class="w-full px-3 py-2 border border-line rounded-lg text-sm bg-white focus:outline-none focus:border-rust"></select>
      <p id="modal-stock-label" class="text-xs text-amber-700 font-semibold mt-1"></p>
    </div>
    
    <div>
      <label for="modal-qty-input" class="block text-xs font-semibold mb-1">Quantity Requested</label>
      <input type="number" id="modal-qty-input" min="1" value="1" class="w-full px-3 py-2 border border-line rounded-lg text-base font-bold focus:outline-none focus:border-rust">
    </div>

    <div class="flex justify-end gap-2 pt-2">
      <button type="button" onclick="closeQtyModal()" class="px-4 py-2 border border-line rounded-lg text-xs font-semibold hover:bg-paper">Cancel</button>
      <button type="button" onclick="confirmAddProduct()" class="px-4 py-2 bg-rust text-white rounded-lg text-xs font-semibold hover:bg-rust/90">Add to Request</button>
    </div>
  </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
let currentVariants = [];


/* =========================================================
   PRODUCT SEARCH
   ========================================================= */

function filterProducts() {
    const query = document
        .getElementById("product-search")
        .value
        .toLowerCase()
        .trim();

    document.querySelectorAll(".product-card").forEach(card => {
        const blendName = (card.dataset.blendName || "").toLowerCase();

        card.style.display = blendName.includes(query)
            ? "flex"
            : "none";
    });
}


/* =========================================================
   PRODUCT CARD CLICK
   ========================================================= */

function handleCardClick(cardElement) {
    const scriptId = cardElement.dataset.dataId;
    const scriptTag = document.getElementById(scriptId);

    if (!scriptTag) {
        console.error("Product data not found:", scriptId);
        return;
    }

    try {
        const rawData = JSON.parse(scriptTag.textContent);

        currentVariants = rawData.map(item => ({
            id: item.id,
            name: item.name,
            pack_size_name: item.pack_size_name,
            form_display: item.form_display,
            stock: Number(item.current_stock || 0)
        }));

        const blendName = cardElement.dataset.blendName || "Select Product";

        openVariantModal(blendName, currentVariants);

    } catch (error) {
        console.error("Failed to parse product data:", error);
    }
}


/* =========================================================
   OPEN MODAL
   ========================================================= */

function openVariantModal(blendName, variants) {

    const modal = document.getElementById("qty-modal");
    const select = document.getElementById("modal-variant-select");

    document.getElementById("modal-blend-name").textContent = blendName;

    select.innerHTML = "";

    if (!variants.length) {
        const option = document.createElement("option");
        option.textContent = "No variants available";
        option.disabled = true;
        select.appendChild(option);

        document.getElementById("modal-stock-label").textContent = "";
        modal.classList.remove("hidden");
        return;
    }

    variants.forEach(variant => {

        const option = document.createElement("option");

        option.value = variant.id;

        option.textContent =
            `${variant.pack_size_name} â€” ${variant.form_display}`;

        option.dataset.stock = variant.stock;
        option.dataset.name = variant.name;

        select.appendChild(option);
    });

    document.getElementById("modal-qty-input").value = 1;

    onVariantChange();

    modal.classList.remove("hidden");
}


/* =========================================================
   VARIANT CHANGE
   ========================================================= */

function onVariantChange() {

    const select = document.getElementById("modal-variant-select");
    const selectedOption = select.options[select.selectedIndex];

    const stockLabel = document.getElementById("modal-stock-label");
    const qtyInput = document.getElementById("modal-qty-input");

    if (!selectedOption) {
        stockLabel.textContent = "";
        return;
    }

    const stock = Number(selectedOption.dataset.stock || 0);

    stockLabel.textContent =
        `Available stock: ${stock} units`;

    qtyInput.max = stock;

    if (stock <= 0) {
        qtyInput.value = 0;
        qtyInput.disabled = true;
    } else {
        qtyInput.disabled = false;

        if (Number(qtyInput.value) < 1) {
            qtyInput.value = 1;
        }
    }
}


/* =========================================================
   CLOSE MODAL
   ========================================================= */

function closeQtyModal() {

    document
        .getElementById("qty-modal")
        .classList.add("hidden");

    currentVariants = [];
}


/* =========================================================
   CONFIRM PRODUCT
   ========================================================= */

function confirmAddProduct() {

    const select = document.getElementById("modal-variant-select");
    const selectedOption = select.options[select.selectedIndex];

    const qtyInput = document.getElementById("modal-qty-input");

    if (!selectedOption) {
        return;
    }

    const productId = selectedOption.value;
    const productName = selectedOption.dataset.name;
    const availableStock = Number(selectedOption.dataset.stock || 0);
    const quantity = Number(qtyInput.value);

    if (availableStock <= 0) {
        alert("This product is currently out of stock.");
        return;
    }

    if (!quantity || quantity < 1) {
        alert("Enter a valid quantity.");
        return;
    }

    if (quantity > availableStock) {
        alert(`Only ${availableStock} units are currently available.`);
        return;
    }

    addProductRow(
        productId,
        productName,
        quantity
    );

    closeQtyModal();
}


/* =========================================================
   ADD REQUEST ROW
   ========================================================= */

function addProductRow(productId, productName, quantity) {

    const container =
        document.getElementById("formset-rows-container");

    const totalFormsInput =
        document.getElementById("id_items-TOTAL_FORMS");

    const emptyMsg =
        document.getElementById("empty-queue-msg");


    if (emptyMsg) {
        emptyMsg.style.display = "none";
    }


    /* ---------------------------------------------
       If product already exists, increase quantity
       --------------------------------------------- */

    const existingRows =
        container.querySelectorAll(".request-row");

    for (const row of existingRows) {

        const productInput =
            row.querySelector('input[name$="-product"]');

        if (
            productInput &&
            String(productInput.value) === String(productId)
        ) {

            const qtyInput =
                row.querySelector(
                    'input[name$="-quantity_requested"]'
                );

            if (qtyInput) {

                qtyInput.value =
                    Number(qtyInput.value || 0)
                    + Number(quantity);

                updateItemCount();
                return;
            }
        }
    }


    /* ---------------------------------------------
       Determine new form index
       --------------------------------------------- */

    const currentIndex =
        container.querySelectorAll(".request-row").length;


    /* ---------------------------------------------
       Create row
       --------------------------------------------- */

    const rowDiv =
        document.createElement("div");

    rowDiv.className =
        "request-row bg-paper border border-line rounded-lg p-3 flex items-center justify-between gap-3";


    rowDiv.innerHTML = `
        <div class="flex-1 min-w-0">

            <p class="text-sm font-semibold text-slate-800 truncate">
                ${productName}
            </p>

            <input
                type="hidden"
                name="items-${currentIndex}-product"
                id="id_items-${currentIndex}-product"
                value="${productId}"
            >

        </div>

        <div class="w-24">

            <label
                class="block text-[10px] font-bold text-clay uppercase mb-0.5"
            >
                Qty
            </label>

            <input
                type="number"
                name="items-${currentIndex}-quantity_requested"
                id="id_items-${currentIndex}-quantity_requested"
                value="${quantity}"
                min="1"
                class="w-full px-2 py-1 bg-white border border-line rounded text-xs font-semibold focus:outline-none focus:border-rust"
            >

        </div>

        <button
            type="button"
            class="remove-row text-rust hover:text-rust/80 p-1 text-sm font-bold"
            title="Remove item"
        >
            Ã—
        </button>
    `;


    container.appendChild(rowDiv);

    totalFormsInput.value =
        container.querySelectorAll(".request-row").length;

    bindRowEvents(rowDiv);

    updateItemCount();
}


/* =========================================================
   REMOVE ROW
   ========================================================= */

function bindRowEvents(row) {

    const removeButton =
        row.querySelector(".remove-row");

    if (!removeButton) {
        return;
    }

    removeButton.onclick = function () {

        row.remove();

        reindexRows();

        updateItemCount();
    };
}


/* =========================================================
   REINDEX FORMSET
   ========================================================= */

function reindexRows() {

    const container =
        document.getElementById("formset-rows-container");

    const rows =
        container.querySelectorAll(".request-row");

    const totalFormsInput =
        document.getElementById("id_items-TOTAL_FORMS");

    const emptyMsg =
        document.getElementById("empty-queue-msg");


    rows.forEach((row, index) => {

        row.querySelectorAll("input, select").forEach(element => {

            if (element.name) {

                element.name =
                    element.name.replace(
                        /items-\d+-/,
                        `items-${index}-`
                    );
            }

            if (element.id) {

                element.id =
                    element.id.replace(
                        /items-\d+-/,
                        `items-${index}-`
                    );
            }

        });

    });


    totalFormsInput.value = rows.length;


    if (rows.length === 0 && emptyMsg) {
        emptyMsg.style.display = "block";
    }
}


/* =========================================================
   ITEM COUNT
   ========================================================= */

function updateItemCount() {

    const rows =
        document.querySelectorAll(".request-row");

    const badge =
        document.getElementById("item-count-badge");

    if (!badge) {
        return;
    }

    badge.textContent =
        `${rows.length} item${rows.length === 1 ? "" : "s"}`;
}


/* =========================================================
   INITIALIZE
   ========================================================= */

document.addEventListener("DOMContentLoaded", function () {

    document
        .querySelectorAll(".request-row")
        .forEach(bindRowEvents);

    updateItemCount();

});
</script>
{% endblock %}



