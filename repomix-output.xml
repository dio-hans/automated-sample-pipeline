        <a href="?preset=today" class="px-3 py-1.5 rounded-md border text-xs font-semibold transition {% if preset == 'today' %}bg-olive text-white border-olive{% else %}bg-slate-50 text-slate-600 border-line hover:bg-slate-100{% endif %}">
            Today
        </a>
        <a href="?preset=last_7_days" class="px-3 py-1.5 rounded-md border text-xs font-semibold transition {% if preset == 'last_7_days' %}bg-olive text-white border-olive{% else %}bg-slate-50 text-slate-600 border-line hover:bg-slate-100{% endif %}">
            This Week
        </a>
        <a href="?preset=this_month" class="px-3 py-1.5 rounded-md border text-xs font-semibold transition {% if preset == 'this_month' %}bg-olive text-white border-olive{% else %}bg-slate-50 text-slate-600 border-line hover:bg-slate-100{% endif %}">
            This Month
        </a>
    </div>

