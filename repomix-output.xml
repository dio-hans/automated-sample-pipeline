            {% if request.user.is_authenticated %} 
            <button type="button" id="sidebarToggle" aria-label="Open navigation" class="lg:hidden w-9 h-9 rounded-lg border border-line bg-white flex items-center justify-center text-ink">Menu</button> 
            {% endif %} 
