                    <tr class="bg-slate-50/50 border-b border-[#E4DECB] text-slate-600 font-semibold text-xs uppercase tracking-wider">
                        <th class="px-6 py-4">Batch Code</th>
                        <th class="px-6 py-4">Coffee Variety</th>
                        <th class="px-6 py-4 text-right">Available Weight</th>
                        <th class="px-6 py-4 text-right">Reorder Point</th>
                        <th class="px-6 py-4 text-center">Status</th>
                        <th class="px-6 py-4 text-right">Action Desk</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E4DECB] text-slate-700 text-xs">
                    {% for stock in low_stocks %}
                    <tr class="hover:bg-slate-50/50 transition duration-150">
