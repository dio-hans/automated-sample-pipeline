                        {% endfor %}
                    </div>

                    <!-- Coffee Type -->
                    <div>
                        <label for="{{ form.coffee_type.id_for_label }}" class="block text-xs font-medium text-slate-700 mb-1">Classification Type</label>
                        {{ form.coffee_type }}
                        {% for error in form.coffee_type.errors %}
