                                   tabular-nums
                                   {% if row.outstanding %}text-rust{% endif %}">
                            {{ row.outstanding|floatformat:0|intcomma }}
                        </td>

                        <td class="px-3 py-2.5 text-center">

                            {% if row.pending %}

                            <span class="rounded-full bg-amber-50 px-2
                                         py-0.5 text-[10px] font-semibold
                                         text-amber-700">
                                Pending
                            </span>

                            {% else %}

                            <span class="text-[10px] text-slate-400">
                                Clear
                            </span>

                            {% endif %}

                        </td>

                        <td class="px-3 py-2.5 text-right">

                            <a
                                href="{% url 'consignment_branch_detail' company.pk row.branch.pk %}"
                                class="inline-flex h-7 items-center rounded-md bg-orange-400
                                       border border-line px-2.5 text-[11px]
                                       font-medium hover:bg-orange-600"
                            >
                                Manage 
                            </a>

                        </td>

                    </tr>

                    {% empty %}

                    <tr>
                        <td colspan="6"
                            class="px-3 py-8 text-center text-xs text-slate-400">
                            No branches yet. Create the first branch to begin
                            consignment deliveries.
                        </td>
                    </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </section>

    <!-- AUDITS -->
    <section class="rounded-lg border border-line bg-white shadow-sm overflow-hidden">

        <div class="border-b border-line px-3 py-2.5">
            <h2 class="text-sm font-semibold text-slate-800">
                Recent audits
            </h2>
        </div>

        <div class="overflow-x-auto">

            <table class="min-w-full text-xs">

                <thead class="bg-slate-50/80 text-[10px] uppercase
                              tracking-wide text-slate-500">

                    <tr>
                        <th class="px-3 py-2 text-left">Date</th>
                        <th class="px-3 py-2 text-left">Branch</th>
                        <th class="px-3 py-2 text-left">Auditor</th>
                        <th class="px-3 py-2 text-left">Status</th>
                        <th class="px-3 py-2"></th>
                    </tr>

                </thead>

                <tbody class="divide-y divide-slate-100">

                    {% for audit in audits %}

                    <tr>

                        <td class="px-3 py-2.5 whitespace-nowrap">
                            {{ audit.audit_date|date:'d M Y, H:i' }}
                        </td>

                        <td class="px-3 py-2.5">
                            {{ audit.branch.branch_name|default:'Legacy / unassigned' }}
                        </td>

                        <td class="px-3 py-2.5">
                            {{ audit.audited_by }}
                        </td>

                        <td class="px-3 py-2.5">
                            <span class="text-[11px] font-medium">
                                {{ audit.get_status_display }}
                            </span>
                        </td>

                        <td class="px-3 py-2.5 text-right">

                            {% if audit.branch_id %}

                            <a
                                href="{% url 'consignment_audit_detail' company.pk audit.branch_id audit.pk %}"
                                class="text-[11px] font-medium text-olive
                                       hover:underline"
                            >
                                Review →
                            </a>

                            {% else %}

                            <span class="text-[10px] text-amber-700">
                                Reconcile
                            </span>

                            {% endif %}

                        </td>

                    </tr>

                    {% empty %}

                    <tr>
                        <td colspan="5"
                            class="px-3 py-6 text-center text-xs text-slate-400">
                            No audits yet.
                        </td>
                    </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </section>

</div>
{% endblock %}
</file>

