<file path="web/templates/consignments/consignee_form.html">
{% extends "pipeline/base.html" %}

{% block title %}Add Consignee | Nonda{% endblock %}
{% block breadcrumb %}Sales / Consignments / New{% endblock %}
{% block page_title %}Add Consignee{% endblock %}

