                            <span class="font-bold
                                {% if item.available <= 0 %}
                                    text-red-600
                                {% elif item.available <= 10 %}
                                    text-amber-600
                                {% else %}
                                    text-gray-900
                                {% endif %}
                            ">
                                {{ item.available }}
                            </span>

                            {% if item.available <= 10 %}
                                <div class="text-[11px] text-amber-600 mt-1">
                                    Low stock
                                </div>
                            {% endif %}
                        </td>

                        <td class="px-6 py-4 text-right text-gray-700">
                            {{ item.packs_released }}
                        </td>

                        <td class="px-6 py-4 text-right text-gray-700">
                            {{ item.packs_returned }}
