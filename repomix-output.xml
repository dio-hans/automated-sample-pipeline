<!-- =========================================================
     PAYMENT HISTORY
========================================================== -->
<section class="bg-white border border-line rounded-xl overflow-hidden">

    <div class="px-6 py-5 border-b border-line
                flex flex-col sm:flex-row sm:items-center
                sm:justify-between gap-3">

        <div>

            <h2 class="font-display text-xl text-ink">
                Payment History
            </h2>

            <p class="text-sm text-clay mt-1">
                Every payment collected against this release.
            </p>

        </div>

        {% if release.outstanding_balance > 0 %}
            <a href="{% url 'record_installment' release.pk %}"
               class="inline-flex items-center justify-center
                      px-4 py-2.5 rounded-md
                      bg-rust text-white text-sm font-semibold
                      hover:bg-rust-dark transition">
                Record Payment
            </a>
        {% endif %}

    </div>


    {% if payments %}

        <div class="overflow-x-auto">

            <table class="w-full text-sm">

                <thead class="bg-paper border-b border-line">

                    <tr>

                        <th class="px-6 py-3 text-left
                                   text-[10px] uppercase tracking-wider
                                   font-bold text-clay">
                            Date
                        </th>

                        <th class="px-6 py-3 text-left
                                   text-[10px] uppercase tracking-wider
                                   font-bold text-clay">
                            Method
                        </th>

                        <th class="px-6 py-3 text-right
                                   text-[10px] uppercase tracking-wider
                                   font-bold text-clay">
                            Amount
                        </th>

                        <th class="px-6 py-3 text-left
                                   text-[10px] uppercase tracking-wider
                                   font-bold text-clay">
                            Reference
                        </th>

                        <th class="px-6 py-3 text-left
                                   text-[10px] uppercase tracking-wider
                                   font-bold text-clay">
                            Collected By
                        </th>

                    </tr>

                </thead>


                <tbody class="divide-y divide-line">

                    {% for payment in payments %}

                        <tr class="hover:bg-paper transition">

                            <td class="px-6 py-4 text-clay">
                                {{ payment.collected_at|date:"d M Y, H:i" }}
                            </td>

                            <td class="px-6 py-4">

                                <p class="font-medium text-ink">
                                    {{ payment.get_payment_method_display }}
                                </p>

                            </td>

                            <td class="px-6 py-4 text-right
                                       font-semibold text-emerald-700">
                                UGX {{ payment.amount|floatformat:0 }}
                            </td>

                            <td class="px-6 py-4 text-clay">

                                {% if payment.payment_reference %}
                                    {{ payment.payment_reference }}
                                {% else %}
                                    —
                                {% endif %}

                            </td>

                            <td class="px-6 py-4 text-ink">
                                {{ payment.collected_by|default:"—" }}
                            </td>

                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    {% else %}

        <div class="px-6 py-12 text-center">

            <p class="text-sm font-medium text-ink">
                No payments recorded yet.
            </p>

            <p class="text-xs text-clay mt-1">
                This release is currently unpaid unless an initial payment
                was recorded elsewhere in the release transaction.
            </p>

            {% if release.outstanding_balance > 0 %}

                <a href="{% url 'record_installment' release.pk %}"
                   class="inline-flex items-center mt-4
                          px-4 py-2.5 rounded-md
                          bg-rust text-white text-sm font-semibold
                          hover:bg-rust-dark transition">
                    Record First Payment
                </a>

            {% endif %}

        </div>

    {% endif %}

</section>


<!-- =========================================================
     RETURN HISTORY
========================================================== -->
<section class="bg-white border border-line rounded-xl overflow-hidden">

    <div class="px-6 py-5 border-b border-line
                flex flex-col sm:flex-row sm:items-center
                sm:justify-between gap-3">

        <div>

            <h2 class="font-display text-xl text-ink">
                Return History
            </h2>

            <p class="text-sm text-clay mt-1">
                Physical returns and their financial treatment.
            </p>

        </div>

        {% if release.packs_outstanding > 0 %}
            <a href="{% url 'pack_return_create' release.pk %}"
               class="inline-flex items-center justify-center
                      px-4 py-2.5 rounded-md
                      border border-rust text-rust
                      bg-white text-sm font-semibold
                      hover:bg-paper transition">
                Record Return
            </a>
        {% endif %}

    </div>


    {% if returns %}

        <div class="overflow-x-auto">

            <table class="w-full text-sm">

                <thead class="bg-paper border-b border-line">

                    <tr>

                        <th class="px-6 py-3 text-left
                                   text-[10px] uppercase tracking-wider
                                   font-bold text-clay">
                            Date
                        </th>

                        <th class="px-6 py-3 text-right
                                   text-[10px] uppercase tracking-wider
                                   font-bold text-clay">
                            Quantity
                        </th>

                        <th class="px-6 py-3 text-left
                                   text-[10px] uppercase tracking-wider
                                   font-bold text-clay">
                            Condition
                        </th>

                        <th class="px-6 py-3 text-left
                                   text-[10px] uppercase tracking-wider
                                   font-bold text-clay">
                            Disposition
                        </th>

                        <th class="px-6 py-3 text-right
                                   text-[10px] uppercase tracking-wider
                                   font-bold text-clay">
                            Financial Credit
                        </th>

                        <th class="px-6 py-3 text-left
                                   text-[10px] uppercase tracking-wider
                                   font-bold text-clay">
                            Received By
                        </th>

                    </tr>

                </thead>


                <tbody class="divide-y divide-line">

                    {% for returned in returns %}

                        <tr class="hover:bg-paper transition">

                            <td class="px-6 py-4 text-clay">
                                {{ returned.returned_at|date:"d M Y, H:i" }}
                            </td>


                            <td class="px-6 py-4 text-right
                                       font-semibold text-ink">
                                {{ returned.packs_returned }}
                            </td>


                            <td class="px-6 py-4">

                                <p class="font-medium text-ink">
                                    {{ returned.get_condition_display }}
                                </p>

                            </td>


                            <td class="px-6 py-4">

                                {% if returned.disposition == "accept" %}

                                    <span class="inline-flex items-center
                                                 px-2.5 py-1 rounded-full
                                                 bg-emerald-50
                                                 text-emerald-700
                                                 text-xs font-semibold">
                                        {{ returned.get_disposition_display }}
                                    </span>

                                {% elif returned.disposition == "accept_charge" %}

                                    <span class="inline-flex items-center
                                                 px-2.5 py-1 rounded-full
                                                 bg-amber-50
                                                 text-amber-700
                                                 text-xs font-semibold">
                                        {{ returned.get_disposition_display }}
                                    </span>

                                {% elif returned.disposition == "refuse" %}

                                    <span class="inline-flex items-center
                                                 px-2.5 py-1 rounded-full
                                                 bg-rose-50
                                                 text-rose-700
                                                 text-xs font-semibold">
                                        {{ returned.get_disposition_display }}
                                    </span>

                                {% else %}

                                    <span class="inline-flex items-center
                                                 px-2.5 py-1 rounded-full
                                                 bg-slate-100
                                                 text-slate-600
                                                 text-xs font-semibold">
                                        {{ returned.get_disposition_display }}
                                    </span>

                                {% endif %}

                            </td>


                            <td class="px-6 py-4 text-right">

                                {% if returned.financial_credit > 0 %}

                                    <p class="font-semibold text-emerald-700">
                                        UGX {{ returned.financial_credit|floatformat:0 }}
                                    </p>

                                {% else %}

                                    <p class="text-clay">
                                        —
                                    </p>

                                {% endif %}

                            </td>


                            <td class="px-6 py-4 text-ink">
                                {{ returned.received_by|default:"—" }}
                            </td>

                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    {% else %}

        <div class="px-6 py-12 text-center">

            <p class="text-sm font-medium text-ink">
                No returns recorded.
            </p>

            <p class="text-xs text-clay mt-1">
                Returned packs will appear here with their condition,
                disposition and financial effect.
            </p>

        </div>

    {% endif %}

</section>


<!-- =========================================================
     RELEASE NOTES
========================================================== -->
{% if release.notes %}

    <section class="bg-white border border-line rounded-xl overflow-hidden">

        <div class="px-6 py-5 border-b border-line">

            <h2 class="font-display text-xl text-ink">
                Release Notes
            </h2>

        </div>

        <div class="p-6">

            <p class="text-sm text-clay leading-relaxed whitespace-pre-line">
                {{ release.notes }}
            </p>

        </div>

    </section>

{% endif %}


<!-- =========================================================
     FINAL ACCOUNT POSITION
========================================================== -->
<section class="bg-paper border border-line rounded-xl p-6">

    <div class="flex flex-col md:flex-row
                md:items-center md:justify-between gap-5">

        <div>

            <p class="text-[10px] uppercase tracking-wider font-bold text-clay">
                Current Account Position
            </p>

            <h3 class="font-display text-xl text-ink mt-1">
                {{ release.released_to.name }}
            </h3>

            <p class="text-sm text-clay mt-1">
                Release #{{ release.pk }}
            </p>

        </div>


        <div class="text-left md:text-right">

            {% if release.outstanding_balance > 0 %}

                <p class="text-xs uppercase tracking-wider
                          font-bold text-clay">
                    Amount Still Owed
                </p>

                <p class="font-display text-3xl text-rust mt-1">
                    UGX {{ release.outstanding_balance|floatformat:0 }}
                </p>

            {% else %}

                <p class="text-xs uppercase tracking-wider
                          font-bold text-emerald-700">
                    Account Cleared
                </p>

                <p class="font-display text-3xl text-emerald-700 mt-1">
                    UGX 0
                </p>

            {% endif %}

        </div>

    </div>

</section>
```

</div>

{% endblock %}
</file>

<file path="web/templates/pipeline/packaged_product_detail.html">
{% extends "pipeline/base.html" %}
{% load static humanize %}

{% block title %}
{{ product.blend.name }} {{ product.pack_size.label }} | Nonda
{% endblock %}

{% block header_action %}
 <div>
            <a href="{% url 'packaging_run_create' %}"
               class="inline-flex items-center gap-1 px-3 py-1.5 rounded bg-rust hover:bg-rust-dark text-white text-xs font-semibold shadow-xs transition">
                Record Packaging
            </a>
        </div>
{% endblock %}

{% block content %}
<div class="space-y-3">

    <!-- TOP BAR: BREADCRUMB + PAGE TITLE + ACTION -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-1 border-b border-[#E4DECB]">
        <div>
            <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                Inventory / Packaged Coffee / <span class="text-slate-600">{{ product.blend.name }} {{ product.pack_size.label }}</span>
            </div>
            <div class="flex items-center gap-2 mt-0.5">
                <h1 class="text-base font-bold text-slate-800 leading-tight">{{ product.blend.name }}</h1>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider {% if product.form == 'beans' %}bg-amber-50 text-amber-700 border border-amber-100{% else %}bg-slate-100 text-slate-700 border border-slate-200{% endif %}">
                    {{ product.get_form_display }}
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600 border border-[#E4DECB]">
                    {{ product.pack_size.label }}
                </span>
            </div>
        </div>
       
    </div>

    <!-- 1. COMPACT KPI SUMMARY CARDS -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- Tile 1: Available Packs -->
        <div class="bg-white border border-[#E4DECB] rounded-lg p-2.5 shadow-2xs">
            <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Available Stock</p>
            <div class="flex items-baseline gap-1 mt-0.5">
                <span class="font-bold text-xl {% if inventory.available <= 10 %}text-amber-600{% else %}text-slate-800{% endif %}">
                    {{ inventory.available|default:"0"|intcomma }}
                </span>
                <span class="text-[11px] font-normal text-slate-400">packs</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-0.5">Ready for release/sale</p>
        </div>

        <!-- Tile 2: Released Packs -->
        <div class="bg-white border border-[#E4DECB] rounded-lg p-2.5 shadow-2xs">
            <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Released</p>
            <div class="flex items-baseline gap-1 mt-0.5">
                <span class="font-bold text-xl text-slate-800">{{ inventory.packs_released|default:"0"|intcomma }}</span>
                <span class="text-[11px] font-normal text-slate-400">packs</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-0.5">Dispatched to channels</p>
        </div>

        <!-- Tile 3: Returned Packs -->
        <div class="bg-white border border-[#E4DECB] rounded-lg p-2.5 shadow-2xs">
            <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Returned</p>
            <div class="flex items-baseline gap-1 mt-0.5">
                <span class="font-bold text-xl text-slate-800">{{ inventory.packs_returned|default:"0"|intcomma }}</span>
                <span class="text-[11px] font-normal text-slate-400">packs</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-0.5">Returned to stock</p>
        </div>

        <!-- Tile 4: Pack Weight -->
        <div class="bg-white border border-[#E4DECB] rounded-lg p-2.5 shadow-2xs">
            <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Pack Weight</p>
            <div class="flex items-baseline gap-1 mt-0.5">
                <span class="font-bold text-xl text-slate-800">{{ product.kg_per_pack }}</span>
                <span class="text-[11px] font-normal text-slate-400">Kg / pack</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-0.5">Standard unit weight</p>
        </div>
    </div>


    <!-- 3. RELEASE & RETURN HISTORY TABLE -->
    <div class="bg-white border border-[#E4DECB] rounded-lg shadow-2xs overflow-hidden">
        <div class="px-3 py-2 bg-slate-50/80 border-b border-[#E4DECB] flex items-center justify-between">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Release & Return History</h2>
            <span class="text-[11px] text-slate-400">Stock issued to sales, events, or personnel</span>
        </div>
        <div class="overflow-x-auto w-full">
            <table class="w-full text-xs text-left border-collapse bg-white min-w-[700px]">
                <thead>
                    <tr class="bg-slate-100/80 border-b border-[#E4DECB] text-slate-600 font-semibold uppercase tracking-wider text-[11px]">
                        <th class="px-3 py-2">Date</th>
                        <th class="px-3 py-2">Released To</th>
                        <th class="px-3 py-2 text-right">Out</th>
                        <th class="px-3 py-2 text-right">Sold</th>
                        <th class="px-3 py-2 text-right">Returned</th>
                        <th class="px-3 py-2 text-center">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E4DECB] text-slate-700">
                    {% for release in releases %}
                    <tr class="hover:bg-slate-50/80 transition">
                        <td class="px-3 py-2 text-slate-400 font-medium whitespace-nowrap">{{ release.released_at|date:"d M Y, H:i" }}</td>
                        <td class="px-3 py-2 font-semibold text-slate-800">{{ release.released_to|default:"-" }}</td>
                        <td class="px-3 py-2 text-right font-bold text-slate-900">{{ release.packs_out }}</td>
                        <td class="px-3 py-2 text-right text-slate-600">{{ release.packs_sold|default:"0" }}</td>
                        <td class="px-3 py-2 text-right font-medium {% if release.packs_returned > 0 %}text-emerald-700 font-bold{% else %}text-slate-600{% endif %}">
                            {{ release.packs_returned|default:"0" }}
                        </td>
                        <td class="px-3 py-2 text-center whitespace-nowrap">
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700 border border-[#E4DECB] uppercase tracking-wider">
                                {{ release.get_status_display }}
                            </span>
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="6" class="px-3 py-6 text-center text-slate-400 italic bg-white">
                            No releases recorded for this product yet.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
</file>

<file path="web/templates/pipeline/processing_workspace.html">
{% extends "pipeline/base.html" %}

{% block title %}Processing Workspace | Nonda{% endblock %}

{% block breadcrumb %}
Inventory / Processing
{% endblock %}

{% block page_title %}
Processing Workspace
{% endblock %}

{% block page_subtitle %}
<p class="mt-1 text-sm text-slate-500">
    Load coffee into roasting, sorting, or grinding operations and receive the measured output back into the stock ledger.
</p>
{% endblock %}

{% block content %}

<div class="space-y-8">

    <!-- =========================================================
         1. ACTIVE PROCESSING RUNS
         ========================================================= -->
    <section class="bg-white border border-[#E4DECB] rounded-xl p-5 shadow-sm space-y-4">

        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-sm font-semibold text-slate-800">
                    Active Processing Runs
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">
                    Coffee currently in roasting, sorting, or grinding. Complete the run after the actual output has been weighed.
                </p>
            </div>
            {% if open_runs %}
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                {{ open_runs|length }} Active
            </span>
            {% endif %}
        </div>

        <div class="overflow-x-auto border border-[#E4DECB] rounded-lg">
            <table class="w-full text-sm text-left bg-white border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-[#E4DECB] text-slate-600 font-semibold text-xs uppercase tracking-wider">
                        <th class="px-6 py-3">Issued Date</th>
                        <th class="px-6 py-3">Batch Reference</th>
                        <th class="px-6 py-3">Operation</th>
                        <th class="px-6 py-3 text-right">Input</th>
                        <th class="px-6 py-3 text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E4DECB] text-slate-700 text-xs">
                    {% for run in open_runs %}
                    <tr class="hover:bg-slate-50/50 transition">
                        <td class="px-6 py-4 text-slate-500 font-medium whitespace-nowrap">
                            {{ run.issued_at|date:"d M Y, H:i" }}
                        </td>
                        <td class="px-6 py-4">
                            <div class="font-bold text-slate-900">
                                {{ run.stock.batch_number }}
                            </div>
                    
                        </td>
                        <td class="px-6 py-4">
                            {% if run.process_type == "roasting" %}
                                <span class="inline-flex px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-50 text-amber-700 border border-amber-200">
                                    Roasting
                                </span>
                            {% elif run.process_type == "sorting" %}
                                <span class="inline-flex px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-50 text-blue-700 border border-blue-200">
                                    Sorting
                                </span>
                            {% elif run.process_type == "grinding" %}
                                <span class="inline-flex px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-orange-50 text-orange-700 border border-orange-200">
                                    Grinding
                                </span>
                            {% else %}
                                <span class="inline-flex px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-600 border border-slate-200">
                                    {{ run.get_process_type_display }}
                                </span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-right text-slate-500">
                            {{ run.input_quantity|floatformat:2 }} kg
                        </td>
                        <td class="px-6 py-4 text-center">
                            <button
                                type="button"
                                onclick="openCompleteModal(
                                    '{{ run.pk }}',
                                    '{{ run.stock.batch_number|escapejs }}',
                                    '{{ run.process_type }}',
                                    '{{ run.input_quantity }}',
                                    '{% url 'complete_processing' pk=run.pk %}'
                                )"
                                class="px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 rounded-lg font-semibold text-xs shadow-sm transition">
                                Complete Run
                            </button>
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="5" class="px-6 py-10 text-center text-slate-400 italic">
                            No active processing runs currently in progress.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </section>

    <!-- =========================================================
         2. AVAILABLE WAREHOUSE LOTS
         ========================================================= -->
    <section class="bg-white border border-[#E4DECB] rounded-xl p-5 shadow-sm space-y-4">

        <div>
            <h2 class="text-sm font-semibold text-slate-800">
                Available Warehouse Lots
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">
                Select the coffee stage that should enter the next processing operation.
            </p>
        </div>

        <div class="overflow-x-auto border border-[#E4DECB] rounded-lg">
            <table class="w-full text-sm text-left bg-white border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-[#E4DECB] text-slate-600 font-semibold text-xs uppercase tracking-wider">
                        <th class="px-6 py-3">Batch Number</th>
                        <th class="px-6 py-3">Variety</th>
                        <th class="px-6 py-3 text-right">Green</th>
                        <th class="px-6 py-3 text-right">Roasted</th>
                        <th class="px-6 py-3 text-right">Ground</th>
                        <th class="px-6 py-3 text-right">Quackers</th>
                        <th class="px-6 py-3 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E4DECB] text-slate-700 text-xs">
                    {% for stock in stocks %}
                    <tr class="hover:bg-slate-50/50 transition">
                        <td class="px-6 py-4 font-bold text-slate-900">
                            {{ stock.batch_number }}
                        </td>
                        <td class="px-6 py-4 font-semibold text-slate-800">
                            {{ stock.variety.name }}
                        </td>
                        <td class="px-6 py-4 text-right text-slate-500">
                            {{ stock.quantity_green|default:"0.00"|floatformat:2 }} kg
                        </td>
                        <td class="px-6 py-4 text-right text-slate-500">
                            {{ stock.quantity_roasted|default:"0.00"|floatformat:2 }} kg
                        </td>
                        <td class="px-6 py-4 text-right text-slate-500">
                            {{ stock.quantity_ground|default:"0.00"|floatformat:2 }} kg
                        </td>
                        <td class="px-6 py-4 text-right text-slate-500">
                            {{ stock.quantity_quakers|default:"0.00"|floatformat:2 }} kg
                        </td>
                        <td class="px-6 py-4 text-center">
                            <div class="inline-flex items-center justify-center gap-2">
                                {% if stock.quantity_green > 0 %}
                                <button
                                    type="button"
                                    onclick="openIssueModal('roasting', '{{ stock.pk }}', '{{ stock.batch_number|escapejs }}', '{{ stock.quantity_green }}', '{% url 'issue_processing' stock.pk %}')"
                                    class="px-2.5 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded-lg text-xs font-semibold shadow-sm transition">
                                    Roast
                                </button>
                                {% endif %}

                               {% if stock.quantity_roasted > 0 %}
                                <button
                                    type="button"
                                    onclick="openIssueModal(
                                        'sorting',
                                        '{{ stock.pk }}',
                                        '{{ stock.batch_number|escapejs }}',
                                        '{{ stock.quantity_roasted }}',
                                        '{% url 'issue_processing' stock.pk %}'
                                    )"
                                    class="px-2.5 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 rounded-lg text-xs font-semibold shadow-sm transition">
                                    Sort
                                </button>
                                {% endif %}

                                                                {% if stock.quantity_roasted > 0 %}
                                <button
                                    type="button"
                                    onclick="openIssueModal('grinding', '{{ stock.pk }}', '{{ stock.batch_number|escapejs }}', '{{ stock.quantity_roasted }}', '{% url 'issue_processing' stock.pk %}')"
                                    class="px-2.5 py-1.5 bg-orange-50 hover:bg-orange-100 text-orange-700 border border-orange-200 rounded-lg text-xs font-semibold shadow-sm transition">
                                    Grind
                                </button>
                                {% endif %}

                                {% if stock.quantity_green <= 0 and stock.quantity_roasted <= 0 %}
                                <span class="text-[11px] text-slate-400 italic">No available stock</span>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="6" class="px-6 py-10 text-center text-slate-400 italic">
                            No warehouse lots available for processing.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </section>

</div>

<!-- =========================================================
     MODAL A — START PROCESSING RUN
     ========================================================= -->
<div id="issueModal" class="fixed inset-0 z-50 overflow-y-auto hidden">
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs" onclick="closeModal('issueModal')"></div>

    <div class="flex min-h-screen items-center justify-center p-4">
        <div class="relative bg-white border border-[#E4DECB] rounded-xl p-6 shadow-xl w-full max-w-md">

            <h3 id="issueModalTitle" class="font-display text-lg font-bold text-slate-800 mb-4">
                Start Processing
            </h3>

            <form method="POST" id="issueForm" class="space-y-4">
                {% csrf_token %}

                <input type="hidden" name="process_type" id="id_process_type">

                <div class="bg-slate-50 border border-[#E4DECB] rounded-lg p-3">
                    <p class="text-xs text-slate-500">
                        Batch: <strong id="issue_batch_lbl" class="text-slate-900 font-mono"></strong>
                    </p>
                </div>

                <div>
                    <label for="id_input_qty" class="block text-xs font-semibold text-slate-600 mb-1">
                        Input Quantity (Kg)
                    </label>
                    <input
                        type="number"
                        name="input_quantity"
                        id="id_input_qty"
                        required
                        step="0.01"
                        min="0.01"
                        class="w-full rounded-md border border-[#E4DECB] px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-rust font-mono"
                        placeholder="0.00">
                    <p class="mt-1 text-[10px] text-slate-400">
                        Maximum available: <span id="issue_max_qty" class="font-semibold font-mono">0.00</span> kg
                    </p>
                </div>

                <div>
                    <label for="id_issue_notes" class="block text-xs font-semibold text-slate-600 mb-1">
                        Notes
                    </label>
                    <textarea
                        name="notes"
                        id="id_issue_notes"
                        rows="2"
                        class="w-full rounded-md border border-[#E4DECB] px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-rust"
                        placeholder="Optional processing note..."></textarea>
                </div>

                <div class="flex justify-end gap-2 pt-3 border-t border-slate-100">
                    <button
                        type="button"
                        onclick="closeModal('issueModal')"
                        class="px-4 py-2 border border-[#E4DECB] rounded-lg text-xs font-medium text-slate-600 hover:bg-slate-50 transition">
                        Cancel
                    </button>
                    <button
                        type="submit"
                        class="px-4 py-2 bg-rust hover:bg-rust-dark text-white rounded-lg text-xs font-semibold shadow-sm transition">
                        Start Run
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- =========================================================
     MODAL B — COMPLETE PROCESSING RUN
     ========================================================= -->
<div id="completeModal" class="fixed inset-0 z-50 overflow-y-auto hidden">
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs" onclick="closeModal('completeModal')"></div>
    <div class="flex min-h-screen items-center justify-center p-4">
        <div class="relative bg-white border border-[#E4DECB] rounded-xl p-6 shadow-xl w-full max-w-md">
            <h3 id="completeModalTitle" class="font-display text-lg font-bold text-slate-800 mb-4">
                Complete Processing Run
            </h3>

            <form method="POST" id="completeForm" class="space-y-4">
                {% csrf_token %}
                <div class="bg-slate-50 border border-[#E4DECB] rounded-lg p-3 space-y-1">
                    <p class="text-xs text-slate-500">
                        Batch: <strong id="complete_batch_lbl" class="text-slate-900 font-mono"></strong>
                    </p>
                    <p class="text-xs text-slate-500">
                        Input Quantity: <span id="complete_input_lbl" class="font-semibold text-slate-800 font-mono"></span> kg
                    </p>
                </div>

                <!-- Output Quantity Field -->
                <div id="standard_output_section">
                    <label for="id_output_qty" id="standard_output_label" class="block text-xs font-semibold text-emerald-700 mb-1.5">
                        Output Quantity (Kg)
                    </label>
                    <input
                        type="number"
                        name="output_quantity"
                        id="id_output_qty"
                        step="0.01"
                        min="0"
                        class="w-full rounded-md border border-[#E4DECB] px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 font-mono"
                        placeholder="0.00">
                </div>

                <!-- Quaker Field (Hidden by default, displayed by JS during Sorting) -->
                

                <!-- Notes -->
                <div>
                    <label for="id_complete_notes" class="block text-xs font-semibold text-slate-600 mb-1.5">
                        Notes
                    </label>
                    <textarea
                        name="notes"
                        id="id_complete_notes"
                        rows="2"
                        class="w-full rounded-md border border-[#E4DECB] px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-rust"
                        placeholder="Optional processing notes..."></textarea>
                </div>

                <div class="flex justify-end gap-2 pt-3 border-t border-slate-100">
                    <button
                        type="button"
                        onclick="closeModal('completeModal')"
                        class="px-4 py-2 border border-[#E4DECB] rounded-lg text-xs font-medium text-slate-600 hover:bg-slate-50 transition">
                        Cancel
                    </button>
                    <button
                        type="submit"
                        class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold shadow-sm transition">
                        Receive Back to Store
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{% endblock %}

{% block extra_scripts %}
<script>
function openIssueModal(type, pk, batchNum, maxQty, actionUrl) {
    const modal = document.getElementById("issueModal");
    const form = document.getElementById("issueForm");

    const title = document.getElementById("issueModalTitle");
    const processInput = document.getElementById("id_process_type");
    const inputQty = document.getElementById("id_input_qty");
    const batchLabel = document.getElementById("issue_batch_lbl");
    const maxQtyLabel = document.getElementById("issue_max_qty");

    batchLabel.textContent = batchNum;
    processInput.value = type;
    inputQty.value = "";
    inputQty.max = maxQty;
    maxQtyLabel.textContent = Number(maxQty).toFixed(2);
    form.action = actionUrl;

    if (type === "roasting") {
        title.textContent = "Load Coffee into Roaster";
    } else if (type === "sorting") {
        title.textContent = "Load Coffee for Sorting";
    } else if (type === "grinding") {
        title.textContent = "Load Coffee into Grinder";
    } else {
        title.textContent = "Start Processing";
    }

    modal.classList.remove("hidden");
}
function openCompleteModal(runPk, batchNum, type, inputQty, actionUrl) {
    const modal = document.getElementById("completeModal");
    const form = document.getElementById("completeForm");

    const title = document.getElementById("completeModalTitle");
    const batchLabel = document.getElementById("complete_batch_lbl");
    const inputLabel = document.getElementById("complete_input_lbl");
    const outputLabel = document.getElementById("standard_output_label");
    const outputInput = document.getElementById("id_output_qty");

    batchLabel.textContent = batchNum;
    inputLabel.textContent = Number(inputQty).toFixed(2);
    form.action = actionUrl;

    outputInput.value = "";
    outputInput.required = true;

    if (type === "sorting") {
        title.textContent = "Complete Sorting Run";
        outputLabel.textContent = "Sorted Coffee Output (Kg)";
    } else if (type === "roasting") {
        title.textContent = "Complete Roasting Run";
        outputLabel.textContent = "Output Quantity (Kg)";
    } else if (type === "grinding") {
        title.textContent = "Complete Grinding Run";
        outputLabel.textContent = "Output Quantity (Kg)";
    } else {
        title.textContent = "Complete Processing Run";
        outputLabel.textContent = "Output Quantity (Kg)";
    }

    modal.classList.remove("hidden");
}

function closeModal(id) {
    const modal = document.getElementById(id);
    if (modal) {
        modal.classList.add("hidden");
    }
}
</script>
{% endblock %}
</file>

<file path="web/templates/pipeline/sales_stock.html">
{% extends "pipeline/base.html" %}
{% load humanize %}

{% block title %}My Issued Stock | Nonda{% endblock %}
{% block breadcrumb %}Sales / My Issued Stock{% endblock %}
{% block page_title %}My Issued Stock{% endblock %}
{% block page_subtitle %}
<p class="mt-0.5 text-xs text-slate-500">
    View active orders and stock issued to you awaiting full payment settlement.
</p>
{% endblock %}

{% block header_action %}
<a href="{% url 'stock_request_create' %}"
   class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-rust hover:bg-rust/90 text-white text-xs font-bold shadow-sm transition active:scale-95">
   
    Request Stock
</a>
{% endblock %}

{% block content %}

<div class="space-y-4">
    
    <!-- Header Summary Bar -->
    <div class="bg-white border border-slate-200/80 rounded-xl shadow-xs p-3 flex items-center justify-between">
        <div>
            <p class="text-[9px] uppercase tracking-widest font-bold text-slate-400">Sales Inventory</p>
            <h1 class="text-xs font-bold text-slate-800">Active Issued Orders</h1>
        </div>
        <div class="text-right">
            <span class="text-[9px] uppercase tracking-wider font-bold text-slate-400">Total Cards</span>
            <p class="text-xs font-bold font-mono text-slate-800">{{ orders|length|default:releases|length }} Active</p>
        </div>
    </div>

    <!-- Cards Grid Section -->
    {% if orders or releases %}
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
            
            {% comment %} Primary Loop: Display Grouped Orders or Releases {% endcomment %}
            {% for order in orders %}
            <div onclick="openOrderModal('order_modal_{{ order.pk }}')" 
                 class="bg-slate-900 text-white rounded-xl p-3.5 shadow-xs border border-slate-800 transition-all hover:scale-[1.01] hover:border-slate-700 cursor-pointer flex flex-col justify-between text-left">
                
                <div>
                    <!-- Card Header -->
                    <div class="flex items-center justify-between gap-2 mb-1.5">
                        <span class="text-[10px] font-mono tracking-wider text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-900/40 px-2 py-0.5 rounded">
                            {% if order.product %}PK-{{ order.pk }}{% else %}N-{{ order.short_number|default:order.pk }}{% endif %}
                        </span>
                        <span class="text-[9px] font-mono text-slate-400">
                            {{ order.requested_at|date:"d M, H:i" }}
                        </span>
                    </div>
                    
                    <!-- Card Title & Details -->
                    {% if order.product %}
                        <h3 class="text-sm font-semibold tracking-tight text-slate-100 truncate">
                            {{ order.product.blend.name }}
                        </h3>
                        <p class="text-[10px] text-slate-400">
                            {{ order.product.pack_size.label }} · {{ order.product.get_form_display }}
                        </p>
                    {% else %}
                        <h3 class="text-sm font-semibold tracking-tight text-slate-100 truncate">
                            {% if order.account_holder %}
                                {{ order.account_holder.name }}
                            {% elif order.requested_by %}
                                {{ order.requested_by.get_full_name|default:order.requested_by.username }}
                            {% else %}
                                My Direct Issue
                            {% endif %}
                        </h3>
                    {% endif %}
                </div>

                <!-- Financial Total -->
                <div class="mt-3 pt-2 border-t border-slate-800/80 flex items-end justify-between">
                    <span class="text-[9px] uppercase tracking-wider font-bold text-slate-400">Release Value</span>
                    <p class="text-sm font-extrabold font-mono text-orange-400 leading-none">
                        UGX {{ order.total_value|floatformat:0|intcomma }}
                    </p>
                </div>
            </div>

            <!-- Detail Modal -->
            <div id="order_modal_{{ order.pk }}" class="fixed inset-0 bg-slate-950/70 backdrop-blur-xs z-50 hidden items-center justify-center p-3">
                <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full overflow-hidden border border-slate-200 text-left flex flex-col animate-in fade-in zoom-in-95 duration-150">
                    
                    <div class="bg-slate-950 text-white px-4 py-2.5 flex items-center justify-between border-b border-slate-800 shrink-0">
                        <div>
                            <span class="text-[9px] font-mono tracking-wider text-emerald-400 font-bold uppercase block">
                                Item #{{ order.pk }}
                            </span>
                            <h3 class="text-xs font-bold text-white">Issued Stock Overview</h3>
                        </div>
                        <button type="button" onclick="closeOrderModal('order_modal_{{ order.pk }}')" class="text-slate-400 hover:text-white text-sm font-bold p-1 cursor-pointer">
                            ✕
                        </button>
                    </div>

                    <div class="p-4 space-y-3">
                        <div class="bg-slate-50 border border-slate-200/80 rounded-lg p-2.5 grid grid-cols-2 gap-2 text-xs">
                            <div>
                                <span class="text-[9px] uppercase font-bold text-slate-400 tracking-wider block">Customer / Holder</span>
                                <p class="text-xs font-bold text-slate-800 truncate">
                                    {{ order.account_holder.name|default:"Direct Issue" }}
                                </p>
                            </div>
                            <div class="text-right">
                                <span class="text-[9px] uppercase font-bold text-slate-400 tracking-wider block">Outstanding Balance</span>
                                <p class="text-sm font-black text-rose-600 font-mono">
                                    UGX {{ order.total_outstanding|floatformat:0|intcomma }}
                                </p>
                            </div>
                        </div>

                        <!-- Items Payload -->
                        <div class="space-y-1.5">
                            <h4 class="text-[9px] uppercase tracking-wider font-bold text-slate-500 border-b border-slate-100 pb-1">
                                Issued Items
                            </h4>
                            <div class="space-y-1 max-h-48 overflow-y-auto">
                                {% for release in order.queue_releases %}
                                <div class="bg-slate-50 border border-slate-200/60 rounded-md px-2.5 py-1.5 flex justify-between items-center text-xs">
                                    <div class="truncate">
                                        <p class="font-bold text-slate-800 leading-tight truncate">{{ release.product.blend.name }}</p>
                                        <p class="text-[9px] text-slate-500 leading-tight">{{ release.product.pack_size.label }} · {{ release.product.get_form_display }}</p>
                                    </div>
                                    <div class="text-right shrink-0">
                                        <p class="font-mono font-bold text-slate-700 text-xs">{{ release.packs_out }} pk</p>
                                        <p class="text-[9px] font-mono text-slate-400">Bal: {{ release.packs_outstanding }} pk</p>
                                    </div>
                                </div>
                                {% endfor %}
                                {% for sale in order.queue_bulk_sales %}
                                <div class="bg-slate-50 border border-slate-200/60 rounded-md px-2.5 py-1.5 flex justify-between items-center text-xs">
                                    <div class="truncate">
                                        <p class="font-bold text-slate-800 leading-tight truncate">
                                            {{ sale.stock.variety.name|default:sale.stock.batch_number }} · {{ sale.get_stage_display }}
                                        </p>
                                        <p class="text-[9px] text-slate-500 leading-tight">
                                            Batch {{ sale.stock.batch_number }} · UGX {{ sale.price_per_kg|floatformat:0|intcomma }}/kg
                                        </p>
                                    </div>
                                    <div class="text-right shrink-0 ml-2">
                                        <p class="font-mono font-bold text-slate-700 text-xs">{{ sale.kg_sold|floatformat:2 }} kg</p>
                                        <p class="text-[9px] font-mono text-slate-400">Bal: UGX {{ sale.outstanding_balance|floatformat:0|intcomma }}</p>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-50 px-4 py-2.5 border-t border-slate-200 flex justify-end gap-2 shrink-0">
                        <button type="button" onclick="closeOrderModal('order_modal_{{ order.pk }}')" class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-md text-[11px] font-bold cursor-pointer">
                            Close
                        </button>
                    </div>

                </div>
            </div>
            {% endfor %}

            {% comment %} Fallback Loop: Handles view passing context named 'releases' {% endcomment %}
            {% if not orders %}
                {% for release in releases %}
                <div onclick="openOrderModal('release_modal_{{ release.pk }}')" 
                     class="bg-slate-900 text-white rounded-xl p-3.5 shadow-xs border border-slate-800 transition-all hover:scale-[1.01] hover:border-slate-700 cursor-pointer flex flex-col justify-between text-left">
                    
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-1.5">
                            <span class="text-[10px] font-mono tracking-wider text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-900/40 px-2 py-0.5 rounded">
                                PK-{{ release.pk }}
                            </span>
                            <span class="text-[9px] font-mono text-slate-400">
                                {{ release.created_at|date:"d M, H:i" }}
                            </span>
                        </div>
                        
                        <h3 class="text-sm font-semibold tracking-tight text-slate-100 truncate">
                            {{ release.product.blend.name }}
                        </h3>
                        <p class="text-[10px] text-slate-400">
                            {{ release.product.pack_size.label }} · {{ release.product.get_form_display }}
                        </p>
                    </div>

                    <div class="mt-3 pt-2 border-t border-slate-800/80 flex items-end justify-between">
                        <span class="text-[9px] uppercase tracking-wider font-bold text-slate-400">Release Value</span>
                        <p class="text-sm font-extrabold font-mono text-orange-400 leading-none">
                            UGX {{ release.gross_amount|default:0|floatformat:0|intcomma }}
                        </p>
                    </div>
                </div>

                <!-- Single Release Modal -->
                <div id="release_modal_{{ release.pk }}" class="fixed inset-0 bg-slate-950/70 backdrop-blur-xs z-50 hidden items-center justify-center p-3">
                    <div class="bg-white rounded-xl shadow-2xl max-w-sm w-full overflow-hidden border border-slate-200 text-left p-4 space-y-3">
                        <div class="flex justify-between items-center border-b pb-2">
                            <h3 class="font-bold text-xs text-slate-800">{{ release.product.blend.name }}</h3>
                            <button type="button" onclick="closeOrderModal('release_modal_{{ release.pk }}')" class="text-xs font-bold text-slate-400 hover:text-slate-800">✕</button>
                        </div>
                        <div class="text-xs space-y-1 text-slate-700">
                            <p><strong>Packs Issued:</strong> {{ release.packs_out }}</p>
                            <p><strong>Packs Outstanding:</strong> {{ release.packs_outstanding }}</p>
                            <p><strong>Gross Amount:</strong> UGX {{ release.gross_amount|default:0|floatformat:0|intcomma }}</p>
                            <p><strong>Outstanding Balance:</strong> UGX {{ release.outstanding_balance|default:0|floatformat:0|intcomma }}</p>
                        </div>
                        <div class="pt-2 flex justify-end">
                            <button type="button" onclick="closeOrderModal('release_modal_{{ release.pk }}')" class="px-3 py-1 bg-slate-200 text-slate-700 rounded text-xs font-bold">Close</button>
                        </div>
                    </div>
                </div>
                {% endfor %}
            {% endif %}

        </div>
    {% else %}
        <!-- Empty State -->
        <div class="bg-white border border-slate-200/80 rounded-xl p-8 text-center shadow-2xs space-y-2">
            <div class="w-10 h-10 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center mx-auto text-emerald-600 font-bold text-lg">
                ✓
            </div>
            <h3 class="text-xs font-bold text-slate-800">No Issued Stock Pending</h3>
            <p class="text-[10px] text-slate-400 max-w-sm mx-auto">
                You do not have any active stock orders awaiting clearance.
            </p>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block extra_scripts %}
<script>
function openOrderModal(modalId) {
    const modal = document.getElementById(modalId);
    if (!modal) return;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
}

function closeOrderModal(modalId) {
    const modal = document.getElementById(modalId);
    if (!modal) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
}

document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[id$="_modal_"] > div').forEach(modalBox => {
        modalBox.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    });
});
</script>
{% endblock %}
</file>

<file path="web/templates/pipeline/stock_request_list.html">
{% extends "pipeline/base.html" %}
{% load humanize %}

{% block title %}Stock Requests | Nonda{% endblock %}
{% block breadcrumb %}Stock Control / Requests{% endblock %}
{% block page_title %}Stock Requests Queue{% block page_subtitle %}{% endblock %}{% endblock %}



{% block content %}
<div class="bg-white border border-[#E4DECB] rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left border-collapse bg-white">
            <thead>
                <tr class="bg-slate-50 border-b border-[#E4DECB] text-slate-600 font-semibold">
                    {% if request.user.role == "MANAGER" %}
                    <th class="px-6 py-4">Request Ticket</th>
                    {% endif %}
                    <th class="px-6 py-4">Requested By</th>
                    <th class="px-6 py-4">Allocation Purpose</th>
                    <th class="px-6 py-4">Date Submitted</th>
                    <th class="px-6 py-4 text-center">Fulfillment Status</th>
                    {% if request.user.role == "MANAGER" %}
                    <th class="px-6 py-4 text-right">Action</th>
                    {% endif %}
                </tr>
            </thead>
            <tbody class="divide-y divide-[#E4DECB] text-slate-700">
    {% for req in requests %}
    <tr class="hover:bg-slate-50/50 transition duration-150">
        {% if request.user.role == "MANAGER" %}
        <td class="px-6 py-4 whitespace-nowrap">
            <a class="font-bold text-rust hover:text-rust-dark hover:underline text-xs tracking-wider" href="{% url 'stock_request_detail' req.pk %}">
                {{ req.short_number }}
            </a>
        </td>
        {% endif %}
        
        <td class="px-6 py-4 whitespace-nowrap font-medium text-slate-800">
            {{ req.requested_by.get_full_name|default:req.requested_by.username }}
        </td>
        
        <td class="px-6 py-4 whitespace-nowrap text-xs text-slate-500 font-medium capitalize">
            {{ req.get_purpose_display }}
        </td>
        
        <td class="px-6 py-4 whitespace-nowrap text-xs text-slate-400 font-medium">
            {{ req.requested_at|date:"d M Y, H:i" }}
        </td>
        
        <td class="px-6 py-4 text-center whitespace-nowrap">
            {% if req.status == "partially_fulfilled" %}
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-amber-50 text-amber-700 border border-amber-100 text-xs font-semibold">
                    Partial Dispatch
                </span>
            {% else %}
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 border border-blue-100 text-xs font-semibold">
                    Pending Store
                </span>
            {% endif %}
        </td>

        {% if request.user.role == "MANAGER" %}
        <td class="px-6 py-4 text-right whitespace-nowrap">
            <a href="{% url 'stock_request_detail' req.pk %}" class="text-xs font-bold text-rust hover:text-rust-dark hover:underline">
                Process Order 
            </a>
        </td>
        {% endif %}
    </tr>
    {% empty %}
    <tr>
        <td colspan="6" class="px-6 py-16 text-center text-slate-400">
            <p class="text-xs font-bold text-slate-800">Clear Action Queue</p>
        </td>
    </tr>
    {% endfor %}
</tbody>    
        </table>
    </div>
</div>
{% endblock %}
</file>

<file path="web/services/reporting/finance.py">
"""Finance report: collections come only from PaymentReceipt."""
from collections import defaultdict
from decimal import Decimal
from django.db.models import Sum
from django.utils import timezone
from ...models import (
    Expense,
    CoffeeBatchSale,
    PackRelease,
    PaymentReceipt,
)
from ...models import PAYMENT_METHOD_CHOICES


ZERO = Decimal('0.00')
METHODS = dict(PAYMENT_METHOD_CHOICES)
def money(v): return Decimal(str(v)) if v is not None else ZERO
def ageing_bucket(days):
    if days <= 30: return '0–30 days'
    if days <= 60: return '31–60 days'
    if days <= 90: return '61–90 days'
    return '91+ days'

def get_finance_report(period):
    by_method = {key: ZERO for key in METHODS}
    daily = defaultdict(lambda: ZERO)
    total_collections = ZERO
    payment_count = 0
    qs = period.filter_datetime(PaymentReceipt.objects.all(), 'collected_at')
    for payment in qs.iterator():
        amount = money(payment.amount)
        if amount < 0:
            raise ValueError(f'Negative payment PaymentReceipt #{payment.pk}')
        method = payment.payment_method
        if method == "bank_transfer":
            method = "bank"
        when = payment.collected_at
        by_method[method] = by_method.get(method, ZERO) + amount
        daily[timezone.localtime(when).date().isoformat()] += amount
        total_collections += amount
        payment_count += 1
    expenses = period.filter_date(Expense.objects.all(), 'expense_date')
    expense_rows = list(expenses.values('category').annotate(total=Sum('amount')).order_by('-total'))
    labels = dict(Expense.CATEGORY_CHOICES)
    for row in expense_rows:
        row['label'] = labels.get(row['category'], row['category'])
        row['total'] = money(row['total'])
    total_expenses = sum((r['total'] for r in expense_rows), ZERO)
    releases = PackRelease.objects.select_related(
        'released_to',
        'company',
    ).prefetch_related(
        'settlements',
        'payments',
        'returns',
        'consignment_audit_allocations',
    )
    debtor_map = defaultdict(lambda: {'balance': ZERO, 'invoices': 0})
    age_map = {k: ZERO for k in ('0–30 days','31–60 days','61–90 days','91+ days')}
    unallocated_credit = ZERO
    as_of = timezone.localdate()
    for release in releases.iterator(chunk_size=300):
        settlements = list(release.settlements.all())
        receipts = list(release.payments.all())
        if release.purpose == 'display':
            allocations = list(release.consignment_audit_allocations.all())
            sold_value = sum(
                (
                    money(allocation.quantity) * money(allocation.unit_price)
                    for allocation in allocations
                ),
                ZERO,
            )
        else:
            sold_packs = sum(s.packs_sold for s in settlements)
            sold_value = money(sold_packs) * money(release.selling_price)
        paid = sum((money(p.amount) for p in receipts), ZERO)
        # Do not deduct returns again unless their relationship to confirmed sales is reconciled.
        balance = max(sold_value - paid, ZERO)
        if paid > sold_value: unallocated_credit += paid - sold_value
        if balance <= 0: continue
        debtor = str(release.released_to or release.company or 'Unassigned')
        debtor_map[debtor]['balance'] += balance
        debtor_map[debtor]['invoices'] += 1
        days = max((as_of - timezone.localtime(release.released_at).date()).days, 0)
        age_map[ageing_bucket(days)] += balance
    bulk_sales = CoffeeBatchSale.objects.select_related(
        'account_holder',
        'company',
    ).prefetch_related('payments')
    for sale in bulk_sales.iterator(chunk_size=300):
        sold_value = money(sale.total_amount_due)
        paid = sum((money(payment.amount) for payment in sale.payments.all()), ZERO)
        balance = max(sold_value - paid, ZERO)
        if paid > sold_value:
            unallocated_credit += paid - sold_value
        if balance <= 0:
            continue
        debtor = str(sale.account_holder or sale.company or sale.buyer_name or 'Walk-in')
        debtor_map[debtor]['balance'] += balance
        debtor_map[debtor]['invoices'] += 1
        days = max((as_of - timezone.localtime(sale.sold_at).date()).days, 0)
        age_map[ageing_bucket(days)] += balance
    debtors = sorted(({'name': n, **v} for n,v in debtor_map.items()), key=lambda r:r['balance'], reverse=True)
    return {
        'collections_total':total_collections, 'payment_count':payment_count,
        'payment_methods':[{'key':k,'label':METHODS.get(k,k),'amount':v} for k,v in by_method.items()],
        'collection_days':[{'date':k,'amount':v} for k,v in sorted(daily.items())],
        'expense_total':total_expenses, 'expense_ranking':expense_rows,
        'cash_less_expenses':total_collections-total_expenses,
        'outstanding_receivables':sum((r['balance'] for r in debtors),ZERO),
        'debtors':debtors,'ageing':[{'label':k,'amount':v} for k,v in age_map.items()],
        'unallocated_credit':unallocated_credit,'bulk_receivables_pending':False,
        'ageing_basis':'Days since stock release; not contractual overdue days',
        'timestamp_warning':'Collections are dated by PaymentReceipt.collected_at.',
    }
</file>

<file path="web/templates/pipeline/account_holder_detail.html">
{% extends "pipeline/base.html" %}
{% load humanize %}

{% block title %}{{ account.name }} | Portfolio{% endblock %}

{% block breadcrumb %}Account Holders / {{ account.name }}{% endblock %}

{% block page_subtitle %}
<p class="mt-1 text-xs text-slate-500">
    Type: <span class="font-bold text-slate-700">{{ account.get_account_type_display|default:account.account_type|title }}</span>
    {% if account.phone_number %} · Contact: {{ account.phone_number }}{% endif %}
</p>
{% endblock %}

{% block header_action %}
    {% if can_collect_payment %}
        {% if total_outstanding > 0 %}
            <button
                type="button"
                onclick="openPaymentModal()"
                class="px-4 py-1.5 bg-orange-500 hover:bg-orange-600 text-white rounded-md text-xs font-bold transition-all shadow-xs cursor-pointer inline-flex items-center gap-1.5"
            >
                Record Payment
            </button>
        {% else %}
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                Fully Cleared
            </span>
        {% endif %}
    {% endif %}
{% endblock %}

{% block content %}
<div class="space-y-4">
    
    <!-- =========================================================
         1. SUMMARY CARDS
         ========================================================= -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="bg-white border border-[#E4DECB] rounded-xl p-3.5 shadow-sm">
            <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Total Value Released</p>
            <p class="font-bold text-xl mt-1 text-slate-800">{{ total_value|floatformat:"0"|intcomma }} <span class="text-xs font-normal text-slate-400">UGX</span></p>
            <p class="text-[11px] text-slate-400 mt-0.5">Lifetime inventory assigned to account</p>
        </div>
        <div class="bg-white border border-[#E4DECB] rounded-xl p-3.5 shadow-sm">
            <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Amount Paid So Far</p>
            <p class="font-bold text-xl mt-1 text-emerald-600">{{ total_paid|floatformat:"0"|intcomma }} <span class="text-xs font-normal text-slate-400">UGX</span></p>
            <p class="text-[11px] text-slate-400 mt-0.5">Total cleared collections logged</p>
        </div>
        <div class="bg-white border border-[#E4DECB] rounded-xl p-3.5 shadow-sm">
            <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Current Outstanding Balance</p>
            <p class="font-bold text-xl mt-1 text-rose-600">{{ total_outstanding|floatformat:"0"|intcomma }} <span class="text-xs font-normal text-slate-400">UGX</span></p>
            <p class="text-[11px] text-slate-400 mt-0.5">Pending debt balance owed</p>
        </div>
    </div>

    <!-- =========================================================
         2. RELEASES LEDGER TABLE
         ========================================================= -->
    {% include "reports/components/report_filters.html" %}
    <div class="bg-white border border-[#E4DECB] rounded-xl shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-[#E4DECB] bg-slate-50/50">
            <h3 class="text-xs font-bold text-slate-600 uppercase tracking-wider">Assigned Pack Releases</h3>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse bg-white">
                <thead>
                    <tr class="bg-slate-50 border-b border-[#E4DECB] text-slate-600 font-semibold text-[11px] uppercase tracking-wider">
                        <th class="px-4 py-3">Date</th>
                        <th class="px-4 py-3">Product Variant</th>
                        <th class="px-4 py-3 text-center">Packs Out</th>
                        <th class="px-4 py-3 text-center">Outstanding</th>
                        <th class="px-4 py-3 text-right">Value (UGX)</th>
                        <th class="px-4 py-3 text-right">Paid (UGX)</th>
                        <th class="px-4 py-3 text-right">Balance Owed</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E4DECB] text-slate-700 text-xs">
                    {% for release in releases %}
                    <tr class="hover:bg-slate-50/50 transition duration-150">
                        <td class="px-4 py-3 whitespace-nowrap text-slate-500 font-medium">
                            {{ release.released_at|date:"d M Y, H:i" }}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap font-bold text-slate-900">
                            {{ release.product }}
                        </td>
                        <td class="px-4 py-3 text-center font-medium text-slate-500">
                            {{ release.packs_out }}
                        </td>
                        <td class="px-4 py-3 text-center font-bold text-slate-800 bg-slate-50/50">
                            {{ release.packs_outstanding }}
                        </td>
                        <td class="px-4 py-3 text-right font-medium text-slate-600">
                            {{ release.gross_amount|floatformat:0|intcomma }}
                        </td>
                        <td class="px-4 py-3 text-right text-emerald-600 font-bold">
                            {{ release.total_amount_paid|floatformat:0|intcomma }}
                        </td>
                        <td class="px-4 py-3 text-right text-rose-600 font-black bg-rose-50/10">
                            {{ release.outstanding_balance|floatformat:0|intcomma }}
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="7" class="px-4 py-12 text-center text-slate-400 italic">
                            No pack releases recorded for this account holder.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="bg-white border border-[#E4DECB] rounded-xl shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-[#E4DECB] bg-slate-50/50">
            <h3 class="text-xs font-bold text-slate-600 uppercase tracking-wider">Bulk Coffee Sales</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-[#E4DECB] text-slate-600 font-semibold text-[11px] uppercase tracking-wider">
                        <th class="px-4 py-3">Date</th>
                        <th class="px-4 py-3">Batch / Stage</th>
                        <th class="px-4 py-3 text-right">Kilograms</th>
                        <th class="px-4 py-3 text-right">Value (UGX)</th>
                        <th class="px-4 py-3 text-right">Paid (UGX)</th>
                        <th class="px-4 py-3 text-right">Balance Owed</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E4DECB] text-slate-700 text-xs">
                    {% for sale in bulk_sales %}
                        <tr>
                            <td class="px-4 py-3 whitespace-nowrap">{{ sale.sold_at|date:"d M Y, H:i" }}</td>
                            <td class="px-4 py-3 font-bold">{{ sale.stock.batch_number }} · {{ sale.get_stage_display }}</td>
                            <td class="px-4 py-3 text-right font-mono">{{ sale.kg_sold }} kg × {{ sale.price_per_kg|floatformat:2 }}</td>
                            <td class="px-4 py-3 text-right font-mono">{{ sale.total_amount_due|floatformat:0|intcomma }}</td>
                            <td class="px-4 py-3 text-right font-mono text-emerald-700">{{ sale.total_amount_paid|floatformat:0|intcomma }}</td>
                            <td class="px-4 py-3 text-right font-mono font-bold text-rose-700">{{ sale.outstanding_balance|floatformat:0|intcomma }}</td>
                        </tr>
                    {% empty %}
                        <tr><td colspan="6" class="px-4 py-10 text-center text-slate-400 italic">No bulk coffee sales recorded for this account holder.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- =========================================================
         3. ORDER-QUEUE STYLE PAYMENT MODAL OVERLAY
         ========================================================= -->
    <div id="paymentModal" class="fixed inset-0 bg-slate-950/80 z-[9999] hidden items-center justify-center p-3 overflow-y-auto">
        <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full overflow-hidden border border-slate-200 text-left flex flex-col animate-in fade-in zoom-in-95 duration-150">
            
            <!-- Dark Modal Top Bar -->
            <div class="bg-slate-950 text-white px-4 py-2.5 flex items-center justify-between border-b border-slate-800 shrink-0">
                <div>
                    <span class="text-[9px] font-mono tracking-wider text-emerald-400 font-bold uppercase block">
                        Account Settlement
                    </span>
                    <h3 class="text-xs font-bold text-white">Record Account Payment</h3>
                </div>
                <button type="button" onclick="closePaymentModal()" class="text-slate-400 hover:text-white text-base font-bold p-1 cursor-pointer">
                    &times;
                </button>
            </div>

            <!-- Modal Body Container -->
            <div class="p-4 space-y-3">
                <!-- Customer & Financial Summary -->
                <div class="bg-slate-50 border border-slate-200/80 rounded-lg p-2.5 grid grid-cols-2 gap-2 text-xs">
                    <div>
                        <span class="text-[9px] uppercase font-bold text-slate-400 tracking-wider block">Account Holder</span>
                        <p class="text-xs font-bold text-slate-800 truncate">{{ account.name }}</p>
                    </div>
                    <div class="text-right">
                        <span class="text-[9px] uppercase font-bold text-slate-400 tracking-wider block">Outstanding Balance</span>
                        <p class="text-sm font-black text-rose-600 font-mono">UGX {{ total_outstanding|floatformat:0|intcomma }}</p>
                    </div>
                </div>

                <!-- Compact Payment Form -->
                <form id="accountPaymentFormElement" method="post" class="space-y-2 border-t border-slate-100 pt-2.5">
                    {% csrf_token %}
                    <input type="hidden" name="action" value="record_account_payment">
                    
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[9px] uppercase font-bold text-slate-500 mb-0.5">
                                Amount Received (UGX)
                            </label>
                            <input type="number" 
                                   name="amount" 
                                   step="1" 
                                   max="{{ total_outstanding }}"
                                   value="{{ total_outstanding }}" 
                                   required
                                   class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 rounded-md px-2 py-1.5 text-xs font-mono font-bold text-slate-900">
                        </div>
                        <div>
                            <label class="block text-[9px] uppercase font-bold text-slate-500 mb-0.5">
                                Payment Method
                            </label>
                            <select name="method" required class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 rounded-md px-2 py-1.5 text-xs font-semibold text-slate-800">
                                {% for value, label in payment_methods %}
                                    <option value="{{ value }}" {% if forloop.first %}selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[9px] uppercase font-bold text-slate-500 mb-0.5">
                                Reference Hash / ID
                            </label>
                            <input type="text" 
                                   name="payment_reference" 
                                   placeholder="e.g. MM Txn ID"
                                   class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 rounded-md px-2 py-1 text-xs text-slate-800">
                        </div>
                        <div>
                            <label class="block text-[9px] uppercase font-bold text-slate-500 mb-0.5">
                                Audit Comments
                            </label>
                            <input type="text"
                                   name="notes" 
                                   placeholder="Optional comments..."
                                   class="w-full bg-slate-50 border border-slate-300 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 rounded-md px-2 py-1 text-xs text-slate-800">
                        </div>
                    </div>
                </form>
            </div>

            <!-- Modal Footer Actions -->
            <div class="bg-slate-50 px-4 py-2.5 border-t border-slate-200 flex items-center justify-between gap-3 shrink-0">
                <button type="button" onclick="closePaymentModal()" class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-md text-[11px] font-bold transition-all cursor-pointer">
                    Cancel
                </button>
                <button type="submit" form="accountPaymentFormElement" class="px-4 py-1.5 bg-orange-500 hover:bg-orange-600 text-white rounded-md text-[11px] font-bold transition-all shadow-xs cursor-pointer">
                    Post & Clear Payment
                </button>
            </div>

        </div>
    </div>

</div>
{% endblock %}

{% block extra_scripts %}
<script>
function openPaymentModal() {
    const modal = document.getElementById('paymentModal');
    if (!modal) return;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
}

function closePaymentModal() {
    const modal = document.getElementById('paymentModal');
    if (!modal) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
}

document.addEventListener('DOMContentLoaded', function() {
    const modalBox = document.querySelector('#paymentModal > div');
    if (modalBox) {
        modalBox.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    }
});
</script>
{% endblock %}
</file>

