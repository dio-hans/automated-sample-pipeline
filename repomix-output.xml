                  {% if out_of_stock_count %}text-rust{% else %}text-ink{% endif %}">
            {{ out_of_stock_count }}
        </p>

        <p class="mt-1 text-xs text-clay">
            Batches with no remaining kg
        </p>
    </div>

</div>


<!-- STOCK TABLE -->
<div class="bg-white border border-[#E4DECB] rounded-xl shadow-sm overflow-hidden">

