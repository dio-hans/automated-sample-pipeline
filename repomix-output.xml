                    {% endfor %}

                </tbody>

            </table>

        </div>

        {% if inventories %}

        <div class="grid grid-cols-1 gap-3 border-t border-line
                    p-3 md:grid-cols-[1fr_240px]">

            <div>

                <label
                    for="notes"
                    class="mb-1 block text-[11px]
                           font-semibold text-slate-600"
                >
                    Audit notes
                </label>

                <textarea
                    id="notes"
                    name="notes"
                    rows="2"
                    placeholder="Differences, damaged stock, shelf checks…"
                    class="w-full rounded-md border border-line
                           bg-white px-2.5 py-2 text-xs
                           outline-none focus:border-olive"
                ></textarea>

            </div>

            <div class="rounded-md border border-line
                        bg-slate-50 px-3 py-2.5">

                <p class="text-[10px] uppercase tracking-wide text-slate-400">
                    Proposed bill · UGX
                </p>

                <p id="auditTotal"
                   class="mt-0.5 text-base font-semibold text-slate-800">
                    0
                </p>

            </div>

        </div>

        <div class="flex items-center justify-between gap-3
                    border-t border-line bg-slate-50/50
                    px-3 py-2.5">

            <p class="max-w-2xl text-[10px]
                      leading-4 text-slate-400">
                If physical stock exceeds expected stock, record the authorized
                stock movement first. Mixed historical delivery prices must be
                reconciled before approval.
            </p>

            <div class="flex items-center gap-2">

                <a
                    href="{% url 'consignment_branch_detail' company.pk branch.pk %}"
                    class="inline-flex h-8 items-center rounded-md
                           border border-line bg-white px-3
                           text-xs font-medium text-slate-600"
                >
                    Cancel
                </a>

                <button
                    type="submit"
                    class="inline-flex h-8 items-center rounded-md
                           bg-olive px-3 text-xs font-semibold
                           text-white hover:bg-olive/90"
                >
                    Submit for approval
                </button>

            </div>

        </div>

        {% endif %}

    </form>

    {% endif %}

</div>

{% endblock %}


{% block extra_scripts %}
{{ block.super }}

<script>
(function () {

    const form = document.getElementById('auditForm');

    if (!form) {
        return;
    }

    const fmt = new Intl.NumberFormat(
        'en-UG',
        {
            maximumFractionDigits: 0
        }
    );

    function num(el) {

        const value = parseFloat(
            el && el.value
        );

        return Number.isFinite(value)
            ? value
            : 0;
    }

    function recalc() {

        let total = 0;

        form.querySelectorAll('.audit-row').forEach(row => {

            const expected =
                Number(row.dataset.expectedShelf || 0)
                +
                Number(row.dataset.expectedBackroom || 0);

            const actual =
                num(row.querySelector('.actual-shelf'))
                +
                num(row.querySelector('.actual-backroom'));

            const shrink =
                num(row.querySelector('.shrink-shelf'))
                +
                num(row.querySelector('.shrink-backroom'));

            const sold = Math.max(
                expected - actual - shrink,
                0
            );

            const value =
                sold
                *
                num(row.querySelector('.unit-price'));

            total += value;

            row.querySelector('.sold-count').textContent =
                sold;

            row.querySelector('.line-value').textContent =
                'UGX ' + fmt.format(value);

        });

        document.getElementById('auditTotal').textContent =
            fmt.format(total);
    }

    form.addEventListener(
        'input',
        recalc
    );

    recalc();

})();
</script>

{% endblock %}
</file>

