<file path="web/templates/pipeline/account_holder_form.html">
{% extends "pipeline/base.html" %}

{% block title %}{{ title }} | Nonda{% endblock %}
{% block breadcrumb %}Account Holders / {{ title }}{% endblock %}
{% block page_title %}{{ title }}{% endblock %}

{% block content %}
<div class="max-w-xl mx-auto">
    <form method="POST" class="bg-white border border-slate-200 rounded-xl shadow-sm p-3.5 space-y-2.5">
        {% csrf_token %}

        {% if form.non_field_errors %}
        <div class="p-2 bg-rose-50 border border-rose-200 text-rose-700 rounded-lg text-xs font-semibold">
            {{ form.non_field_errors }}
        </div>
        {% endif %}

        <!-- Account Holder Name -->
        <div>
            <label for="{{ form.name.id_for_label }}" class="block text-[10px] font-bold text-slate-600 uppercase tracking-wider mb-0.5">
                Account Holder Name *
            </label>
            {{ form.name }}
            {% if form.name.errors %}
                <div class="text-rose-600 text-[10px] font-semibold mt-0.5">
                    {{ form.name.errors.0 }}
                </div>
            {% endif %}
        </div>

        <!-- Type & System User -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div>
                <label for="{{ form.account_type.id_for_label }}" class="block text-[10px] font-bold text-slate-600 uppercase tracking-wider mb-0.5">
                    Account Type *
                </label>
                {{ form.account_type }}
                {% if form.account_type.errors %}
                    <div class="text-rose-600 text-[10px] font-semibold mt-0.5">
                        {{ form.account_type.errors.0 }}
                    </div>
                {% endif %}
            </div>
            <div>
                <label for="{{ form.system_user.id_for_label }}" class="block text-[10px] font-bold text-slate-600 uppercase tracking-wider mb-0.5">
                    Link System User <span class="text-slate-400 font-normal lowercase">(optional)</span>
