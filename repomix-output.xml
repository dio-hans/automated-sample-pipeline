{% extends "pipeline/base.html" %}
{% load static humanize %}

{% block title %} Coffee Stock | Nonda {% endblock %}

{% block content %}
<div class="space-y-3">

    <!-- TOP BAR: BREADCRUMB + PAGE TITLE + ACTION -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-1 border-b border-[#E4DECB]">
        <div>
            <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                Inventory / <span class="text-slate-600">Coffee Stock</span>
            </div>
            <h1 class="text-base font-bold text-slate-800 leading-tight">Coffee Stock Batches</h1>
        </div>
        <div>
            <a href="{% url 'stock_create' %}"
               class="inline-flex items-center gap-1 px-3 py-1.5 rounded bg-rust hover:bg-rust-dark text-white text-xs font-semibold shadow-xs transition">
                Receive Coffee Batch
            </a>
        </div>
    </div>

    <!-- 1. COMPACT KPI SUMMARY CARDS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <!-- Tile 1: Total Weight -->
        <a href="?preset={{ preset }}&status=all" class="bg-white border border-[#E4DECB] hover:border-slate-400 rounded-lg p-2.5 shadow-2xs transition block group">
            <p class="text-[10px] uppercase font-bold tracking-wider text-slate-400 group-hover:text-slate-600">Total Net Inventory</p>
            <div class="flex items-baseline gap-1 mt-0.5">
                <span class="font-bold text-xl text-slate-800">{{ total_available|floatformat:2|intcomma }}</span>
                <span class="text-[11px] font-normal text-slate-400">Kg</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-0.5">Combined total active mass</p>
        </a>

        <!-- Tile 2: Low Stock -->
        <a href="?preset={{ preset }}&status=low" 
           class="bg-white border rounded-lg p-2.5 shadow-2xs transition block group {% if status_filter == 'low' %}border-amber-500 ring-1 ring-amber-500/20 bg-amber-50/10{% else %}border-[#E4DECB] hover:border-amber-400{% endif %}">
            <p class="text-[10px] uppercase font-bold tracking-wider {% if status_filter == 'low' %}text-amber-600{% else %}text-slate-400 group-hover:text-amber-600{% endif %}">Low Stock Batches</p>
            <p class="font-bold text-xl mt-0.5 text-slate-800">{{ low_stock_count|default:"0" }}</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Batches below threshold</p>
        </a>

        <!-- Tile 3: Exhausted Batches -->
        <a href="?preset={{ preset }}&status=exhausted" 
           class="bg-white border rounded-lg p-2.5 shadow-2xs transition block group {% if status_filter == 'exhausted' %}border-rose-500 ring-1 ring-rose-500/20 bg-rose-50/10{% else %}border-[#E4DECB] hover:border-rose-400{% endif %}">
            <p class="text-[10px] uppercase font-bold tracking-wider {% if status_filter == 'exhausted' %}text-rose-600{% else %}text-slate-400 group-hover:text-rose-600{% endif %}">Exhausted Batches</p>
            <p class="font-bold text-xl mt-0.5 text-rose-600">{{ out_of_stock_count|default:"0" }}</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Batches fully checked out</p>
        </a>
    </div>

    <!-- 2. DATE & SCOPE FILTER BAR -->
   <!-- FILTER -->
    {% include "reports/components/report_filters.html" %}

    <!-- 3. COMPACT SPREADSHEET TABLE -->
    <div class="bg-white border border-[#E4DECB] rounded-lg shadow-2xs overflow-hidden">
        <div class="overflow-x-auto w-full">
            <table class="w-full text-xs text-left border-collapse bg-white min-w-[900px]">
                <thead>
                    <tr class="bg-slate-100/80 border-b border-[#E4DECB] text-slate-600 font-semibold uppercase tracking-wider text-[11px]">
                        <th class="px-3 py-2">Date Received</th>
                        <th class="px-3 py-2">Batch #</th>
                        <th class="px-3 py-2">Variety</th>
                        <th class="px-3 py-2 text-right">Green (Kg)</th>
                        <th class="px-3 py-2 text-right">Roasted (Kg)</th>
                        <th class="px-3 py-2 text-right">Ground (Kg)</th>
                        <th class="px-3 py-2 text-right">Quakers (Kg)</th>
                        <th class="px-3 py-2 text-right">Net Total (Kg)</th>
                        <th class="px-3 py-2 text-center">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E4DECB] text-slate-700">
                    {% for stock in stocks %}
                    <tr class="hover:bg-slate-50/80 transition">
                        <td class="px-3 py-2 text-slate-400 font-medium whitespace-nowrap">{{ stock.created_at|date:"d M Y, H:i" }}</td>
                        <td class="px-3 py-2 font-mono font-bold text-rust">
                            <a href="{% url 'stock_detail' stock.pk %}" class="hover:underline">{{ stock.batch_number }}</a>
                        </td>
                        <td class="px-3 py-2 font-semibold text-slate-800">{{ stock.variety.name }}</td>
                        
                        <td class="px-3 py-2 text-right font-medium text-slate-500">{{ stock.quantity_green|floatformat:1 }}</td>
                        <td class="px-3 py-2 text-right font-medium text-slate-500">{{ stock.quantity_roasted|floatformat:1 }}</td>
                        <td class="px-3 py-2 text-right font-medium text-slate-500">{{ stock.quantity_ground|floatformat:1 }}</td>
                        <td class="px-3 py-2 text-right font-medium text-slate-400 italic">{{ stock.quantity_quakers|floatformat:1 }}</td>
                        
                        <td class="px-3 py-2 text-right font-bold text-slate-900 bg-slate-50/50">{{ stock.quantity_available|floatformat:1 }} kg</td>
                        <td class="px-3 py-2 text-center whitespace-nowrap">
                            {% if stock.quantity_available <= 0 %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-100 uppercase tracking-wider">Exhausted</span>
                            {% elif stock.quantity_available <= stock.reorder_level %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-100 uppercase tracking-wider">Low Stock</span>
                            {% else %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100 uppercase tracking-wider">Active</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="9" class="px-3 py-8 text-center text-slate-400 italic bg-white">
                            No coffee batches match the selected criteria.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
