                        <label for="{{ form.received_date.id_for_label }}" class="block text-xs font-medium text-slate-700 mb-1">Date Received</label>
                        {{ form.received_date }}
                        {% for error in form.received_date.errors %}
                            <p class="text-xs text-rust mt-1">{{ error }}</p>
                        {% endfor %}
                    </div>

                    <!-- 
                    
                    <div>
                        <label for="{{ form.supplier.id_for_label }}" class="block text-xs font-medium text-slate-700 mb-1">Supplier Company</label>
                        {{ form.supplier }}
                        {% for error in form.supplier.errors %}
                            <p class="text-xs text-rust mt-1">{{ error }}</p>
                        {% endfor %}
                    </div>
                     -->

                    <!-- Source Region -->
                    <div>
                        <label for="{{ form.source.id_for_label }}" class="block text-xs font-medium text-slate-700 mb-1">Source / Origin</label>
                        {{ form.source }}
                        {% for error in form.source.errors %}
                            <p class="text-xs text-rust mt-1">{{ error }}</p>
                        {% endfor %}
