            <div>
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Green Stock</p>
                <p class="text-lg font-bold text-slate-800 leading-tight">
                    {{ stock.quantity_green|floatformat:2 }} <span class="text-xs font-normal text-slate-400">Kg</span>
                </p>
            </div>
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        </div>

        <!-- Roasted -->
        <div class="bg-white border border-[#E4DECB] rounded-lg p-3 shadow-sm flex justify-between items-center">
            <div>
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Roasted Stock</p>
                <p class="text-lg font-bold text-slate-800 leading-tight">
                    {{ stock.quantity_roasted|floatformat:2 }} <span class="text-xs font-normal text-slate-400">Kg</span>
                </p>
            </div>
            <span class="w-2 h-2 rounded-full bg-amber-600"></span>
        </div>

        <!-- Ground -->
        <div class="bg-white border border-[#E4DECB] rounded-lg p-3 shadow-sm flex justify-between items-center">
            <div>
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Ground Stock</p>
                <p class="text-lg font-bold text-slate-800 leading-tight">
                    {{ stock.quantity_ground|floatformat:2 }} <span class="text-xs font-normal text-slate-400">Kg</span>
                </p>
            </div>
            <span class="w-2 h-2 rounded-full bg-amber-800"></span>
        </div>
    </div>

    <!-- HIGH-DENSITY SPECIFICATIONS TABLE CARD -->
